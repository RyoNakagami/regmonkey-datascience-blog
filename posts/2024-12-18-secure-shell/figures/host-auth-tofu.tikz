#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.7cm, inner sep=5pt},
    ng/.style={block, draw=crimsonred, fill=mistyrose, text=crimsonred},
    rowlabel/.style={anchor=west, align=left, font=\small\bfseries, text=navy},
    head/.style={font=\small\bfseries, text=navy},
    cond/.style={anchor=west, align=left, font=\footnotesize, text=darkgray},
  ]
  % 列の x 座標
  \def\xa{5.4}
  \def\xb{8.5}
  \def\xc{11.6}
  \def\xd{13.6}

  % 見出し行
  \node[head] at (\xa,1.2) {1回目の接続};
  \node[head] at (\xb,1.2) {2回目};
  \node[head] at (\xc,1.2) {3回目以降};
  \node[head, anchor=west] at (\xd,1.2) {攻撃者に必要な条件};
  \draw[->, draw=darkgray] (3.8,1.75) -- (13.1,1.75)
    node[midway, above, font=\footnotesize, text=darkgray] {接続の回数};
  \draw[draw=lightgray] (0,0.7) -- (17.8,0.7);

  % 行1: ホスト認証なし
  \node[rowlabel] at (0,0) {ホスト認証なし\\{\footnotesize\mdseries 鍵交換による暗号化だけ}};
  \node[ng] at (\xa,0) {偽サーバーに\\気づけない};
  \node[ng] at (\xb,0) {偽サーバーに\\気づけない};
  \node[ng] at (\xc,0) {偽サーバーに\\気づけない};
  \node[cond] at (\xd,0) {どの接続でも\\割り込めばよい};

  % 行2: TOFU
  \node[rowlabel] at (0,-2.0) {TOFU\\{\footnotesize\mdseries known\_hosts に保存し，}\\{\footnotesize\mdseries 2回目以降に照合}};
  \node[ng] at (\xa,-2.0) {偽サーバーに\\気づけない};
  \node[block] at (\xb,-2.0) {known\_hosts\\と照合};
  \node[block] at (\xc,-2.0) {known\_hosts\\と照合};
  \node[cond] at (\xd,-2.0) {初回に割り込み，\\以後も毎回\\割り込み続ける};

  % 行3: 事前配布
  \node[rowlabel] at (0,-4.0) {事前に配布\\{\footnotesize\mdseries fingerprint 照合・SSHFP・}\\{\footnotesize\mdseries ホスト証明書}};
  \node[block] at (\xa,-4.0) {事前の情報\\と照合};
  \node[block] at (\xb,-4.0) {事前の情報\\と照合};
  \node[block] at (\xc,-4.0) {事前の情報\\と照合};
  \node[cond] at (\xd,-4.0) {サーバーの\\ホスト秘密鍵を盗む};

  % TOFU 行の補足
  \node[font=\footnotesize, text=azureblue] at ($(\xb,-2.0)!0.5!(\xc,-2.0)+(0,-0.85)$)
    {一度でも本物につながると鍵の不一致で警告が出る};
\end{tikzpicture}
