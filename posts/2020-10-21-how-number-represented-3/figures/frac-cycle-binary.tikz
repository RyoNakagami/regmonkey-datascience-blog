#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.0cm, minimum width=1.5cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    bit/.style={font=\footnotesize\bfseries, text=azureblue, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  \node[block] (n1) {$0.1$};
  \node[accent, right=2.4cm of n1] (n2) {$0.2$};
  \node[block, right=2.4cm of n2] (n3) {$0.4$};
  \node[block, right=2.4cm of n3] (n4) {$0.8$};
  \node[block, right=2.4cm of n4] (n5) {$0.6$};

  \node[sig, above=2mm of n1] {開始};

  \draw[wire] (n1) -- node[midway, above, sig] {$\times 2 = 0.2$} node[midway, below, bit] {桁 0} (n2);
  \draw[wire] (n2) -- node[midway, above, sig] {$\times 2 = 0.4$} node[midway, below, bit] {桁 0} (n3);
  \draw[wire] (n3) -- node[midway, above, sig] {$\times 2 = 0.8$} node[midway, below, bit] {桁 0} (n4);
  \draw[wire] (n4) -- node[midway, above, sig] {$\times 2 = 1.6$} node[midway, below, bit] {桁 1} (n5);

  % 0.6 -> 0.2 に戻る
  \coordinate (lb) at ($(n5.south)+(0,-1.0)$);
  \draw[wire] (n5.south) -- (lb) -- node[midway, above, sig] {$\times 2 = 1.2$（小数部 $0.2$ に戻る）}
                                   node[midway, below, bit] {桁 1} (lb -| n2.south) -- (n2.south);

  \coordinate (ztop) at ($(n2.north)+(0,0.45)$);
  \coordinate (zbot) at ($(lb)+(0,-0.55)$);
  \begin{scope}[on background layer]
    \node[zone, fit=(n2)(n5)(n2 |- ztop)(n2 |- zbot)] (zc) {};
  \end{scope}
  \node[zlabel] at (zc.north) {循環部：$0.2 \to 0.4 \to 0.8 \to 0.6 \to 0.2$（周期 4）};

  \node[anchor=north, font=\normalsize] at ($(zc.south)+(-1.4,-0.35)$)
    {取り出した桁を並べると \quad $0.1_{(10)} = 0.0\,0011\,0011\,0011\cdots_{(2)}$};
\end{tikzpicture}
