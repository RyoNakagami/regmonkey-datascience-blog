#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    layer/.style={draw=navy, fill=aliceblue, minimum width=4.3cm, minimum height=0.62cm,
                  inner sep=0pt, font=\footnotesize},
    cell/.style={draw=navy, rounded corners=3pt, minimum width=3.5cm, minimum height=1.05cm,
                 align=center, inner sep=0pt, font=\footnotesize},
    good/.style={block, align=left, text width=2.85cm, minimum height=2.1cm, anchor=north west},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    head/.style={font=\large\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    light/.style={->, draw=azureblue},
  ]
  \node[head, anchor=west] at (-0.3,6.9) {有機ELディスプレイのしくみ：RGB の素子が「自分で光る」};

  % ======== ① 1つの素子の中身 ========
  \node[step] at (2.0,5.3) {① 有機EL素子の中身};
  \node[layer] (cat) at (2.0,4.55) {陰極（−）};
  \node[layer, below=0pt of cat] (etl) {電子輸送層（有機物）};
  \node[layer, below=0pt of etl, fill=paleskyblue, minimum height=0.8cm] (eml) {発光層（有機物）};
  \node[layer, below=0pt of eml] (htl) {正孔輸送層（有機物）};
  \node[layer, below=0pt of htl] (ano) {陽極（＋・透明電極）};
  \node[layer, below=0pt of ano, fill=white] (sub) {透明基板};
  \draw[->, draw=navy, line width=1.0pt] ([xshift=1.9cm, yshift=0.08cm]cat.center) -- ([xshift=1.9cm, yshift=0.12cm]eml.center);
  \node[sig, text=navy, anchor=east] at ([xshift=1.84cm, yshift=0.08cm]cat.center) {$e^{-}$};
  \draw[->, draw=azureblue, line width=1.0pt] ([xshift=1.9cm, yshift=-0.06cm]ano.center) -- ([xshift=1.9cm, yshift=-0.14cm]eml.center);
  \node[sig, text=azureblue, anchor=east] at ([xshift=1.84cm, yshift=-0.14cm]ano.center) {$h^{+}$};
  \foreach \dx in {-1.0, 0, 1.0} {
    \draw[light, line width=1.0pt] ([xshift=\dx cm]sub.south) -- ++(0,-0.45);
  }
  \node[note, anchor=north, align=center] at ([yshift=-0.5cm]sub.south)
    {電子と正孔が発光層で合わさり\\熱を出さずに光る（LED と同じ原理）};

  % ======== 駆動 ========
  \node[block, fill=white, font=\footnotesize, minimum height=0.7cm] (drv) at (7.0,6.05)
    {駆動回路：素子ごとに電流を調節};
  \draw[->, draw=navy] (drv.south) -- (7.0,4.42);
  \node[step, anchor=east] at (6.85,5.3) {② RGB の素子が発光};

  % ======== ② RGB サブ画素 ========
  \node[cell, fill=paleskyblue] (r) at (7.0,3.9) {赤く光る有機物\\電流：大 → 明るく発光};
  \node[cell, fill=aliceblue]   (g) at (7.0,2.5) {緑に光る有機物\\電流：中 → 半分の明るさ};
  \node[cell, fill=white]       (b) at (7.0,1.1) {青く光る有機物\\電流：0 → OFF};
  \node[note, anchor=north, align=center] at (7.0,0.5)
    {発光層の有機物の種類や\\混ぜる物質で発光色が決まる};

  % ======== ③ 目に届く光 ========
  \node[step] at (10.3,5.3) {③ 目に届く光};
  \draw[light, line width=1.6pt] (r.east) -- ++(0.8,0) node[right, font=\footnotesize] {赤：明るい};
  \draw[light, line width=0.9pt] (g.east) -- ++(0.8,0) node[right, font=\footnotesize] {緑：半分の明るさ};
  \node[font=\footnotesize, anchor=west, align=left, text=navy] at ([xshift=0.9cm]b.east)
    {青：まったく光らない\\→ 光漏れゼロ};

  % 合成
  \draw[draw=navy, decorate, decoration={brace, amplitude=7pt}] (13.0,4.55) -- (13.0,0.45);
  \node[accent, minimum width=3.4cm] (px) at (15.2,2.5)
    {1画素の色\\[2pt]{\footnotesize RGB を直接コントロール}\\{\footnotesize してフルカラー}};
  \draw[->, draw=navy] (13.3,2.5) -- (px.west);
  \node[note, anchor=north] at ([yshift=-0.2cm]px.south)
    {バックライトも\\色フィルタも不要};

  % ======== 強み ========
  \draw[draw=lightgray] (-0.3,-0.75) -- (17.1,-0.75);
  \node[step, anchor=west] at (-0.3,-1.15) {有機ELの強み（自分で光るため）};
  \node[good] (s1) at (-0.3,-1.55)
    {{\color{navy}黒がしっかり出る}\\[2pt]{\footnotesize 素子OFFで真っ暗．}\\{\footnotesize コントラストが良い}};
  \node[good] (s2) at ([xshift=0.25cm]s1.north east)
    {{\color{navy}自然な色合い}\\[2pt]{\footnotesize バックライトの色・}\\{\footnotesize 明るさに左右されない}};
  \node[good] (s3) at ([xshift=0.25cm]s2.north east)
    {{\color{navy}省電力・シンプル}\\[2pt]{\footnotesize バックライトが不要}\\{\footnotesize で部品が少ない}};
  \node[good] (s4) at ([xshift=0.25cm]s3.north east)
    {{\color{navy}薄い・曲げられる}\\[2pt]{\footnotesize 厚さ1万分の数mm．}\\{\footnotesize プラスチック基板で}\\{\footnotesize 折りたたみも可能}};
  \node[good] (s5) at ([xshift=0.25cm]s4.north east)
    {{\color{navy}シースルーにできる}\\[2pt]{\footnotesize 透明電極（酸化イン}\\{\footnotesize ジウムスズ・酸化亜鉛}\\{\footnotesize ・炭素の単分子膜等）}};

  \node[note, anchor=north west] at ([yshift=-0.25cm]s1.south west)
    {応用：テレビ・スマートフォン・カメラ・デジタルサイネージ（駅や店の電子広告）・折りたためる携帯ディスプレイ};
  \node[font=\scriptsize, text=darkgray, anchor=north east] at (17.1,-4.65)
    {出典：キヤノン サイエンスラボ・キッズ「有機ELのしくみと特徴」};
\end{tikzpicture}
