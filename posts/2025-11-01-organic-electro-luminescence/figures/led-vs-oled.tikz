#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    semi/.style={draw=navy, minimum width=3.0cm, minimum height=2.2cm, inner sep=0pt},
    layer/.style={draw=navy, fill=aliceblue, minimum width=4.6cm, minimum height=0.62cm,
                  inner sep=0pt, font=\footnotesize},
    pwr/.style={draw=navy, fill=white, rounded corners=3pt, minimum width=1.5cm,
                minimum height=0.7cm, font=\footnotesize},
    sig/.style={font=\footnotesize, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    head/.style={font=\large\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    light/.style={->, draw=azureblue, line width=1.4pt},
    wire/.style={draw=navy, line width=0.8pt},
  ]
  \node[head, anchor=west] at (-0.3,6.9) {LED と有機EL：どちらも「電子と正孔が合わさって光る」};

  % ================= ① LED =================
  \node[step] at (3.5,5.9) {① LED（発光ダイオード）：2種類の半導体};

  \node[semi, fill=aliceblue] (p) at (2.0,3.0) {};
  \node[semi, fill=paleskyblue] (n) at (5.0,3.0) {};
  \node[font=\footnotesize\bfseries, text=navy] at (2.0,3.75) {p型半導体};
  \node[font=\footnotesize, text=darkgray] at (2.0,3.35) {正孔（＋）が多い};
  \node[font=\footnotesize\bfseries, text=navy] at (5.0,3.75) {n型半導体};
  \node[font=\footnotesize, text=darkgray] at (5.0,3.35) {電子（−）が多い};

  % キャリアの移動
  \foreach \x in {1.0,1.7} { \node[sig, text=azureblue] at (\x,2.75) {$h^{+}$}; }
  \draw[->, draw=azureblue, line width=1.0pt] (2.25,2.75) -- (3.3,2.75);
  \foreach \x in {6.0,5.3} { \node[sig, text=navy] at (\x,2.3) {$e^{-}$}; }
  \draw[->, draw=navy, line width=1.0pt] (4.75,2.3) -- (3.7,2.3);

  % 接合面と発光
  \draw[draw=navy, densely dashed, line width=1.0pt] (3.5,1.9) -- (3.5,4.1);
  \node[font=\footnotesize, text=navy, fill=white, inner sep=1pt] at (3.5,1.65) {さかい目（pn接合）};
  \draw[light] (3.5,4.2) -- (2.9,5.1);
  \draw[light] (3.5,4.2) -- (3.5,5.25);
  \draw[light] (3.5,4.2) -- (4.1,5.1);
  \node[font=\footnotesize, text=azureblue, anchor=west] at (4.3,4.85) {光};

  % 電源
  \node[pwr] (bat1) at (3.5,0.7) {電源};
  \draw[wire] (p.south west) ++(0.4,0) -- (0.9,0.7) -- (bat1.west);
  \draw[wire] (n.south east) ++(-0.4,0) -- (6.1,0.7) -- (bat1.east);
  \node[sig, text=navy] at (2.5,0.95) {＋};
  \node[sig, text=navy] at (4.5,0.95) {−};

  \node[note] at (3.5,-0.1) {無機物の半導体の結晶．小さな「点」で光る};

  % ================= ② 有機EL =================
  \draw[draw=lightgray] (7.9,0.0) -- (7.9,6.1);
  \node[step] at (12.3,5.9) {② 有機EL：有機物の薄い膜を積み重ねる};

  \node[layer] (cat) at (12.0,4.95) {陰極（−）};
  \node[layer, below=0pt of cat] (etl) {電子輸送層（有機物）};
  \node[layer, below=0pt of etl, fill=paleskyblue, minimum height=0.8cm] (eml) {発光層（有機物）};
  \node[layer, below=0pt of eml] (htl) {正孔輸送層（有機物）};
  \node[layer, below=0pt of htl] (ano) {陽極（＋・透明電極）};
  \node[layer, below=0pt of ano, fill=white] (sub) {透明基板（ガラス・プラスチック）};

  % キャリアの移動
  \draw[->, draw=navy, line width=1.0pt] ([xshift=-2.0cm]cat.center) -- ([xshift=-2.0cm, yshift=0.1cm]eml.center);
  \node[sig, text=navy, anchor=east] at ([xshift=-2.05cm]etl.center) {$e^{-}$};
  \draw[->, draw=azureblue, line width=1.0pt] ([xshift=-2.0cm]ano.center) -- ([xshift=-2.0cm, yshift=-0.1cm]eml.center);
  \node[sig, text=azureblue, anchor=east] at ([xshift=-2.05cm]htl.center) {$h^{+}$};

  % 発光（基板側へ）
  \foreach \dx in {-1.2, 0, 1.2} {
    \draw[light] ([xshift=\dx cm]sub.south) -- ++(0,-0.6);
  }
  \node[font=\footnotesize, text=azureblue, anchor=west] at ([xshift=1.35cm, yshift=-0.35cm]sub.south) {光};

  % 電源
  \node[pwr] (bat2) at (15.6,3.1) {電源};
  \draw[wire] (cat.east) -| (bat2.north);
  \draw[wire] (ano.east) -| (bat2.south);
  \node[sig, text=navy] at (15.85,4.3) {−};
  \node[sig, text=navy] at (15.85,1.95) {＋};

  \node[note] at (12.0,-0.1) {有機物の薄い膜．「面」全体で光る};

  % ================= 共通点 =================
  \draw[draw=lightgray] (-0.3,-0.6) -- (17.1,-0.6);
  \node[accent, anchor=north west, text width=16.6cm, align=left, minimum height=1.3cm] at (-0.3,-0.9)
    {{\bfseries\color{navy} 共通点}\\[3pt]
     {\footnotesize ・電流を流すと，マイナスの電子とプラスの正孔が出会って合わさり，そのエネルギーが光になる（エレクトロ・ルミネッセンス）}\\
     {\footnotesize ・性質のちがう物質を重ねた構造で，熱をほとんど出さずに光る}};

  \node[font=\scriptsize, text=darkgray, anchor=north east] at (17.1,-2.45)
    {出典：キヤノン サイエンスラボ・キッズ「有機ELのしくみと特徴」をもとに作成};
\end{tikzpicture}
