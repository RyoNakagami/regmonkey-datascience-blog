#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\definecolor{orange}{HTML}{FF9A2E}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, align=left, text width=4.6cm, minimum height=1.5cm},
    cell/.style={draw=navy, fill=aliceblue, minimum width=2.8cm, minimum height=1.05cm, inner sep=0pt},
    filt/.style={draw=navy, fill=white, minimum width=1.7cm, minimum height=1.05cm, align=center, inner sep=0pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    head/.style={font=\large\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    light/.style={->, draw=azureblue},
    mol/.style={draw=navy, line width=1.6pt},
  ]
  \node[head, anchor=west] at (-0.3,6.9) {液晶ディスプレイのしくみ：白い光を「液晶で絞り」「フィルタで色づけ」する};

  % ---------- ステップ見出し ----------
  \node[step] at (0.8,5.3)  {① 光源};
  \node[step, anchor=east] at (4.45,5.3) {② 光の量を調節};
  \node[step] at (7.9,5.3)  {③ 色づけ};
  \node[step] at (10.5,5.3) {④ 目に届く光};

  % ---------- ① バックライト ----------
  \node[block, minimum width=1.5cm, minimum height=4.2cm] (bl) at (0.8,2.5)
    {バック\\ライト\\[3pt]（白色光）\\[3pt]液晶の\\後ろに\\置く};

  % ---------- 駆動 ----------
  \node[block, fill=white, font=\footnotesize, minimum height=0.7cm] (drv) at (4.6,6.05) {駆動回路：電圧で液晶分子の向きを変える};
  \draw[->, draw=navy] (drv.south) -- (4.6,4.62);

  % ---------- ② 液晶セル（R/G/B の各サブ画素） ----------
  \foreach \y/\n in {3.9/c1, 2.5/c2, 1.1/c3} {
    \node[cell] (\n) at (4.6,\y) {};
    \draw[light, line width=1.6pt] (bl.east |- 0,\y) -- (\n.west);
  }
  % 分子の向き（通す＝光と平行，半分＝斜め，遮る＝垂直）
  \foreach \dx in {-1.0,-0.65,-0.3} {
    \draw[mol] ($(c1.center)+(\dx-0.15,0)$) -- ++(0.3,0);
    \draw[mol] ($(c2.center)+(\dx-0.11,-0.11)$) -- ++(0.22,0.22);
    \draw[mol] ($(c3.center)+(\dx,-0.15)$) -- ++(0,0.3);
  }
  \node[font=\footnotesize, anchor=west, align=left] at ($(c1.center)+(0.0,0)$) {光を通す};
  \node[font=\footnotesize, anchor=west, align=left] at ($(c2.center)+(0.0,0)$) {半分通す};
  \node[font=\footnotesize, anchor=west, align=left] at ($(c3.center)+(0.0,0)$) {光を遮る};
  \node[sig] at (4.6,0.25) {太線＝液晶分子の向き．向きで通す光の量が変わる};

  % ---------- ③ カラーフィルタ ----------
  \node[filt] (f1) at (7.9,3.9) {R（赤）\\フィルタ};
  \node[filt] (f2) at (7.9,2.5) {G（緑）\\フィルタ};
  \node[filt] (f3) at (7.9,1.1) {B（青）\\フィルタ};
  \draw[light, line width=1.6pt] (c1.east) -- (f1.west);
  \draw[light, line width=0.9pt] (c2.east) -- (f2.west);
  \draw[->, draw=crimsonred, densely dashed, line width=0.5pt] (c3.east) -- (f3.west);

  % ---------- ④ 出力 ----------
  \draw[light, line width=1.6pt] (f1.east) -- ++(0.7,0) node[right, font=\footnotesize, align=left] {赤：明るい};
  \draw[light, line width=0.9pt] (f2.east) -- ++(0.7,0) node[right, font=\footnotesize, align=left] {緑：半分の明るさ};
  \draw[->, draw=crimsonred, densely dashed, line width=0.5pt] (f3.east) -- ++(0.7,0)
     node[right, font=\footnotesize, align=left, text=crimsonred] {青：0にしたいが\\少し漏れる};

  % ---------- 合成 ----------
  \draw[draw=navy, decorate, decoration={brace, amplitude=7pt}] (12.55,4.55) -- (12.55,0.45);
  \node[accent, minimum width=3.6cm] (px) at (14.9,2.5)
    {1画素の色\\[2pt]{\footnotesize RGB 3色の明るさの}\\{\footnotesize 組み合わせでフルカラー}};
  \draw[->, draw=navy] (12.85,2.5) -- (px.west);
  \node[draw=navy, fill=orange, rounded corners=3pt, minimum width=3.6cm, minimum height=0.95cm,
        align=center, inner sep=3pt] (res) at (15.05,4.8)
    {{\bfseries この例で見える色：オレンジ}\\{\footnotesize 赤＋緑（半分）＋青（0）}};
  \draw[->, draw=navy] (px.north) -- (res.south);
  \node[note, anchor=north] at ([yshift=-0.2cm]px.south)
    {見ている色＝\\バックライトの光に\\RGBフィルタを重ねた色};

  % ---------- 弱点 ----------
  \draw[draw=lightgray] (-0.3,-0.35) -- (17.1,-0.35);
  \node[step, anchor=west] at (-0.3,-0.75) {液晶の弱点（バックライトがあるため）};
  \node[ng, anchor=north west] (w1) at (-0.3,-1.15)
    {{\color{crimsonred}黒が浮く}\\[2pt]{\footnotesize 素子を全部暗くしても光が少し}\\{\footnotesize 漏れ，真っ暗にできない}};
  \node[ng, anchor=north west] (w2) at ([xshift=0.6cm]w1.north east)
    {{\color{crimsonred}発色がバックライト次第}\\[2pt]{\footnotesize 自然な色には高価で高性能な}\\{\footnotesize バックライトが必要}};
  \node[ng, anchor=north west] (w3) at ([xshift=0.6cm]w2.north east)
    {{\color{crimsonred}厚く，部品が多い}\\[2pt]{\footnotesize バックライト＋液晶＋色フィルタの}\\{\footnotesize 重ね構造が必要}};

  \node[font=\scriptsize, text=darkgray, anchor=north east] at (17.1,-2.9)
    {出典：キヤノン サイエンスラボ・キッズ「有機ELのしくみと特徴」};
\end{tikzpicture}
