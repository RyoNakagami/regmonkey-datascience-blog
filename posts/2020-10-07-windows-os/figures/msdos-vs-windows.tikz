#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    hw/.style={block, fill=white, minimum width=2.4cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % ================= 左：MS-DOS 時代 =================
  \foreach \i/\n/\m in {0/PC-9801/NEC, 1/FMR/富士通, 2/Dynabook/東芝} {
    \node[hw] (dh\i) at (\i*2.75, 0) {\n\\{\footnotesize\textcolor{darkgray}{\m}}};
    \node[ng, minimum width=2.4cm] (da\i) at (\i*2.75, 3.6) {\n 用\\アプリ};
    \draw[wire] (da\i) -- node[midway, right, sig] {直接操作} (dh\i);
  }
  \node[note] at (2.75, -1.5) {いずれも x86 系 CPU だが，\\メモリ・I/O アドレスの構成が機種ごとに異なる};

  % ================= 右：Windows 登場後 =================
  \def\ox{10.3}
  \foreach \i/\n/\m in {0/PC-9801/NEC, 1/FMR/富士通, 2/Dynabook/東芝} {
    \node[hw] (wh\i) at (\ox+\i*2.75, 0) {\n\\{\footnotesize\textcolor{darkgray}{\m}}};
  }
  \node[block, minimum width=7.9cm] (wa) at (\ox+2.75, 3.6) {Windows アプリ（機種を問わず共通）};
  \node[accent, minimum width=7.9cm, minimum height=0.9cm] (win) at (\ox+2.75, 1.85)
    {Windows（ハードウェアの違いを吸収）};
  \draw[wire] (wa) -- node[midway, right, sig, align=left] {API で命令\\キー入力・画面出力など} (win);
  \foreach \i in {0,1,2} {
    \draw[wire] (win.south -| wh\i) -- (wh\i);
  }
  \node[note] at (\ox+2.75, -1.5) {プログラマはメモリや I/O アドレスの\\構成の違いを意識しなくてよい};

  % ================= ゾーン =================
  \begin{scope}[on background layer]
    \node[zone, fit=(da0)(da2)(dh0)(dh2)] (zl) {};
    \node[zone, fit=(wa)(wh0)(wh2)] (zr) {};
  \end{scope}
  \node[zlabel] at (zl.north) {MS-DOS 時代：機種ごとに専用アプリが必要};
  \node[zlabel] at (zr.north) {Windows 登場後：アプリは Windows に命令するだけ};
\end{tikzpicture}
