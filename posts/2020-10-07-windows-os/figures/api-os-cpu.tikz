#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.05cm, minimum width=3.8cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    hw/.style={block, fill=white},
    layer/.style={font=\footnotesize\bfseries, text=navy, anchor=east, align=right},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    diff/.style={font=\footnotesize, text=azureblue, align=center},
    wire/.style={->, draw=navy},
  ]
  % 列 x 座標
  \def\xa{0}
  \def\xb{7.0}
  \def\xc{14.0}

  % 層の y 座標
  \def\yapp{4.2}
  \def\yapi{2.85}
  \def\yos{1.5}
  \def\yhw{0}

  % ---- 層ラベル（左端） ----
  \node[layer] at (-2.2,\yapp) {アプリケーション};
  \node[layer] at (-2.2,\yapi) {API};
  \node[layer] at (-2.2,\yos)  {OS};
  \node[layer] at (-2.2,\yhw)  {ハードウェア};

  % ---- 列 A: Windows × x86 ----
  \node[step] at (\xa,5.35) {A．Windows × AT 互換機};
  \node[block]  (a1) at (\xa,\yapp) {アプリ\\{\footnotesize x86 のネイティブコード}};
  \node[accent] (a2) at (\xa,\yapi) {Windows の API};
  \node[block]  (a3) at (\xa,\yos)  {Windows};
  \node[hw]     (a4) at (\xa,\yhw)  {AT 互換機\\{\footnotesize x86 CPU}};

  % ---- 列 B: Linux × x86 ----
  \node[step] at (\xb,5.35) {B．Linux × AT 互換機};
  \node[block]  (b1) at (\xb,\yapp) {アプリ\\{\footnotesize x86 のネイティブコード}};
  \node[accent] (b2) at (\xb,\yapi) {Linux の API};
  \node[block]  (b3) at (\xb,\yos)  {Linux};
  \node[hw]     (b4) at (\xb,\yhw)  {AT 互換機\\{\footnotesize x86 CPU}};

  % ---- 列 C: Linux × ARM ----
  \node[step] at (\xc,5.35) {C．Linux × ARM 機};
  \node[block]  (c1) at (\xc,\yapp) {アプリ\\{\footnotesize ARM のネイティブコード}};
  \node[accent] (c2) at (\xc,\yapi) {Linux の API};
  \node[block]  (c3) at (\xc,\yos)  {Linux};
  \node[hw]     (c4) at (\xc,\yhw)  {ARM 機\\{\footnotesize ARM CPU}};

  % ---- 列間の比較 ----
  % A ↔ B：ハードは同じ，OS が違う
  \node[diff] at ($(a2)!0.5!(b2)$) {API が違う\\↓\\API を使う部分を\\書き換える};
  \node[diff] at ($(a3)!0.5!(b3)$) {OS が違う};
  \node[note] at ($(a4)!0.5!(b4)$) {同じ機種};
  % B ↔ C：OS は同じ，CPU が違う
  \node[note] at ($(b2)!0.5!(c2)$) {API は\\基本的に同じ};
  \node[diff] at ($(b1)!0.5!(c1)$) {ネイティブコード\\は別物};
  \node[note] at ($(b3)!0.5!(c3)$) {同じ OS};
  \node[diff] at ($(b4)!0.5!(c4)$) {CPU（マシン語）\\が違う};

\end{tikzpicture}
