#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.05cm, minimum width=4.0cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    hw/.style={block, fill=white},
    layer/.style={font=\footnotesize\bfseries, text=navy, anchor=east, align=right},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    diff/.style={font=\footnotesize, text=azureblue, align=center},
  ]
  \def\xa{0}
  \def\xb{8.3}
  \def\yapp{4.2}
  \def\yapi{2.85}
  \def\yos{1.5}
  \def\yhw{0}

  % ---- 層ラベル ----
  \node[layer] at (-2.4,\yapp) {アプリケーション};
  \node[layer] at (-2.4,\yapi) {API};
  \node[layer] at (-2.4,\yos)  {OS};
  \node[layer] at (-2.4,\yhw)  {ハードウェア};

  % ---- 列 1: Windows × x86 ----
  \node[step] at (\xa,5.35) {Windows × x86 系 CPU のパソコン};
  \node[block]  (a1) at (\xa,\yapp) {アプリ\\{\footnotesize x86 のネイティブコード}};
  \node[accent] (a2) at (\xa,\yapi) {Windows の API};
  \node[block]  (a3) at (\xa,\yos)  {Windows};
  \node[hw]     (a4) at (\xa,\yhw)  {パソコン\\{\footnotesize x86 系 CPU}};

  % ---- 列 2: Windows × ARM ----
  \node[step] at (\xb,5.35) {Windows × ARM 系 CPU のパソコン};
  \node[block]  (b1) at (\xb,\yapp) {アプリ\\{\footnotesize ARM のネイティブコード}};
  \node[accent] (b2) at (\xb,\yapi) {Windows の API};
  \node[block]  (b3) at (\xb,\yos)  {Windows};
  \node[hw]     (b4) at (\xb,\yhw)  {パソコン\\{\footnotesize ARM 系 CPU}};

  % ---- 列間の比較 ----
  \node[diff] at ($(a1)!0.5!(b1)$) {ネイティブコードは別物\\（CPU ごとにコンパイル）};
  \node[note] at ($(a2)!0.5!(b2)$) {同じ API};
  \node[note] at ($(a3)!0.5!(b3)$) {同じ OS};
  \node[diff] at ($(a4)!0.5!(b4)$) {CPU（マシン語）が違う};
\end{tikzpicture}
