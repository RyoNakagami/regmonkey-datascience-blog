#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    card/.style={block, fill=white},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  % --- ソースコード ---
  \node[card, minimum width=3.4cm, minimum height=1.6cm] (src)
    {ソースコード\\[2pt]{\footnotesize\texttt{hello.c}}};
  \node[note, below=2mm of src] {テキストファイル．\\どの環境でも表示・編集できる};

  % --- コンパイラ ---
  \node[block, minimum width=3.2cm, above right=1.5cm and 2.0cm of src.east, anchor=west] (cx86)
    {コンパイラ\\{\footnotesize（x86 向け）}};
  \node[block, minimum width=3.2cm, below right=1.5cm and 2.0cm of src.east, anchor=west] (carm)
    {コンパイラ\\{\footnotesize（ARM 向け）}};

  % --- ネイティブコード ---
  \node[accent, minimum width=3.6cm, right=1.6cm of cx86] (nx86)
    {ネイティブコード\\{\footnotesize x86 のマシン語（EXE など）}};
  \node[accent, minimum width=3.6cm, right=1.6cm of carm] (narm)
    {ネイティブコード\\{\footnotesize ARM のマシン語}};

  % --- CPU ---
  \node[block, minimum width=2.6cm, right=2.6cm of nx86] (px86) {x86 CPU};
  \node[block, minimum width=2.6cm, right=2.6cm of narm] (parm) {ARM CPU};

  % --- 列見出し ---
  \node[step] at (src |- 0,2.65) {作成段階};
  \node[step] at (cx86 |- 0,2.65) {コンパイル};
  \node[step] at (nx86 |- 0,2.65) {配布される形};
  \node[step] at (px86 |- 0,2.65) {実行};

  % --- 配線 ---
  \draw[wire] (src.east) -- ++(0.9,0) |- (cx86.west);
  \draw[wire] (src.east) -- ++(0.9,0) |- (carm.west);
  \node[circle, fill=navy, inner sep=1.4pt] at ($(src.east)+(0.9,0)$) {};
  \draw[wire] (cx86) -- (nx86);
  \draw[wire] (carm) -- (narm);
  \draw[wire] (nx86) -- node[midway, above, sig] {解釈・実行 ○} (px86);
  \draw[wire] (narm) -- node[midway, below, sig] {解釈・実行 ○} (parm);

  % --- NG: 別の CPU では動かない ---
  \draw[->, draw=crimsonred, dashed] ($(nx86.east)+(0,-0.3)$) -- ($(parm.west)+(0,0.3)$)
    node[pos=0.5, sloped, below=3pt, font=\footnotesize, text=crimsonred] {解釈できない ×};
\end{tikzpicture}
