#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    keynote/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
  ]
  % ---- 上段: $(cat f.txt) ----
  \node[accent, minimum width=3.6cm] (c1) at (0,3.8) {\texttt{v=\$(cat f.txt)}};
  \node[block, minimum width=2.6cm] (s1) at (4.9,3.8) {サブシェル};
  \node[block, minimum width=2.6cm] (k1) at (9.0,3.8) {\texttt{cat f.txt} \\ 外部コマンド};
  \node[block, minimum width=2.4cm] (r1) at (13.4,3.8) {\texttt{v=hello}};
  \node[note, below=2mm of c1] (n1a) {親シェル};
  \node[note, below=2mm of s1] (n1b) {子プロセスを生成};
  \node[note, below=2mm of k1] (n1c) {子プロセスが \\ \texttt{cat} に置き換わる};
  \node[keynote, below=2mm of r1] (n1d) {毎回 fork ＋ exec};
  \draw[wire] (c1) -- (s1) node[midway, above, sig] {fork};
  \draw[wire] (s1) -- (k1) node[midway, above, sig] {exec};
  \draw[wire] (k1) -- (r1) node[midway, above, sig] {標準出力};

  % ---- 下段: $(<f.txt) ----
  \node[accent, minimum width=3.6cm] (c2) at (0,0) {\texttt{v=\$(<f.txt)}};
  \node[block, minimum width=6.7cm] (b2) at (6.95,0) {bash 自身が \texttt{f.txt} を読む};
  \node[block, minimum width=2.4cm] (r2) at (13.4,0) {\texttt{v=hello}};
  \node[note, below=2mm of c2] (n2a) {親シェル};
  \node[note, below=2mm of b2] (n2b) {子プロセスも \texttt{cat} も起動しない（bash 5.2 以降）};
  \node[keynote, below=2mm of r2] (n2d) {プロセス生成なし};
  \draw[wire] (c2) -- (b2) node[midway, above, sig] {fork なし};
  \draw[wire] (b2) -- (r2) node[midway, above, sig] {読んだ内容};

  % ---- ゾーン ----
  \begin{scope}[on background layer]
    \node[zone, fit=(c1)(s1)(k1)(r1)(n1a)(n1b)(n1c)(n1d)] (z1) {};
    \node[zone, fit=(c2)(b2)(r2)(n2a)(n2b)(n2d)] (z2) {};
  \end{scope}
  \node[zlabel] at (z1.north) {\texttt{\$(cat f.txt)}：\texttt{cat} を呼ぶ};
  \node[zlabel] at (z2.north) {\texttt{\$(<f.txt)}：\texttt{cat} を呼ばない};
\end{tikzpicture}
