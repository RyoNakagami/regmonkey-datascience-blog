#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
% ファイルアイコン（左下隅 #1, 幅0.9, 高さ1.15, 右上を折り返し）
\newcommand{\fileicon}[1]{
  \draw[draw=navy, fill=white, line join=round] #1 -- ++(0,1.15) -- ++(0.62,0) -- ++(0.28,-0.28) -- ++(0,-0.87) -- cycle;
  \draw[draw=navy, fill=aliceblue, line join=round] #1 ++(0.62,1.15) -- ++(0,-0.28) -- ++(0.28,0) -- cycle;
  \draw[draw=lightgray] #1 ++(0.15,0.75) -- ++(0.45,0);
  \draw[draw=lightgray] #1 ++(0.15,0.55) -- ++(0.6,0);
  \draw[draw=lightgray] #1 ++(0.15,0.35) -- ++(0.6,0);
}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    title/.style={font=\bfseries, text=navy},
    wire/.style={->, draw=navy},
  ]
  % ---- ① 複数ファイル ----
  \fileicon{(0,1.05)}
  \fileicon{(1.15,1.05)}
  \fileicon{(0,-0.55)}
  \fileicon{(1.15,-0.55)}
  \node[font=\scriptsize, text=darkgray, anchor=north] at (0.45,1.02) {a.txt};
  \node[font=\scriptsize, text=darkgray, anchor=north] at (1.6,1.02) {b.png};
  \node[font=\scriptsize, text=darkgray, anchor=north] at (0.45,-0.58) {c.csv};
  \node[font=\scriptsize, text=darkgray, anchor=north] at (1.6,-0.58) {d.md};
  \node[title, anchor=south] at (1.02,2.3) {複数ファイル};

  % ---- tar ----
  \draw[wire] (2.4,0.55) -- node[midway, above, step] {tar} node[midway, below, sig, align=center] {まとめる\\（圧縮しない）} (4.3,0.55);

  % ---- ② xxx.tar：1本に連結 ----
  \draw[draw=navy, fill=aliceblue, rounded corners=3pt] (4.5,-0.6) rectangle (6.9,1.7);
  \foreach \y/\n in {1.15/a.txt, 0.6/b.png, 0.05/c.csv, -0.5/d.md} {
    \draw[draw=navy, fill=white] (4.7,\y) rectangle (6.7,\y+0.42);
    \node[font=\scriptsize, text=fontblack] at (5.7,\y+0.21) {\n};
  }
  \node[title, anchor=south] at (5.7,2.3) {xxx.tar};
  \node[sig, anchor=north] at (5.7,-0.7) {1つのファイルに連結};
  \node[sig, anchor=north] at (5.7,-1.1) {サイズ ≈ 元の合計};

  % ---- gzip ----
  \draw[wire] (7.1,0.55) -- node[midway, above, step] {gzip} node[midway, below, sig] {圧縮する} (9.0,0.55);

  % ---- ③ xxx.tar.gz：圧縮されて小さく ----
  \draw[draw=navy, fill=paleskyblue, rounded corners=3pt] (9.2,0.0) rectangle (10.8,1.1);
  \node[font=\scriptsize\bfseries, text=navy, align=center] at (10.0,0.55) {圧縮済み\\データ};
  \node[title, anchor=south] at (10.0,2.3) {xxx.tar.gz};
  \node[font=\footnotesize, text=azureblue, anchor=south] at (10.0,1.85) {（= xxx.tgz）};
  \node[sig, anchor=north] at (10.0,-0.7) {中身は .tar と同じ};
  \node[sig, anchor=north] at (10.0,-1.1) {サイズが小さくなる};

  % ---- 逆方向：展開 ----
  \draw[draw=lightgray] (0,-1.6) -- (10.8,-1.6);
  \draw[wire, draw=azureblue] (10.0,-2.2) -- node[pos=0.5, above, step] {展開} (1.02,-2.2);
  \node[font=\footnotesize, text=azureblue, anchor=north] at (5.5,-2.3)
    {\texttt{tar -xzf xxx.tgz}：gzip 展開と tar 展開を1回で行い，元のファイルに戻す};
\end{tikzpicture}
