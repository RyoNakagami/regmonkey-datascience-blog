#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    head/.style={font=\bfseries, text=navy, anchor=west},
    pkt/.style={draw=navy, fill=paleskyblue, minimum width=0.42cm, minimum height=0.55cm, inner sep=0pt},
    ping/.style={draw=azureblue, fill=white, line width=1.2pt, minimum width=0.42cm, minimum height=0.55cm, inner sep=0pt, font=\scriptsize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]
  % ================= 上段：Idle =================
  \node[head] at (-1.2,1.55) {Idle（何も通信していないとき）};
  \node[block, minimum width=2.2cm] (s1) at (0,0) {Server};
  \node[block, minimum width=2.2cm] (c1) at (11,0) {Client};
  % バッファ
  \draw[draw=navy] (3.6,0.45) -- (7.4,0.45);
  \draw[draw=navy] (3.6,-0.45) -- (7.4,-0.45);
  \node[sig, anchor=south] at (5.5,0.5) {ルーター等のバッファ（待ち行列）};
  \node[ping] at (6.9,0) {P};
  \draw[wire] (s1) -- (3.5,0);
  \draw[wire] (7.5,0) -- (c1);
  \node[sig, anchor=north] at (5.5,-0.55) {待ち行列が空 → ping はすぐ通過};
  \node[font=\footnotesize, text=azureblue, anchor=north] at (c1.south) {RTT ≈ 4 ms};

  % ================= 下段：Loaded =================
  \node[head] at (-1.2,-2.15) {Loaded（Download 測定中）};
  \node[block, minimum width=2.2cm] (s2) at (0,-3.7) {Server};
  \node[block, minimum width=2.2cm] (c2) at (11,-3.7) {Client};
  \draw[draw=navy] (3.6,-3.25) -- (7.4,-3.25);
  \draw[draw=navy] (3.6,-4.15) -- (7.4,-4.15);
  \foreach \x in {4.4,4.9,5.4,5.9,6.4,6.9} {
    \node[pkt] at (\x,-3.7) {};
  }
  \node[ping] at (3.9,-3.7) {P};
  \draw[wire] (s2) -- (3.5,-3.7);
  \draw[wire] (7.5,-3.7) -- (c2);
  \node[sig, anchor=south] at (5.5,-3.2) {Download データで待ち行列が満杯};
  \node[sig, anchor=north, align=center] at (5.5,-4.25) {ping は前のデータが捌けるまで待たされる};
  \node[font=\footnotesize, text=crimsonred, anchor=north] at (c2.south) {RTT が数十〜数百 ms に};

  % 凡例
  \node[ping] (lp) at (-0.6,-5.6) {P};
  \node[sig, anchor=west] at (lp.east) {ping（遅延測定用）};
  \node[pkt] (ld) at (3.6,-5.6) {};
  \node[sig, anchor=west] at (ld.east) {Download データ};
\end{tikzpicture}
