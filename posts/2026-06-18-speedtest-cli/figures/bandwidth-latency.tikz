#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    head/.style={font=\bfseries, text=navy},
    wire/.style={->, draw=navy},
  ]
  % 端点
  \node[block, minimum width=2.8cm, minimum height=4.6cm] (cli) at (0,0) {Client\\[2pt]{\footnotesize あなたのPC}};
  \node[block, minimum width=2.8cm, minimum height=4.6cm] (srv) at (11,0) {Speedtest\\Server\\[2pt]{\footnotesize 例：Tokyo}};

  % ---- 上段：帯域 = パイプの太さ ----
  \node[head, anchor=south] at (5.5,2.55) {帯域（Bandwidth）＝ パイプの太さ};
  \draw[draw=navy, fill=paleskyblue] (1.4,0.9) rectangle (9.6,2.1);
  \foreach \x in {2.0,2.9,3.8,4.7,5.6,6.5,7.4,8.3} {
    \draw[draw=navy, fill=white] (\x,1.2) rectangle ++(0.6,0.6);
  }
  \node[sig, anchor=north] at (5.5,0.85) {1秒あたりに流せるデータ量（Mbps）．太いほど一度に大量に運べる};

  % ---- 下段：レイテンシ = 往復時間 ----
  \node[head, anchor=south] at (5.5,-0.75) {レイテンシ（Latency）＝ 往復にかかる時間};
  \draw[wire] (1.4,-1.15) -- node[midway, above, sig] {① ping（小さなパケット）} (9.6,-1.15);
  \draw[wire] (9.6,-1.85) -- node[midway, below, sig] {② 応答} (1.4,-1.85);
  \node[sig, anchor=north, text=azureblue] at (5.5,-2.4) {①→② の往復時間（RTT, ms）．小さいほど反応が速い};
\end{tikzpicture}
