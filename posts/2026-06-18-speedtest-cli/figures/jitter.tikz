#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    x=1.1cm, y=1.6cm,
  ]
  % 縦軸は 3.5 ms を原点にとる (y = RTT - 3.5)
  % 軸
  \draw[->, draw=navy] (0,0) -- (9,0) node[sig, anchor=north west] {測定回};
  \draw[->, draw=navy] (0,0) -- (0,1.6) node[sig, anchor=south] {RTT（ms）};
  \foreach \v/\l in {0.29/3.79, 1.13/4.63} {
    \draw[draw=navy] (-0.08,\v) -- (0.08,\v);
    \node[sig, anchor=east] at (-0.1,\v) {\l};
  }

  % low / high
  \draw[draw=darkgray, dashed] (0,1.13) -- (8.6,1.13) node[sig, anchor=west] {high（最大）};
  \draw[draw=darkgray, dashed] (0,0.29) -- (8.6,0.29) node[sig, anchor=west] {low（最小）};

  % 測定値 (イメージ)
  \draw[draw=navy] plot coordinates {(1,0.55) (2,0.95) (3,0.29) (4,1.13) (5,0.62) (6,0.40) (7,0.88) (8,0.70)};
  \foreach \x/\y in {1/0.55,2/0.95,3/0.29,4/1.13,5/0.62,6/0.40,7/0.88,8/0.70} {
    \fill[navy] (\x,\y) circle (2.2pt);
  }

  % 隣接差の強調
  \draw[<->, draw=azureblue, line width=1pt] (2.35,0.95) -- (2.35,0.29);
  \node[font=\footnotesize, text=azureblue, anchor=south] at (2.6,1.17) {隣り合う測定の差};

  % 説明
  \node[sig, anchor=north, align=center] at (4.5,-0.25)
    {jitter ＝ 隣り合う RTT の差（絶対値）の平均．小さいほど遅延が安定している};
\end{tikzpicture}
