#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    pkt/.style={draw=navy, fill=paleskyblue, minimum width=0.42cm, minimum height=0.55cm, inner sep=0pt, font=\scriptsize},
    lost/.style={draw=crimsonred, fill=mistyrose, minimum width=0.42cm, minimum height=0.55cm, inner sep=0pt, font=\scriptsize, text=crimsonred},
    wire/.style={->, draw=navy},
  ]
  \node[block, minimum width=2.2cm] (s) at (0,0) {送信側};
  \node[block, minimum width=2.2cm] (c) at (11,0) {受信側};

  % 送信されたパケット列
  \foreach \x/\n in {1.8/5,2.4/4} {
    \node[pkt] at (\x,0) {\n};
  }
  \node[lost] (p3) at (5.65,0) {3};
  \foreach \x/\n in {7.6/2,8.2/1} {
    \node[pkt] at (\x,0) {\n};
  }
  \draw[wire] (s) -- (1.5,0);
  \draw[draw=navy] (2.7,0) -- (p3.west);
  \draw[draw=navy, dashed] (p3.east) -- (7.3,0);
  \draw[wire] (8.5,0) -- (c);

  % 破棄の表示
  \draw[draw=crimsonred, line width=1.4pt] (5.3,0.4) -- (6.0,-0.4);
  \draw[draw=crimsonred, line width=1.4pt] (5.3,-0.4) -- (6.0,0.4);
  \node[font=\footnotesize, text=crimsonred, anchor=south, align=center] at (5.65,0.5)
    {バッファ溢れ・無線の電波干渉などで破棄};

  % 結果
  \node[sig, anchor=north, align=center] at (5.5,-0.75)
    {Packet Loss ＝ 届かなかったパケットの割合（例：100個中1個 → 1\%）};
  \node[sig, anchor=north, align=center] at (5.5,-1.3)
    {TCP では再送されるため速度低下に，通話・ゲーム（UDP）では音切れ・カクつきとして現れる};
\end{tikzpicture}
