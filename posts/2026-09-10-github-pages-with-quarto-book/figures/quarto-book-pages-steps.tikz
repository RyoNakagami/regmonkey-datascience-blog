#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=3.3cm, minimum height=1.3cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b1) {Quarto book\\を作成};
  \node[block, right=1.0cm of b1] (b2) {GitHub に\\push};
  \node[accent, right=1.0cm of b2] (b3) {Pages の Source を\\GitHub Actions に};
  \node[block, right=1.0cm of b3] (b4) {ワークフロー\\を追加};
  \node[block, right=1.0cm of b4] (b5) {main に push\\→ 自動公開};
  \node[step, above=2mm of b1] {Step 1};
  \node[step, above=2mm of b2] {Step 2};
  \node[step, above=2mm of b3] {Step 3};
  \node[step, above=2mm of b4] {Step 4};
  \node[step, above=2mm of b5] {Step 5};
  \node[note, below=2mm of b1] {\texttt{quarto create}\\\texttt{project book}};
  \node[note, below=2mm of b2] {Free プランは\\public リポジトリ};
  \node[note, below=2mm of b3] {Settings → Pages\\→ Source};
  \node[note, below=2mm of b4] {\texttt{.github/workflows/}\\\texttt{publish.yml}};
  \node[note, below=2mm of b5] {\texttt{<user>.github.io}\\\texttt{/<repo>/}};
  \draw[wire] (b1) -- (b2);
  \draw[wire] (b2) -- (b3);
  \draw[wire] (b3) -- (b4);
  \draw[wire] (b4) -- (b5);
\end{tikzpicture}
