#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.4cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    judge/.style={draw=navy, fill=white, diamond, align=center, inner sep=1pt},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    tok/.style={draw=navy, fill=paleskyblue, rounded corners=2pt,
                font=\small\ttfamily, minimum height=0.7cm, inner sep=4pt},
    rest/.style={draw=darkgray, dashed, fill=white, rounded corners=2pt,
                 font=\small\ttfamily, minimum height=0.7cm, inner sep=4pt},
    wire/.style={->, draw=navy},
  ]
  % ---- main flow -------------------------------------------------
  \node[block] (read) at (0,0) {単語を読み取る\\[2pt]{\footnotesize\color{darkgray}引用符なし・適切な位置}};
  \node[judge] (match) at (4.7,0) {alias名と\\一致？};
  \node[accent] (repl) at (9.3,0) {alias値に置換};
  \node[block] (reread) at (13.7,0) {置換後の値を\\読み取ったものとして処理};

  \node[step, above=2mm of read] {Step 1：照合};
  \node[step, above=2mm of repl] {Step 2：置換};

  \draw[wire] (read) -- (match);
  \draw[wire] (match) -- node[midway, above, sig] {Yes} (repl);
  \draw[wire] (repl) -- (reread);

  % ---- alias definition (precondition) ---------------------------
  \node[ext] (def) at (4.7,2.5) {定義済みalias\\[2pt]\texttt{alias ll='ls -l'}};
  \draw[->, draw=darkgray, dashed] (def) -- (match);

  % ---- no match --------------------------------------------------
  \node[block, fill=white] (asis) at (4.7,-2.7) {置換せず\\そのまま処理};
  \draw[wire] (match) -- node[midway, right, sig] {No} (asis);

  % ---- example notes ---------------------------------------------
  \node[note, below=2mm of read] {例：\texttt{ll -a /tmp} の \texttt{ll}};

  % ---- token view: following characters are not checked ----------
  \node[tok]  (t1) at (8.2,-2.7) {ll};
  \node[rest, right=0mm of t1] (r1) {-a /tmp};
  \node[tok]  (t2) at (12.0,-2.7) {ls -l};
  \node[rest, right=0mm of t2] (r2) {-a /tmp};
  \draw[wire] (r1.east) ++(0.25,0) -- ($(t2.west)+(-0.25,0)$);
  \node[note, anchor=south west] at ($(t1.north west)+(0,0.12)$) {入力};
  \node[note, anchor=south west] at ($(t2.north west)+(0,0.12)$) {シェルが読む入力};
  \node[note, anchor=north, text=azureblue, font=\footnotesize\bfseries]
    at ($(r1.south)!0.5!(r2.south)+(0,-0.25)$)
    {後続の文字（\texttt{-a /tmp}）は確認せず，そのまま残る};
\end{tikzpicture}
