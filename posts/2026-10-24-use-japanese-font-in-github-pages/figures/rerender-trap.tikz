#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]

  % 上段：workflow だけ push
  \node[block] (a1) at (0,2.7)    {workflow だけ\\修正して push};
  \node[block] (a2) at (4.7,2.7)  {\texttt{.qmd} の差分なし\\→ \texttt{mode=none}};
  \node[block] (a3) at (9.4,2.7)  {render しない\\（gh-pages を流用）};
  \node[ng]    (a4) at (14.1,2.7) {豆腐のまま};

  % 中段：full_render を手動実行
  \node[block] (b1) at (0,0)      {\texttt{full\_render=true}\\で手動実行};
  \node[block] (b2) at (4.7,0)    {\texttt{quarto render}\\（プロジェクト全体）};
  \node[block] (b3) at (9.4,0)    {\texttt{freeze: auto}\\ソース不変 → 実行しない};
  \node[ng]    (b4) at (14.1,0)   {\texttt{\_freeze} の\\豆腐画像を再利用};

  % 下段：.qmd も変更して push
  \node[block]  (c1) at (0,-2.7)    {\texttt{.qmd} も変更して\\push};
  \node[block]  (c2) at (4.7,-2.7)  {\texttt{mode=partial}\\\texttt{quarto render <file>}};
  \node[block]  (c3) at (9.4,-2.7)  {単一ファイルの render は\\常にコードを実行};
  \node[accent] (c4) at (14.1,-2.7) {日本語で描画};

  % 列の見出し
  \node[step, above=2mm of a1] {① push の内容};
  \node[step, above=2mm of a2] {② render の範囲};
  \node[step, above=2mm of a3] {③ Python の実行};
  \node[step, above=2mm of a4] {④ 公開される図};

  \foreach \r in {a,b,c} {
    \draw[wire] (\r1) -- (\r2);
    \draw[wire] (\r2) -- (\r3);
    \draw[wire] (\r3) -- (\r4);
  }
\end{tikzpicture}
