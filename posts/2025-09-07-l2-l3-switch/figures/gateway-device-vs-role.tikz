#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
  auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    title/.style={font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % ---- left: gateway as a device ----
  \node[title] at (0,4.7) {機器としてのゲートウェイ};
  \node[block, minimum width=3.4cm] (cloud) at (0,3.4) {クラウド};
  \node[accent, minimum width=3.4cm] (gw) at (0,1.4) {IoT ゲートウェイ\\プロトコル変換};
  \node[block, minimum width=3.4cm] (sensor) at (0,-1.2) {センサー・制御機器};
  \draw[wire] (sensor) -- node[midway, right, sig] {Modbus / BLE} (gw);
  \draw[wire] (gw) -- node[midway, right, sig] {MQTT（TCP/IP）} (cloud);
  \node[note] at (0,-2.6) {異なるプロトコルの境界で\\変換する装置の名前};

  \draw[lightgray] (4.3,5.1) -- (4.3,-3.2);

  % ---- right: gateway as a role ----
  \node[title] at (9.2,4.7) {役割としてのゲートウェイ};
  \node[block, minimum width=7.6cm] (out) at (9.2,3.4) {他のサブネット・インターネット};
  \node[block, minimum width=2.3cm] (r1) at (6.6,1.2) {家庭用\\ルーター};
  \node[block, minimum width=2.3cm] (r2) at (9.2,1.2) {L3スイッチの\\SVI};
  \node[block, minimum width=2.3cm] (r3) at (11.8,1.2) {Linux ホスト\\（docker0）};
  \node[font=\footnotesize\bfseries, text=azureblue] (zl) at (9.2,2.15) {デフォルトゲートウェイ（どれか1台が担う）};
  \begin{scope}[on background layer]
    \node[zone, fit=(r1)(r2)(r3)(zl), inner sep=6pt] (z) {};
  \end{scope}
  \node[block, minimum width=3.4cm] (pc) at (9.2,-1.2) {PC\\192.168.10.11};
  \draw[wire] (pc) -- node[midway, right, sig] {default via 192.168.10.1} (z);
  \draw[wire] (z) -- (out);
  \node[note] at (9.2,-2.6) {端末の設定上の「出口」．\\L3 で転送できる機器ならどれでも担える};
\end{tikzpicture}
