#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.4cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue, align=right},
    life/.style={draw=lightgray, line width=1.2pt},
    wire/.style={->, draw=navy},
    bcast/.style={->, draw=navy, dashed},
    hit/.style={->, draw=azureblue, line width=1.2pt},
  ]
  % ---- lifelines: x = 0 (PC), 5.4 (switch), 10.8 (NAS) ----
  \node[block]  (pc)  at (0,0)    {PC\\192.168.1.10};
  \node[accent] (sw)  at (5.4,0)  {L2スイッチ\\（ルーターのLANポート）};
  \node[block]  (nas) at (10.8,0) {NAS\\192.168.1.20};
  \foreach \n in {pc, sw, nas}
    \draw[life] (\n.south) -- (\n.south |- 0,-6.2);

  % ---- step labels ----
  \node[step, anchor=east] at (-1.9,-1.4) {① 宛先の判定};
  \node[step, anchor=east] at (-1.9,-2.6) {② ARP 要求};
  \node[step, anchor=east] at (-1.9,-3.8) {③ ARP 応答};
  \node[step, anchor=east] at (-1.9,-5.0) {④ データ送信};
  \draw[lightgray] (-4.4,-4.4) -- (11.8,-4.4);

  % (1) same network -> deliver directly
  \node[sig, anchor=west, fill=white] at (0.15,-1.4) {宛先 .20 は自分と同じ 192.168.1.0/24 → 直接届けられる};

  % (2) ARP request (broadcast)
  \draw[wire]  (0,-2.6)   -- (5.4,-2.6)  node[midway, above, sig] {「.20 の MAC は？」};
  \draw[bcast] (5.4,-2.6) -- (10.8,-2.6) node[midway, above, sig] {全ポートへ（ブロードキャスト）};

  % (3) ARP reply (unicast)
  \draw[wire] (10.8,-3.8) -- (5.4,-3.8) node[midway, above, sig] {「MAC は NAS のもの」};
  \draw[wire] (5.4,-3.8)  -- (0,-3.8)   node[midway, above, sig] {PC のポートにだけ};

  % (4) data frame: switch looks only at the destination MAC
  \draw[hit] (0,-5.0)   -- (5.4,-5.0)  node[midway, above, sig] {宛先MAC = NAS のフレーム};
  \draw[hit] (5.4,-5.0) -- (10.8,-5.0) node[midway, above, sig] {NAS のポートにだけ転送};
  \node[sig, text=azureblue, font=\footnotesize\bfseries, fill=white] at (5.4,-5.75) {IP は見ずに宛先 MAC だけで判断};
\end{tikzpicture}
