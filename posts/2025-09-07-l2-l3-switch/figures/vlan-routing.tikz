#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
  auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt, minimum height=1.1cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
    link/.style={draw=navy},
  ]
  % ---- left: L2 switch only ----
  \node[font=\bfseries, text=navy] at (0,1.5) {L2スイッチのみ};
  \node[block, minimum width=5.6cm] (sw) at (0,0) {L2スイッチ};
  \node[block, minimum width=2.4cm] (p1) at (-1.6,-3.0) {PC1\\192.168.10.11};
  \node[block, minimum width=2.4cm] (p2) at (1.6,-3.0) {PC2\\192.168.20.11};
  \draw[link] (p1.north) -- (p1.north |- sw.south);
  \draw[link] (p2.north) -- (p2.north |- sw.south);
  \node[ng, minimum height=0.6cm, inner sep=2pt, font=\footnotesize] at (0,-1.35) {VLAN間は届かない};
  \begin{scope}[on background layer]
    \node[zone, fit=(p1), inner sep=6pt] (v10) {};
    \node[zone, fit=(p2), inner sep=6pt] (v20) {};
  \end{scope}
  \node[sig, below=1mm of v10] {VLAN10};
  \node[sig, below=1mm of v20] {VLAN20};

  \draw[lightgray] (4.0,1.8) -- (4.0,-4.6);

  % ---- right: L3 switch with SVIs ----
  \node[font=\bfseries, text=navy] at (8.7,1.5) {L3スイッチ};
  \node[block, minimum width=7.6cm, minimum height=2.0cm] (l3) at (8.7,-0.25) {};
  \node[font=\small, text=navy, anchor=north] at (l3.north) {L3スイッチ};
  \node[accent, minimum height=0.8cm, font=\footnotesize] (s10) at (6.6,-0.5) {SVI VLAN10\\192.168.10.1};
  \node[accent, minimum height=0.8cm, font=\footnotesize] (s20) at (10.8,-0.5) {SVI VLAN20\\192.168.20.1};
  \draw[<->, draw=azureblue, line width=1pt] (s10.east) -- (s20.west);
  \node[step, above=0pt] at ($(s10.east)!0.5!(s20.west)$) {ルーティング};
  \node[block, minimum width=2.4cm] (q1) at (6.6,-3.0) {PC1\\192.168.10.11};
  \node[block, minimum width=2.4cm] (q2) at (10.8,-3.0) {PC2\\192.168.20.11};
  \draw[->, draw=azureblue, line width=1pt] (q1.north) -- (s10.south);
  \draw[->, draw=azureblue, line width=1pt] (s20.south) -- (q2.north);
  \begin{scope}[on background layer]
    \node[zone, fit=(q1), inner sep=6pt] (w10) {};
    \node[zone, fit=(q2), inner sep=6pt] (w20) {};
  \end{scope}
  \node[sig, below=1mm of w10] {VLAN10（GW: .10.1）};
  \node[sig, below=1mm of w20] {VLAN20（GW: .20.1）};
\end{tikzpicture}
