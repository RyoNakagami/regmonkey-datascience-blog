#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
  auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt, minimum height=1.1cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
    link/.style={draw=navy},
  ]
  % fields of an Ethernet frame carrying an IPv4 packet (simplified)
  \foreach \a/\b/\m/\t/\f in {0/2.4/1.2/宛先MAC/paleskyblue, 2.4/4.8/3.6/送信元MAC/aliceblue,
      4.8/6.0/5.4/タイプ/aliceblue, 6.0/7.2/6.6/TTL/aliceblue, 7.2/9.4/8.3/送信元IP/aliceblue,
      9.4/11.6/10.5/宛先IP/paleskyblue, 11.6/14.4/13.0/データ（TCP等）/aliceblue, 14.4/15.6/15.0/FCS/aliceblue} {
    \draw[navy, fill=\f] (\a,0) rectangle (\b,1);
    \node at (\m,0.5) {\t};
  }
  \draw[navy, decorate, decoration={brace, amplitude=6pt}] (0,1.15) -- (6.0,1.15)
    node[midway, above=8pt, font=\bfseries, text=navy] {Ethernet ヘッダ（L2）};
  \draw[navy, decorate, decoration={brace, amplitude=6pt}] (6.0,1.15) -- (11.6,1.15)
    node[midway, above=8pt, font=\bfseries, text=navy] {IP ヘッダ（L3，一部）};
  \draw[navy, decorate, decoration={brace, amplitude=6pt}] (11.6,1.15) -- (15.6,1.15)
    node[midway, above=8pt, font=\bfseries, text=navy] {ペイロード・末尾};

  \node[block, minimum width=3.2cm] (l2) at (1.2,-1.9) {L2スイッチ};
  \node[accent, minimum width=3.2cm] (l3) at (10.5,-1.9) {L3スイッチ};
  \draw[wire] (l2.north) -- (1.2,-0.05);
  \draw[wire] (l3.north) -- (10.5,-0.05);
  \node[note, below=2mm of l2] {宛先MACで出力ポートを決める\\フレームは書き換えない};
  \node[note, below=2mm of l3] {宛先IPで次の転送先を決める\\MACを付け替え，TTLを1減らす};
\end{tikzpicture}
