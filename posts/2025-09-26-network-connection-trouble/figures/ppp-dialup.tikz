#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    link/.style={draw=navy},
  ]
  % 主経路
  \node[accent] (pc) {コンピュータ};
  \node[block, right=1.2cm of pc] (m1) {モデム};
  \node[block, right=4.2cm of m1] (m2) {モデム};
  \node[accent, right=1.2cm of m2] (as) {アクセスサーバ};
  \node[block, ellipse, minimum width=2.8cm, right=1.4cm of as] (net) {インターネット};

  \draw[link] (pc) -- (m1);
  \draw[link] (m1) -- node[midway, above, sig] {電話回線}
                      node[midway, below, sig] {電話をかけて接続} (m2);
  \draw[link] (m2) -- (as);
  \draw[link] (as) -- (net);

  % 補足
  \node[note, below=2mm of m1] {デジタル⇔\\アナログ変換};
  \node[note, below=2mm of as] {ユーザー認証・\\IPアドレス割当};

  % ゾーン
  \coordinate (ztop) at ($(pc.north)+(0,0.1)$);
  \coordinate (zbot) at ($(pc.south)+(0,-0.85)$);
  \begin{scope}[on background layer]
    \node[zone, fit=(pc)(m1)(pc |- ztop)(pc |- zbot)] (zuser) {};
    \node[zone, fit=(m2)(as)(m2 |- ztop)(m2 |- zbot)] (zisp) {};
  \end{scope}
  \node[zlabel] at (zuser.north) {利用者側};
  \node[zlabel] at (zisp.north) {プロバイダ（ISP）側};

  % PPP リンク
  \coordinate (pl) at ($(pc.north)+(0,1.75)$);
  \coordinate (pr) at (as.north |- pl);
  \draw[<->, draw=azureblue, line width=1pt] (pl) -- (pr)
    node[midway, above=1pt, font=\bfseries, text=azureblue] {PPP：2点間を1対1で接続};
  \draw[draw=azureblue, dashed] (pl) -- (zuser.north -| pl);
  \draw[draw=azureblue, dashed] (pr) -- (zisp.north -| pr);
  \node[note, below=1pt] at ($(pl)!0.5!(pr)$) {LCP でリンクを確立 → NCP で IP アドレスなどを設定};
\end{tikzpicture}
