#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.0cm, minimum width=3.2cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    msg/.style={->, draw=navy},
    act/.style={above=2pt, inner sep=2pt},
    proto/.style={below=2pt, font=\footnotesize\bfseries, text=azureblue, inner sep=2pt},
    life/.style={draw=darkgray, dashed},
  ]
  \def\W{9}
  % 参加者
  \node[accent] (a) at (0,0) {コンピュータ};
  \node[accent] (b) at (\W,0) {アクセスサーバ};

  % ライフライン
  \draw[life] (a.south) -- (0,-6.5);
  \draw[life] (b.south) -- (\W,-6.5);

  % メッセージ（上：やりとりの内容，下：使うプロトコル）
  \draw[msg] (0,-1.6) -- (\W,-1.6)
    node[midway, act] {通信要求を送信};
  \draw[<->, draw=navy] (0,-3.0) -- (\W,-3.0)
    node[midway, act] {通信条件について相談}
    node[midway, proto] {LCP：リンクの確立};
  \draw[msg] (\W,-4.4) -- (0,-4.4)
    node[midway, act] {接続する資格を持ったユーザーか確認}
    node[midway, proto] {ユーザー認証：PAP / CHAP};
  \draw[msg] (\W,-5.8) -- (0,-5.8)
    node[midway, act] {IPアドレスなどを設定}
    node[midway, proto] {NCP};

  % 接続確立
  \node[block, minimum width=10.4cm] at (\W/2,-7.0) {接続が確立し，通信を開始};
\end{tikzpicture}
