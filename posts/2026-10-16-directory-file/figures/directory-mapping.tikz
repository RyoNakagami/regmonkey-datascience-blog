#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    name/.style={draw=navy, fill=white, rounded corners=3pt, minimum width=2.4cm,
                 minimum height=0.7cm, inner sep=3pt, font=\ttfamily\small},
    file/.style={draw=navy, fill=aliceblue, rounded corners=3pt, minimum width=2.4cm,
                 minimum height=0.7cm, inner sep=3pt},
    ngname/.style={name, draw=crimsonred, fill=mistyrose},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=9pt},
    zlabel/.style={anchor=south, font=\footnotesize\bfseries, text=navy},
    head/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
    ngwire/.style={->, draw=crimsonred},
  ]

  % ---- 図タイトル ----
  \node[font=\large\bfseries, text=navy] at (6.7,2.5)
    {ディレクトリ $D$ は「名前 → ファイル」の写像 $f_D$ を定める};

  % ゾーン枠の上下端（左右パネル共通）
  \coordinate (ztop) at (0,0.35);
  \coordinate (zbot) at (0,-2.55);

  % ================= 左：許されない（3.103） =================
  \node[head, text=crimsonred] at (2.2,1.55) {許されない：同じ名前が2つのファイルを指す（3.103）};

  \node[ngname] (b1) at (0,-0.55) {notes.txt};
  \node[name]   (b3) at (0,-2.2)  {src};
  \node[file] (g1) at (4.4,0)    {inode 512};
  \node[file] (g2) at (4.4,-1.1) {inode 801};
  \node[file] (g3) at (4.4,-2.2) {inode 730};

  \begin{scope}[on background layer]
    \node[zone, fit=(b1)(b3)(b1 |- ztop)(b3 |- zbot)] (zb) {};
    \node[zone, fit=(g1)(g3)(g1 |- ztop)(g3 |- zbot)] (zg) {};
  \end{scope}
  \node[zlabel] at (zb.north) {$D$ 内の名前};
  \node[zlabel] at (zg.north) {ファイル};

  \draw[ngwire] (b1.east) -- (g1.west);
  \draw[ngwire] (b1.east) -- (g2.west);
  \draw[wire]   (b3.east) -- (g3.west);
  \node[font=\bfseries, text=crimsonred] at ($(b1.east)+(1.7,0)$) {×};

  \node[note, anchor=north] at ([yshift=-4pt]$(zb.south)!0.5!(zg.south)$)
    {名前から指す先が1つに決まらず，$f_D$ が写像にならない};

  % ================= 右：許される（3.104） =================
  \node[head] at (11.2,1.55) {許される：単射でなくてよい（3.104）};

  \node[name] (a1) at (9,0)     {notes.txt};
  \node[name] (a2) at (9,-1.1)  {memo.txt};
  \node[name] (a3) at (9,-2.2)  {src};
  \node[file] (f1) at (13.4,-0.55) {inode 512};
  \node[file] (f2) at (13.4,-2.2)  {inode 730};

  \begin{scope}[on background layer]
    \node[zone, fit=(a1)(a3)(a1 |- ztop)(a3 |- zbot)] (za) {};
    \node[zone, fit=(f1)(f2)(f1 |- ztop)(f2 |- zbot)] (zf) {};
  \end{scope}
  \node[zlabel] at (za.north) {$D$ 内の名前};
  \node[zlabel] at (zf.north) {ファイル};

  \draw[wire] (a1.east) -- (f1.west) node[pos=0.45, above, font=\footnotesize, text=darkgray] {$f_D$};
  \draw[wire] (a2.east) -- (f1.west);
  \draw[wire] (a3.east) -- (f2.west);

  \node[note, anchor=north] at ([yshift=-4pt]$(za.south)!0.5!(zf.south)$)
    {異なる名前が同じファイルを指してよい（ハードリンク）};

\end{tikzpicture}
