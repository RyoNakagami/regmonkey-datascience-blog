#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    card/.style={block, fill=white},
    ename/.style={draw=navy, fill=white, minimum width=2.6cm, minimum height=0.75cm,
                  anchor=west, inner sep=4pt, font=\ttfamily\small},
    eino/.style={draw=navy, fill=white, minimum width=1.9cm, minimum height=0.75cm,
                 anchor=west, inner sep=4pt},
    zone/.style={draw=navy, fill=paleskyblue, rounded corners=8pt, inner sep=12pt},
    head/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]

  % ---- ディレクトリファイル（名前 → inode 番号の表）----
  \node[head] (hname) at (1.3,0.9) {名前};
  \node[head] (hino)  at (3.55,0.9) {inode 番号};
  \foreach \i/\n/\k in {0/./120, 1/../2, 2/notes.txt/512, 3/src/730} {
    \node[ename] (n\i) at (0,-\i*0.75) {\n};
    \node[eino]  (k\i) at (n\i.east) {\k};
  }
  \begin{scope}[on background layer]
    \node[zone, fit=(hname)(hino)(n0)(k3)] (dir) {};
  \end{scope}
  \node[head, anchor=south] at (dir.north) {ディレクトリファイル（/home/kirby）};
  \node[note, anchor=north] at ([yshift=-2pt]dir.south)
    {中身は「名前 → inode 番号」の対応表だけ};

  % ---- inode（ファイルの実体）----
  \node[block, text width=3.4cm, right=2.4cm of k2, yshift=1.4cm] (i512)
    {\textbf{inode 512}\\[2pt]{\footnotesize 種類・権限・サイズ\\データの位置}};
  \node[block, text width=3.4cm, right=2.4cm of k3] (i730)
    {\textbf{inode 730}\\[2pt]{\footnotesize 種類＝ディレクトリ}};
  \node[head, anchor=south] at (i512 |- dir.north) {inode（実体）};

  % ---- データブロック ----
  \node[card, text width=3.0cm, right=1.6cm of i512] (d512)
    {\textbf{ファイル本文}\\[2pt]{\footnotesize notes.txt の中身}};
  \node[accent, text width=3.0cm, right=1.6cm of i730] (d730)
    {\textbf{エントリ表}\\[2pt]{\footnotesize src の中身}};
  \node[head, anchor=south] at (d512 |- dir.north) {データブロック};
  \node[note, anchor=north] at ([yshift=-6pt]d730.south)
    {サブディレクトリも\\同じ形の表を持つファイル};

  % ---- 配線 ----
  \draw[wire] (k2.east) -- ++(1.2,0) |- (i512.west);
  \draw[wire] (k3.east) -- (k3.east -| i730.west);
  \draw[wire] (i512) -- (d512);
  \draw[wire] (i730) -- (d730);

  % ---- 出典 ----
  \node[font=\scriptsize, text=darkgray, anchor=north west]
    at ([yshift=-0.85cm]dir.south west)
    {定義：POSIX.1 XBD 3章 Directory / Directory Entry（Link），Ritchie \& Thompson (1974)};
\end{tikzpicture}
