#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    card/.style={draw=navy, fill=white, rounded corners=3pt,
                 minimum width=4.6cm, minimum height=3.2cm},
    title/.style={font=\bfseries, text=navy, anchor=south},
    note/.style={font=\footnotesize, text=darkgray, align=center, anchor=north},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
    term/.style={circle, fill=navy, inner sep=1.3pt},
  ]
  % ---- 3枚のカード ----
  \node[card] (c1) at (0,0) {};
  \node[card] (c2) at (6.9,0) {};
  \node[card] (c3) at (13.8,0) {};

  \node[title] at ([yshift=2mm]c1.north) {トランジスタ};
  \node[title] at ([yshift=2mm]c2.north) {論理回路};
  \node[title] at ([yshift=2mm]c3.north) {CPU（半導体チップ）};

  \node[note] at ([yshift=-2mm]c1.south) {電気信号の ON/OFF を\\切り替えるスイッチ};
  \node[note] at ([yshift=-2mm]c2.south) {トランジスタを組み合わせて\\AND・OR などの演算を作る};
  \node[note] at ([yshift=-2mm]c3.south) {数十億個以上のトランジスタを\\1枚のチップに集積する};

  % ---- (1) トランジスタ = スイッチ ----
  % OFF：接点が離れていて電流が流れない
  \draw[navy] (-1.8,0.65) -- (-0.7,0.65);
  \draw[navy] (-0.7,0.65) -- (0.05,1.05);
  \draw[navy] (0.2,0.65) -- (0.7,0.65);
  \node[term] at (-0.7,0.65) {};
  \node[term] at (0.2,0.65) {};
  \node[anchor=west, font=\footnotesize] at (0.85,0.65) {OFF ＝ 0};
  % ON：接点がつながり電流が流れる
  \draw[navy] (-1.8,-0.65) -- (0.7,-0.65);
  \node[term] at (-0.7,-0.65) {};
  \node[term] at (0.2,-0.65) {};
  \node[anchor=west, font=\footnotesize\bfseries, text=azureblue] at (0.85,-0.65) {ON ＝ 1};

  % ---- (2) 論理回路（AND ゲート） ----
  \draw[navy, fill=aliceblue] (6.55,-0.55) -- (6.95,-0.55)
    arc[start angle=-90, end angle=90, radius=0.55] -- (6.55,0.55) -- cycle;
  \node[font=\footnotesize, text=navy] at (6.95,0) {AND};
  \draw[navy] (5.6,0.28) -- (6.55,0.28);
  \draw[navy] (5.6,-0.28) -- (6.55,-0.28);
  \draw[navy] (7.5,0) -- (8.25,0);
  \node[sig, anchor=east] at (5.6,0.28) {1};
  \node[sig, anchor=east] at (5.6,-0.28) {1};
  \node[sig, anchor=west] at (8.25,0) {1};

  % ---- (3) CPU チップ ----
  \fill[aliceblue] (12.8,-1.0) rectangle (14.8,1.0);
  \draw[lightgray, line width=0.4pt] (12.8,-1.0) grid[step=0.25] (14.8,1.0);
  \draw[navy, rounded corners=2pt] (12.8,-1.0) rectangle (14.8,1.0);
  \foreach \p in {-0.75,-0.375,0,0.375,0.75} {
    \draw[navy] (13.8+\p,1.0) -- (13.8+\p,1.25);
    \draw[navy] (13.8+\p,-1.0) -- (13.8+\p,-1.25);
    \draw[navy] (12.8,\p) -- (12.55,\p);
    \draw[navy] (14.8,\p) -- (15.05,\p);
  }
  \node[draw=navy, fill=white, rounded corners=2pt, font=\bfseries, text=navy,
        inner sep=3pt] at (13.8,0) {CPU};

  % ---- カード間の矢印 ----
  \draw[wire] (c1.east) -- (c2.west) node[midway, above, sig] {組み合わせる};
  \draw[wire] (c2.east) -- (c3.west) node[midway, above, sig] {大量に集積};
\end{tikzpicture}
