#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.6cm, inner sep=5pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b1) at (0,0)
    {\textbf{記述}\\[2pt]{\footnotesize\color{darkgray} プログラマ}};
  \node[block] (b2) at (6.8,0)
    {\textbf{コンパイル}\\[2pt]{\footnotesize\color{darkgray} コンパイラ・リンカ}};
  \node[block] (b3) at (13.6,0)
    {\textbf{ロード}\\[2pt]{\footnotesize\color{darkgray} OS}};
  \node[block] (b4) at (20.4,0)
    {\textbf{解釈・実行}\\[2pt]{\footnotesize\color{darkgray} CPU}};

  \foreach \n/\s/\t in {
      b1/Step 1/C言語などの高水準言語で\\ソースコードを書く,
      b2/Step 2/ソースコードをマシン語に翻訳し\\リンクして実行可能ファイルを作る,
      b3/Step 3/プログラムの起動時に\\マシン語をメインメモリに読み込む,
      b4/Step 4/メモリから命令を1つずつ\\読み出して解釈・実行する} {
    \node[step, above=2mm of \n] {\s};
    \node[note, below=2.5mm of \n] {\t};
  }

  \draw[wire] (b1) -- (b2) node[midway, above, sig] {ソースコード};
  \draw[wire] (b2) -- (b3) node[midway, above, sig] {実行可能ファイル};
  \draw[wire] (b3) -- (b4) node[midway, above, sig] {マシン語の命令};
\end{tikzpicture}
