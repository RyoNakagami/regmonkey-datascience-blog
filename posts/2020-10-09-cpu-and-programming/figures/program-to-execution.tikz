#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.4cm, inner sep=5pt},
    cell/.style={draw=navy, align=center, minimum height=0.9cm, minimum width=3.4cm,
                 inner sep=3pt, font=\footnotesize},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
  ]
  % --- 処理の流れ ---
  \node[block] (b1) at (0,0)
    {\textbf{記述}\\[2pt]{\footnotesize\color{darkgray} プログラマ}};
  \node[block] (b2) at (5.0,0)
    {\textbf{コンパイル}\\[2pt]{\footnotesize\color{darkgray} コンパイラ・リンカ}};
  \node[block] (b3) at (10.0,0)
    {\textbf{ロード}\\[2pt]{\footnotesize\color{darkgray} OS}};

  % --- メインメモリ（命令とデータを同じ場所に格納） ---
  \node[cell, fill=aliceblue] (mi) at (15.0,0.45) {命令（マシン語）};
  \node[cell, fill=white]     (md) at (15.0,-0.45) {データ};
  \node[font=\footnotesize\bfseries, text=navy, above=2mm of mi] (mlabel) {メインメモリ};

  % --- CPU ---
  \node[block] (b4) at (20.0,0)
    {\textbf{解釈・実行}\\[2pt]{\footnotesize\color{darkgray} CPU}};

  \foreach \n/\s/\t in {
      b1/Step 1/C言語などの高水準言語で\\ソースコードを書く,
      b2/Step 2/ソースコードをマシン語に\\翻訳・リンクして\\実行可能ファイルを作る,
      b3/Step 3/プログラムの起動時に\\命令とデータを\\メインメモリに読み込む,
      b4/Step 4/プログラムカウンタが\\指す命令を1つずつ\\読み出して解釈・実行} {
    \node[step, above=2mm of \n] {\s};
    \node[note, below=2.5mm of \n] {\t};
  }
  \node[note, below=2.5mm of md, text=navy, font=\footnotesize\bfseries]
    {命令もデータも\\同じメモリに\\アドレス付きで格納};

  \draw[wire] (b1) -- (b2) node[midway, above, sig] {ソース\\コード};
  \draw[wire] (b2) -- (b3) node[midway, above, sig] {実行可能\\ファイル};
  \draw[wire] (b3) -- (b3 -| mi.west) node[midway, above, sig] {命令と\\データ};

  % メモリ ⇄ CPU
  \draw[wire] (mi.east) -- (mi.east -| b4.west)
    node[midway, above, sig] {命令の\\読み出し};
  \draw[<->, draw=navy] (md.east) -- (md.east -| b4.west)
    node[midway, below, sig] {データの\\読み書き};
\end{tikzpicture}
