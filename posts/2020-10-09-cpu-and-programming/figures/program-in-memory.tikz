#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    cell/.style={draw=navy, fill=aliceblue, minimum height=0.8cm,
                 text width=8.2cm, align=left, inner xsep=8pt, anchor=west},
    datacell/.style={cell, fill=white},
    pc/.style={draw=navy, fill=paleskyblue, rounded corners=2pt,
               minimum width=1.6cm, minimum height=0.62cm},
    head/.style={font=\footnotesize\bfseries, text=navy, align=center, anchor=south},
    addr/.style={font=\small},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % 見出し
  \node[head] at (0,0.5) {プログラムカウンタ\\の値の変化};
  \node[head] at (2.2,0.5) {アドレス};
  \node[head] at (7.4,0.5) {メモリの内容};

  % メモリ：命令（0100〜0104番地）
  \foreach \a/\t [count=\i from 0, evaluate=\i as \y using -0.8*\i] in {
      0100/0105番地の値をアキュムレータに格納せよ,
      0101/0106番地の値を汎用レジスタに格納せよ,
      0102/アキュムレータの値に汎用レジスタの値を加算せよ,
      0103/アキュムレータの値をディスプレイに表示せよ,
      0104/プログラムを終了せよ（OSに戻れ）} {
    \node[addr] at (2.2,\y) {\a};
    \node[cell] at (3.0,\y) {\t};
    \node[pc] at (0,\y) {\a};
  }

  % メモリ：データ（0105〜0106番地）
  \foreach \a/\t [count=\i from 5, evaluate=\i as \y using -0.8*\i] in {
      0105/123, 0106/456} {
    \node[addr] at (2.2,\y) {\a};
    \node[datacell] at (3.0,\y) {\t};
  }

  % プログラムの流れ
  \draw[wire] (-1.35,0.25) -- (-1.35,-3.45);
  \node[note, anchor=east] at (-1.5,-1.6) {プログラム\\の流れ};

  % 命令／データの区分
  \draw[navy, decorate, decoration={brace, amplitude=5pt}] (11.85,0.4) -- (11.85,-3.6);
  \node[anchor=west, font=\footnotesize\bfseries, text=navy] at (12.1,-1.6) {命令};
  \draw[navy, decorate, decoration={brace, amplitude=5pt}] (11.85,-3.65) -- (11.85,-5.2);
  \node[anchor=west, font=\footnotesize\bfseries, text=navy] at (12.1,-4.42) {データ};

  % 出典
  \node[font=\scriptsize, text=darkgray, anchor=north west] at (-2.9,-5.55)
    {出典：矢沢久雄『プログラムはなぜ動くのか』図1-4 をもとに作成};
\end{tikzpicture}
