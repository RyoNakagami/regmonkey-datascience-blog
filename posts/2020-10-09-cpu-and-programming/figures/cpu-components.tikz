#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.4cm, minimum width=3.8cm, inner sep=5pt},
    hw/.style={block, fill=white, draw=darkgray},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=12pt},
    zlabel/.style={anchor=south west, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray},
    flow/.style={->, draw=navy},            % 命令・データの流れ
    bflow/.style={<->, draw=navy},
    ctl/.style={->, draw=navy, dashed},     % 制御信号
  ]
  % CPU 内部の機能要素（上段：クロック・制御装置，下段：演算装置・レジスタ）
  \node[block] (clk) at (-0.7,1.9)
    {\textbf{クロック}\\[2pt]{\footnotesize\color{darkgray} 動作のタイミングを}\\{\footnotesize\color{darkgray} 決める信号を刻む}};
  \node[block] (ctrl) at (5.2,1.9)
    {\textbf{制御装置}\\[2pt]{\footnotesize\color{darkgray} 命令を解釈し}\\{\footnotesize\color{darkgray} 各部の動作を制御する}};
  \node[block] (alu) at (5.2,-1.9)
    {\textbf{演算装置}\\[2pt]{\footnotesize\color{darkgray} レジスタの値を}\\{\footnotesize\color{darkgray} 計算・比較する}};
  \node[block] (reg) at (10.6,-1.9)
    {\textbf{レジスタ}\\[2pt]{\footnotesize\color{darkgray} 読み出した命令や}\\{\footnotesize\color{darkgray} データを一時保持}};

  \begin{scope}[on background layer]
    \node[zone, fit=(clk)(ctrl)(alu)(reg)] (zcpu) {};
  \end{scope}
  \node[zlabel] at ([xshift=2pt]zcpu.north west) {CPU};

  % CPU の外
  \node[hw] (mem) at (17.2,0)
    {\textbf{メインメモリ}\\[2pt]{\footnotesize\color{darkgray} 命令とデータを記憶}};

  % 制御信号（破線）
  \draw[ctl] (clk) -- (ctrl)
    node[midway, above, sig] {クロック信号};
  \draw[ctl] ([yshift=0.3cm]ctrl.east) -| (mem.north)
    node[pos=0.4, above, sig] {① 読み出しの指示};
  \draw[ctl] (ctrl) -- (alu)
    node[midway, right, sig] {演算の指示};

  % 命令・データの流れ（実線）
  \draw[flow] (mem.south) |- (reg.east)
    node[pos=0.73, below, sig] {② 命令・データの読み出し};
  \draw[flow] (reg.north) |- ([yshift=-0.3cm]ctrl.east)
    node[pos=0.75, below, sig] {③ 命令};
  \draw[bflow] (alu) -- (reg)
    node[midway, above, sig] {データ};

  % 補足・凡例
  \node[note, anchor=north west] at ([yshift=-4pt]zcpu.south west)
    {※ いずれの機能要素も，トランジスタを組み合わせた回路として実現されている};
  \coordinate (lg) at (14.0,-3.55);
  \draw[flow] (lg) -- ++(0.9,0);
  \node[note, anchor=west] at ($(lg)+(1.0,0)$) {命令・データの流れ};
  \draw[ctl] ($(lg)+(3.9,0)$) -- ++(0.9,0);
  \node[note, anchor=west] at ($(lg)+(4.9,0)$) {制御信号};
\end{tikzpicture}
