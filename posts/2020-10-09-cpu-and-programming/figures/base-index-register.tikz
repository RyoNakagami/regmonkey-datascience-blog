#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    reg/.style={draw=navy, fill=white, minimum width=2.6cm, minimum height=0.8cm},
    calc/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                 minimum width=4.2cm, minimum height=1.2cm, inner sep=5pt},
    addr/.style={draw=navy, fill=white, minimum width=1.4cm, minimum height=0.8cm},
    cell/.style={draw=navy, fill=aliceblue, minimum width=1.8cm, minimum height=0.8cm},
    hcell/.style={cell, fill=paleskyblue},
    head/.style={font=\footnotesize\bfseries, text=navy, anchor=south},
    sig/.style={font=\footnotesize, text=darkgray, align=left, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  % レジスタ
  \node[reg] (rdi) at (1.3,0) {1000};
  \node[head] at ([yshift=1mm]rdi.north) {ベースレジスタ（rdi）};
  \node[sig, anchor=north] at (rdi.south) {x：配列の先頭アドレス};

  \node[reg] (rax) at (1.3,-3.2) {2};
  \node[head] at ([yshift=1mm]rax.north) {インデックスレジスタ（rax）};
  \node[sig, anchor=north] at (rax.south) {i：先頭から何番目の要素か};

  % アドレスの計算
  \node[calc] (ea) at (6.8,-1.6) {rdi ＋ rax × 8\\＝ 1000 ＋ 2 × 8 ＝ 1016};
  \node[head] at ([yshift=1mm]ea.north) {読み出すアドレスの計算};
  \node[sig, anchor=north] at (ea.south) {8 は double 型 1 つの大きさ（バイト）};

  \draw[wire] (rdi.east) -- (3.7,0) |- ([yshift=2.5mm]ea.west);
  \draw[wire] (rax.east) -- (3.7,-3.2) |- ([yshift=-2.5mm]ea.west);

  % メインメモリ（配列 sales）
  \node[head] at (11.5,0.45) {アドレス};
  \node[head] at (13.1,0.45) {値};
  \foreach \a/\v/\s [count=\i from 0, evaluate=\i as \y using -0.8*\i] in {
      1000/120/cell, 1008/98/cell, 1016/143/hcell, 1024/110/cell, 1032/87/cell} {
    \node[addr] (m\i) at (11.5,\y) {\a};
    \node[\s] (v\i) at (13.1,\y) {\v};
    \node[sig, anchor=west] at ([xshift=1mm]v\i.east) {x[\i]};
  }
  \draw[wire] (ea.east) -- (m2.west);
\end{tikzpicture}
