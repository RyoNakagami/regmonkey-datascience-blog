#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    addr/.style={draw=navy, fill=white, minimum width=1.2cm, minimum height=0.8cm},
    cell/.style={draw=navy, fill=aliceblue, minimum height=0.8cm,
                 text width=5.0cm, align=left, inner xsep=8pt, anchor=west},
    jcell/.style={cell, fill=paleskyblue},
    mcell/.style={cell, text width=6.4cm},
    mjcell/.style={mcell, fill=paleskyblue},
    head/.style={font=\footnotesize\bfseries, text=navy, anchor=south},
    sig/.style={font=\footnotesize, text=darkgray, align=left, inner sep=2pt},
    num/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]
  \node[head] at (4.5,0.45) {呼び出し元（main 関数）};
  \node[head] at (13.4,0.45) {呼び出される関数（mean 関数）};

  % 呼び出し元
  \foreach \a/\t/\s [count=\i from 0, evaluate=\i as \y using -0.8*\i] in {
      0100/配列 sales に 5 日分の売上を格納せよ/mcell,
      0101/引数 x ← sales の先頭アドレス，n ← 5/mcell,
      0102/0200 番地の関数を呼び出せ（call）/mjcell,
      0103/戻り値を m に格納せよ/mcell,
      0104/m を表示せよ/mcell} {
    \node[addr] (a\i) at (0.6,\y) {\a};
    \node[\s] (r\i) at (1.2,\y) {\t};
  }

  % 呼び出される関数
  \foreach \a/\t/\s [count=\i from 0, evaluate=\i as \y using -0.8*\i] in {
      0200/sum に 0 を格納せよ/cell,
      0201/x の要素を順に sum に加算せよ/cell,
      0202/sum ÷ n を戻り値に格納せよ/cell,
      0203/呼び出し元に戻れ（ret）/jcell} {
    \node[addr] (b\i) at (10.3,\y) {\a};
    \node[\s] (f\i) at (10.9,\y) {\t};
  }

  % ① call と ② ret
  \draw[wire] (r2.east) -- (8.7,-1.6) |- (b0.west);
  \node[num] at (9.0,-0.4) {①};
  \draw[wire] (b3.west) -- (r3.east);
  \node[num] at (8.95,-2.15) {②};

  % 説明
  \node[sig, anchor=west] at (0,-4.3)
    {\textcolor{azureblue}{\textbf{①}} コール命令（call）：戻り先アドレス 0103 をスタックに保存し，PC ← 0200};
  \node[sig, anchor=west] at (0,-4.9)
    {\textcolor{azureblue}{\textbf{②}} リターン命令（ret）：スタックから戻り先アドレスを取り出し，PC ← 0103};

  % スタック
  \node[head] at (15.3,-4.35) {スタック（メインメモリ上）};
  \node[draw=navy, fill=aliceblue, minimum width=3.9cm, minimum height=0.7cm] (st) at (15.3,-4.8)
    {0103（戻り先アドレス）};
  \node[draw=navy, fill=white, minimum width=3.9cm, minimum height=0.7cm] at (15.3,-5.5) {…};
  \draw[wire] ([xshift=0.9cm]st.east) -- (st.east);
  \node[sig, anchor=west] at ([xshift=0.9cm]st.east) {スタック\\ポインタ};
\end{tikzpicture}
