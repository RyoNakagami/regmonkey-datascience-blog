#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    addr/.style={draw=navy, fill=white, minimum width=1.2cm, minimum height=0.8cm},
    cell/.style={draw=navy, fill=aliceblue, minimum height=0.8cm,
                 text width=8.4cm, align=left, inner xsep=8pt, anchor=west},
    jcell/.style={cell, fill=paleskyblue},
    head/.style={font=\footnotesize\bfseries, text=navy, anchor=south},
    sig/.style={font=\footnotesize, text=darkgray, align=left, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  \node[head] at (0.6,0.45) {アドレス};
  \node[head] at (5.8,0.45) {メモリの内容（命令）};

  \foreach \a/\t/\s [count=\i from 0, evaluate=\i as \y using -0.8*\i] in {
      0100/i に 0 を格納せよ/cell,
      0101/i と 5 を比較せよ（結果はフラグレジスタへ）/cell,
      0102/i ≥ 5 なら 0106 番地へジャンプせよ/jcell,
      0103/sum に sales[i] を加算せよ/cell,
      0104/i に 1 を加算せよ/cell,
      0105/0101 番地へジャンプせよ/jcell,
      0106/ループの後の処理（平均の計算など）/cell} {
    \node[addr] (a\i) at (0.6,\y) {\a};
    \node[\s] (r\i) at (1.2,\y) {\t};
  }

  % 先頭に戻る無条件ジャンプ（左側）
  \draw[wire] (a5.west) -- (-0.6,-4.0) |- (a1.west);
  \node[sig, anchor=east] at (-0.75,-2.4) {PC ← 0101\\（ループの先頭に戻る）};

  % ループを抜ける条件ジャンプ（右側）
  \draw[wire] (r2.east) -- ++(0.55,0) |- (r6.east);
  \node[sig, anchor=west] at ([xshift=0.7cm]r4.east) {i ≥ 5 のとき\\PC ← 0106\\（ループを抜ける）};

  % 凡例
  \node[draw=navy, fill=paleskyblue, minimum width=0.5cm, minimum height=0.32cm,
        anchor=west] (lg) at (1.2,-5.95) {};
  \node[sig, anchor=west] at (lg.east) {PC を書き換えるジャンプ命令};
\end{tikzpicture}
