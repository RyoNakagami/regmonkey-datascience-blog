#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    empty/.style={block, draw=lightgray, dashed, fill=white, text=darkgray},
    lane/.style={font=\bfseries, text=navy, anchor=east, align=right},
    head/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    link/.style={draw=navy},
  ]
  % ---- columns: x = 0, 3.6, 7.2, 10.8 / rows: y = 0 (HTTP), -2.2 (HTTPS) ----
  % TLS is part of the application layer in the TCP/IP model
  \foreach \x/\h in {1.8/アプリケーション層, 7.2/トランスポート層, 10.8/ネットワーク層}
    \node[head] at (\x,1.15) {\h};
  \draw[lightgray] (-1.3,0.85) -- (4.9,0.85);
  \draw[lightgray] (5.9,0.85) -- (8.5,0.85);
  \draw[lightgray] (9.5,0.85) -- (12.1,0.85);

  \node[block] (h1) at (0,0)    {HTTP};
  \node[empty] (h2) at (3.6,0)  {TLS なし};
  \node[block] (h3) at (7.2,0)  {TCP};
  \node[block] (h4) at (10.8,0) {IP};

  \node[block]  (s1) at (0,-2.2)    {HTTP};
  \node[accent] (s2) at (3.6,-2.2)  {TLS};
  \node[block]  (s3) at (7.2,-2.2)  {TCP};
  \node[block]  (s4) at (10.8,-2.2) {IP};

  \foreach \a/\b in {h1/h2, h2/h3, h3/h4, s1/s2, s2/s3, s3/s4}
    \draw[link] (\a.east) -- (\b.west);

  \node[lane] at (-1.9,0)    {HTTP};
  \node[lane] at (-1.9,-2.2) {HTTPS};

  \node[note, right=4mm of h4] {既定ポート\\80};
  \node[note, right=4mm of s4] {既定ポート\\443};
  \node[note, below=2mm of s2] {暗号化・改ざん検知・認証};
\end{tikzpicture}
