#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.2cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[accent] (root)  at (0,0)  {ルート CA 証明書};
  \node[block]  (inter) at (5,0)  {中間 CA 証明書};
  \node[block]  (srv)   at (10,0) {サーバー証明書};

  \node[note, below=2mm of root]  (nr) {OS / ブラウザに\\あらかじめ登録済み};
  \node[note, below=2mm of inter] (ni) {ルート CA が署名};
  \node[note, below=2mm of srv]   (ns) {中間 CA が署名};

  % issuing direction
  \draw[wire] (root) -- node[sig, above] {署名} (inter);
  \draw[wire] (inter) -- node[sig, above] {署名} (srv);

  % zones
  \begin{scope}[on background layer]
    \node[zone, fit=(root)(nr)] (zt) {};
    \node[zone, fit=(inter)(srv)(ni)(ns)(srv |- nr.south)] (zs) {};
  \end{scope}
  \node[zlabel] at (zt.north) {トラストストア};
  \node[zlabel] at (zs.north) {サーバーがハンドシェイクで送る};

  % verification direction
  \coordinate (vy) at (0,-2.6);
  \draw[->, draw=darkgray, dashed] (srv |- vy) -- (root |- vy);
  \node[sig, anchor=north] at (5,-2.7) {クライアントの検証：発行者の公開鍵で署名を確かめながら，ルート CA まで辿る};
\end{tikzpicture}
