#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    rowlabel/.style={font=\footnotesize, text=darkgray, anchor=east},
    val/.style={font=\footnotesize, text=darkgray, align=center, anchor=north},
  ]
  % 各フィールド: 左端x / 右端x / 名前 / バイト数
  % VER [0,1.6]  CMD [1.6,4.8]  RSV [4.8,6.4]  ATYP [6.4,9.0]  DST.ADDR [9.0,13.4]  DST.PORT [13.4,16.6]
  \foreach \l/\r/\name/\len/\id in {
      0/1.6/VER/1/ver,
      1.6/4.8/CMD/1/cmd,
      4.8/6.4/RSV/1/rsv,
      6.4/9.0/ATYP/1/atyp,
      9.0/13.4/DST.ADDR/可変長/addr,
      13.4/16.6/DST.PORT/2/port} {
    \draw[draw=navy, fill=aliceblue] (\l,0) rectangle (\r,0.9);
    \draw[draw=navy, fill=white] (\l,-0.6) rectangle (\r,0);
    \node[font=\small\bfseries, text=navy] (\id) at ({(\l+\r)/2},0.45) {\name};
    \node[font=\footnotesize] (\id-len) at ({(\l+\r)/2},-0.3) {\len};
  }
  \node[rowlabel] at (-0.2,0.45) {フィールド};
  \node[rowlabel] at (-0.2,-0.3) {バイト数};
  \node[rowlabel] at (-0.2,-1.07) {値};

  % 値の説明（表の下）
  \node[val] at (0.8,-0.85) {0x05};
  \node[val] at (3.2,-0.85) {0x01 CONNECT\\0x02 BIND\\0x03 UDP ASSOCIATE};
  \node[val] at (5.6,-0.85) {0x00};
  \node[val] at (7.7,-0.85) {0x01 IPv4\\0x03 ドメイン名\\0x04 IPv6};
  \node[val] at (11.2,-0.85) {IPv4：4バイト\\ドメイン名：長さ1バイト＋名前\\IPv6：16バイト};
  \node[val] at (15.0,-0.85) {接続先の\\ポート番号};

  % ATYP が DST.ADDR の形式を決める
  \draw[->, draw=azureblue] (7.7,0.9) to[out=60, in=120]
    node[midway, above, font=\footnotesize, text=azureblue] {ATYP が DST.ADDR の形式を決める} (11.2,0.9);
\end{tikzpicture}
