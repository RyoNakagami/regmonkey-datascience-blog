#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    card/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                 minimum width=3.5cm, minimum height=3.4cm, inner sep=4pt},
    letter/.style={font=\Huge\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    ex/.style={font=\footnotesize, text=azureblue, inner sep=2pt, align=center},
  ]
  \foreach \i/\L/\en/\ja/\q/\e in {
      0/S/Specific/具体的/何を・誰を対象に\\改善するか明確か/解約予測モデル,
      1/M/Measurable/測定可能/数値で達成を\\判定できるか/精度 X\%,
      2/A/Achievable/達成可能/データ・期間・体制で\\手が届く水準か/X はベースライン\\から現実的に設定,
      3/R/Relevant/関連性/ビジネス上の\\意思決定につながるか/解約抑止の\\プロモーションに活用,
      4/T/Time-bound/期限/いつまでに達成\\するか決まっているか/3か月の\\プロジェクト終了まで} {
    \node[card] (c\i) at ({\i*3.9},0) {};
    \node[letter] at ([yshift=-0.55cm]c\i.north) {\L};
    \node[font=\small\bfseries, text=navy, align=center] at ([yshift=-1.4cm]c\i.north) {\en\\{\footnotesize \ja}};
    \node[sig, text=fontblack] at ([yshift=0.6cm]c\i.south) {\q};
    \draw[draw=lightgray] ([xshift=0.3cm, yshift=1.3cm]c\i.south west) -- ([xshift=-0.3cm, yshift=1.3cm]c\i.south east);
    \node[ex, anchor=north] at ([yshift=-0.15cm]c\i.south) {\e};
  }
  \node[sig, anchor=east] at ([xshift=-0.2cm, yshift=-0.45cm]c0.south west) {例：};
\end{tikzpicture}
