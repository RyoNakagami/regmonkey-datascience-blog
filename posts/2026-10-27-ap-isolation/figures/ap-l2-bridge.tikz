#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    layer/.style={draw=navy, fill=aliceblue, align=center,
                  minimum height=0.9cm, minimum width=2.6cm, inner sep=3pt},
    half/.style={layer, minimum width=1.3cm, font=\footnotesize},
    hit/.style={layer, fill=paleskyblue},
    hithalf/.style={half, fill=paleskyblue},
    title/.style={font=\bfseries, text=navy},
    lname/.style={font=\footnotesize\bfseries, text=azureblue, anchor=east},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    path/.style={->, draw=azureblue, line width=1.4pt, rounded corners=4pt},
  ]
  % 層の y 座標
  \def\yL{2.0}  % L3
  \def\yM{1.0}  % L2
  \def\yS{0.0}  % L1

  % 端末
  \node[hit]   (t3) at (0,\yL) {IP};
  \node[hit]   (t2) at (0,\yM) {802.11 MAC};
  \node[hit]   (t1) at (0,\yS) {無線};
  \node[title, above=2mm of t3] {端末};

  % AP（L2 までしか持たない）
  \node[layer, draw=lightgray, fill=white, text=darkgray] (a3) at (5,\yL) {（IP は見ない）};
  \node[hithalf, anchor=east] (a2l) at (5,\yM) {};
  \node[hithalf, anchor=west] (a2r) at (5,\yM) {};
  \node[font=\footnotesize] at ($(a2l.center)+(0,-0.17)$) {802.11};
  \node[font=\footnotesize] at ($(a2r.center)+(0,-0.17)$) {802.3};
  \node[hithalf, anchor=east] (a1l) at (5,\yS) {無線};
  \node[hithalf, anchor=west] (a1r) at (5,\yS) {有線};
  \node[title, above=2mm of a3] {アクセスポイント};

  % ルーター
  \node[hit]   (r3) at (10.5,\yL) {IP};
  \node[hit]   (r2) at (10.5,\yM) {802.3 MAC};
  \node[hit]   (r1) at (10.5,\yS) {有線};
  \node[title, above=2mm of r3] {ルーター};

  % 層名
  \node[lname] at ($(t3.west)+(-0.2,0)$) {L3};
  \node[lname] at ($(t2.west)+(-0.2,0)$) {L2};
  \node[lname] at ($(t1.west)+(-0.2,0)$) {L1};

  % 通信経路：端末 L3 → L1 → AP は L2 で折り返し → ルーター L1 → L3
  \draw[path] ($(t3.center)+(0.95,0)$) -- ($(t1.south)+(0.95,-0.45)$)
    -- ($(a1l.south east)+(-0.14,-0.45)$) -- ($(a2l.east)+(-0.14,0.22)$) -- ($(a2r.west)+(0.14,0.22)$)
    -- ($(a1r.south west)+(0.14,-0.45)$) -- ($(r1.south)+(-0.95,-0.45)$)
    -- ($(r3.center)+(-0.95,0)$);

  \node[sig, anchor=north] at ($(t1.south)!0.5!(a1l.south)+(0,-0.5)$) {Wi-Fi};
  \node[sig, anchor=north] at ($(a1r.south)!0.5!(r1.south)+(0,-0.5)$) {Ethernet};

  % 補足
  \node[note, below=1.0cm of a1l.south east] {MAC アドレスで転送するだけ\\IP ヘッダは書き換えない};
  \node[note, below=1.0cm of r1] {IP ヘッダを見て経路を決める\\NAT・DHCP も L3 以上の機能};
\end{tikzpicture}
