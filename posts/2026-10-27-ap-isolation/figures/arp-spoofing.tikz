#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.0cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    bad/.style={font=\footnotesize, text=crimsonred, inner sep=2pt, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    wire/.style={->, draw=navy},
    atk/.style={->, draw=crimsonred, line width=1.1pt},
    old/.style={->, draw=lightgray, line width=1.1pt, densely dashed},
  ]
  \node[block] (vic) at (0,0) {利用者の端末\\{\footnotesize\color{darkgray}192.168.0.12}};
  \node[block] (gw) at (11,0) {ゲートウェイ\\{\footnotesize\color{darkgray}192.168.0.1}};
  \node[ng] (atk) at (5.5,-4.4) {攻撃者の端末\\{\footnotesize MAC = AA:AA}};

  % 本来の経路
  \draw[old] (vic.east) -- (gw.west) node[midway, above, sig, text=darkgray] {本来の経路（直接ゲートウェイへ）};

  % ① 偽 ARP 応答
  \draw[atk, dashed] ([xshift=-6mm]atk.north) -- ([xshift=6mm]vic.south)
    ;
  \draw[atk, dashed] ([xshift=6mm]atk.north) -- ([xshift=-6mm]gw.south)
    ;
  \node[bad] at (5.5,-1.5) {\textbf{① 偽 ARP 応答を送りつける}\\「192.168.0.1 は AA:AA」→ 利用者へ\\「192.168.0.12 は AA:AA」→ ゲートウェイへ};

  % ② 乗っ取られた経路
  \draw[wire, line width=1.1pt, rounded corners=6pt] ([xshift=-6mm]vic.south) |- (atk.west);
  \draw[wire, line width=1.1pt, rounded corners=6pt] (atk.east) -| ([xshift=6mm]gw.south);
  \node[sig, anchor=north] at (1.4,-4.5) {② 以後の通信は攻撃者を経由};
  \node[sig, anchor=north] at (9.6,-4.5) {攻撃者は中継しつつ\\盗聴・改ざんする};

  % ARP テーブル
  \node[note, anchor=south] at (vic.north) {ARP テーブル：192.168.0.1 → \textcolor{crimsonred}{AA:AA}};
  \node[note, anchor=south] at (gw.north) {ARP テーブル：192.168.0.12 → \textcolor{crimsonred}{AA:AA}};
\end{tikzpicture}
