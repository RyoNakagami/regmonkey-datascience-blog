#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.0cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    bad/.style={font=\footnotesize, text=crimsonred, inner sep=2pt, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    wire/.style={->, draw=navy},
    atk/.style={->, draw=crimsonred, line width=1.1pt},
    old/.style={->, draw=lightgray, line width=1.1pt, densely dashed},
  ]
  % 攻撃者
  \node[ng] (atk) at (0,-1.6) {攻撃者の端末};

  % 利用者の端末とサービス
  \node[block, minimum width=4.8cm, minimum height=0.75cm] (smb) at (8,0) {SMB 共有（445）};
  \node[block, minimum width=4.8cm, minimum height=0.75cm] (rdp) at (8,-1.05) {リモートデスクトップ（3389）};
  \node[block, minimum width=4.8cm, minimum height=0.75cm] (ssh) at (8,-2.1) {SSH（22）};
  \node[block, minimum width=4.8cm, minimum height=0.75cm] (dev) at (8,-3.15) {開発用サーバー（8000 等）};
  \begin{scope}[on background layer]
    \node[draw=navy, fill=white, rounded corners=6pt, inner sep=8pt, fit=(smb)(dev)] (vic) {};
  \end{scope}
  \node[font=\bfseries, text=navy, anchor=south] at (vic.north) {利用者の端末};

  % 他の端末
  \node[block] (oth) at (14.6,-1.6) {同じ LAN の\\別の端末};

  % 攻撃
  \draw[atk] ([yshift=3mm]atk.east) -- ([yshift=3mm]atk.east -| vic.west)
    node[midway, above, bad] {① ポートスキャン};
  \draw[atk] ([yshift=-3mm]atk.east) -- ([yshift=-3mm]atk.east -| vic.west)
    node[midway, below, bad] {② 開いているサービスに\\ログイン・脆弱性を悪用};

  % ワーム
  \draw[atk, dashed] (vic.east |- oth) -- (oth.west)
    node[midway, above, bad] {③ ワームは}
    node[midway, below, bad] {次の端末へ};

  \node[sig, anchor=north] at ([yshift=-2mm]vic.south) {開いているポート＝外から届く入口};
\end{tikzpicture}
