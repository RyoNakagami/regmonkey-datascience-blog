#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.8cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    card/.style={block, fill=white},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    bad/.style={font=\footnotesize, text=crimsonred, align=center, inner sep=2pt},
    step/.style={text=azureblue},
    wire/.style={->, draw=navy},
    attack/.style={->, draw=crimsonred, line width=1.1pt},
    poison/.style={->, draw=crimsonred, densely dashed},
    ghost/.style={->, draw=darkgray, densely dashed},
    life/.style={draw=lightgray, line width=1pt},
  ]
  % ③ 偽 DHCP / IPv6 ルータ広告の注入（シーケンス図）
  \node[block] (vic) at (0,0)  {被害者の端末};
  \node[ng]    (atk) at (6.5,0)  {攻撃者の端末};
  \node[block] (rt)  at (13,0) {正規のルータ\\（DHCPサーバ）};
  \foreach \n in {vic, atk, rt} { \draw[life] (\n.south) -- (\n |- 0,-7.2); }

  % 1. DHCP Discover（ブロードキャスト）
  \draw[wire] (0,-1.4) -- (13,-1.4)
    node[pos=0.25, above, sig] {\textcolor{azureblue}{①} DHCP Discover（ブロードキャスト）}
    ;
  \node[sig, anchor=north west] at (6.6,-1.45) {攻撃者にも届く};
  \fill[navy] (6.5,-1.4) circle (2.2pt);

  % 2. 偽の Offer
  \draw[attack] (6.5,-2.6) -- (0,-2.6)
    node[midway, above, bad] {\textcolor{azureblue}{②} 先に偽の応答：GW＝攻撃者，DNS＝攻撃者};

  % 3. 正規の Offer（遅れて無視される）
  \draw[ghost] (13,-3.8) -- (0,-3.8)
    node[pos=0.25, above, sig] {正規の応答（後着のため使われない）};

  % 4. IPv6 RA
  \draw[attack] (6.5,-5.0) -- (0,-5.0)
    node[midway, above, bad] {\textcolor{azureblue}{③} 偽の IPv6 RA：経路・DNS＝攻撃者};

  % 5. 以降の通信
  \draw[attack] (0,-6.4) -- (6.5,-6.4)
    node[midway, above, bad] {\textcolor{azureblue}{④} 名前解決・通信が攻撃者経由に};
  \draw[ghost] (6.5,-6.4) -- (13,-6.4)
    node[midway, above, sig] {攻撃者が中継・改ざん};

  \node[note, anchor=north] at (6.5,-7.4)
    {※ IPv4 だけの網でも端末側は IPv6 が有効なので，RA を受け入れて IPv6 経路を優先してしまう};
\end{tikzpicture}
