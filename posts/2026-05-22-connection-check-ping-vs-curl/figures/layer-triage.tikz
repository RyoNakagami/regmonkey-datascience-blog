#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.4cm, minimum width=4.2cm, inner sep=6pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, align=left, minimum height=1.9cm},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize\bfseries, inner sep=3pt},
    wire/.style={->, draw=navy},
    ngwire/.style={->, draw=crimsonred},
  ]
  \node[block] (l3) {\textbf{ホストに届くか}\\[2pt]{\footnotesize\texttt{ping <host>}}};
  \node[block, right=2.4cm of l3] (l7) {\textbf{アプリが応答するか}\\[2pt]{\footnotesize\texttt{curl http://<host>:<port>}}};
  \node[accent, right=2.4cm of l7, minimum width=3.2cm] (ok) {\textbf{正常}};

  \node[step, above=2mm of l3] {Step 1：L3（IP / ICMP）};
  \node[step, above=2mm of l7] {Step 2：L7（HTTP / HTTPS）};

  \node[ng, below=1.6cm of l3] (ng3) {\textbf{\textcolor{crimsonred}{NW 側の問題}}\\[3pt]
    ・IP ルーティング\\ ・ファイアウォール\\ ・NW 障害};
  \node[ng, below=1.6cm of l7] (ng7) {\textbf{\textcolor{crimsonred}{サーバー側の問題}}\\[3pt]
    ・サーバープロセスのダウン\\ ・ポート閉塞\\ ・アプリエラー};

  \draw[wire] (l3) -- node[sig, above, text=navy] {OK} (l7);
  \draw[wire] (l7) -- node[sig, above, text=navy] {OK} (ok);
  \draw[ngwire] (l3) -- node[sig, right, text=crimsonred] {NG} (ng3);
  \draw[ngwire] (l7) -- node[sig, right, text=crimsonred] {NG} (ng7);
\end{tikzpicture}
