#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    hand/.style={draw=navy, fill=aliceblue, circle, minimum size=1.9cm,
                 align=center, inner sep=1pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    wire/.style={->, draw=navy},
    back/.style={->, draw=azureblue, densely dashed},
  ]

  % ---------- 左：3つの手の関係 ----------
  \node[hand] (g) at (90:2.3)  {グー\\\texttt{0}};
  \node[hand] (c) at (330:2.3) {チョキ\\\texttt{1}};
  \node[hand] (p) at (210:2.3) {パー\\\texttt{2}};

  % 勝つ向き：x は x+1 に勝つ
  \draw[wire] (g) to[bend left=18] node[sig, sloped, above] {勝つ} (c);
  \draw[wire] (c) to[bend left=18] node[sig, sloped, below] {勝つ} (p);
  \draw[wire] (p) to[bend left=18] node[sig, sloped, above] {勝つ} (g);

  \node[step, anchor=south] at ($(g.north)+(0,0.15)$) {\texttt{x} は \texttt{(x + 1) \% 3} に勝つ};
  \node[note, anchor=north, align=center] at ($(c.south)!0.5!(p.south)+(0,-0.35)$)
       {\texttt{x} に勝つ手は1つ戻った \texttt{x - 1}．\\
        \texttt{\%} で負の数を避けるため \texttt{x + 2} と書く};

  % ---------- 右：予測から出す手 ----------
  % 列の x 位置（中心）と行の y 位置
  \def\xa{5.6}\def\xb{8.0}\def\xc{11.0}
  \node[font=\small] (t0a) at (\xa,1.4) {予測 \texttt{max}};
  \node[font=\small] at (\xb,1.4) {\texttt{(max + 2) \% 3}};
  \node[font=\small] (t0c) at (\xc,1.4) {コンピュータの手};
  \foreach \i/\m/\h/\v/\k in {1/0/グー/2/パー, 2/1/チョキ/0/グー, 3/2/パー/1/チョキ} {
    \node[font=\small] at (\xa,1.4-\i*0.62) {\texttt{\m} \h};
    \node[font=\small] at (\xb,1.4-\i*0.62) {\texttt{\v}};
    \node[font=\small, text=navy] at (\xc,1.4-\i*0.62) {\textbf{\k}};
  }
  \draw[draw=navy] (4.4,1.05) -- (12.3,1.05);
  \draw[draw=lightgray] (6.8,1.7) -- (6.8,-0.75);
  \draw[draw=lightgray] (9.5,1.7) -- (9.5,-0.75);
  \coordinate (tblnw) at (4.4,1.75);
  \coordinate (tblsw) at (4.4,-0.8);
  \node[step, anchor=south west] at ($(tblnw)+(0,0.1)$)
       {人間が出しそうな手 → それに勝つ手};
  \node[note, anchor=north west] at ($(tblsw)+(0,-0.25)$)
       {勝敗の判定も同じ考え方：\texttt{(human - computer + 3) \% 3}\\
        \texttt{0} あいこ，\texttt{1} 人間の負け，\texttt{2} 人間の勝ち};
\end{tikzpicture}
