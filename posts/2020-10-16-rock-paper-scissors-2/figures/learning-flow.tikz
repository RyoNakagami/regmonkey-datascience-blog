#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.2cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    term/.style={draw=navy, fill=white, rounded corners=0.55cm,
                 align=center, minimum height=1.1cm, minimum width=1.8cm},
    decision/.style={draw=navy, fill=white, diamond, aspect=2,
                     align=center, inner sep=1pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]

  % ---------- 1段目（左→右）：準備・入力・終了判定・回数 ----------
  \node[term] (start) at (0,0) {開始};
  \node[block] (init) at (3.4,0) {初期化\\\texttt{memory}，\texttt{prev}，\texttt{counter}};
  \node[block] (input) at (7.6,0) {\texttt{scanf}\\人間の手 \texttt{human}};
  \node[decision] (d1) at (11.6,0) {\texttt{human} が\\0〜2?};
  \node[block] (cnt) at (16.2,0) {\texttt{counter++}\\回数を数える};
  \node[term, above=0.9cm of d1] (end) {終了};

  \node[note, below=2mm of init] {\texttt{srand(time(NULL))} もここ};
  \node[step, above=2mm of input] {① 人間が手を出す};

  \draw[wire] (start) -- (init);
  \draw[wire] (init) -- (input);
  \draw[wire] (input) -- (d1);
  \draw[wire] (d1) -- node[sig, above] {Yes} (cnt);
  \draw[wire] (d1) -- node[sig, right] {No} (end);

  % ---------- 2段目（右→左）：手を決める・表示・記憶 ----------
  \node[decision] (d2) at (16.2,-3.9) {\texttt{counter}\\\texttt{< 10}?};
  \node[block] (rnd) at (12.0,-2.9) {\texttt{rand() \% 3}\\でたらめに出す};
  \node[accent] (pred) at (12.0,-4.9) {\texttt{memory[prev]} の\\最大の列を予測};
  \node[block] (show) at (7.6,-3.9) {\texttt{printf}\\コンピュータの手};
  \node[accent] (upd) at (3.4,-3.9) {\texttt{memory[prev][human]++}\\\texttt{prev = human}};

  \node[step, above=2mm of rnd] {② コンピュータが手を決める};
  \node[note, below=2mm of pred] {勝てる手 \texttt{(max + 2) \% 3} を出す};
  \node[step, below=2mm of upd] {③ 人間の手を記憶する};

  \draw[wire] (cnt) -- (d2);
  \draw[wire] (d2.west) -- ++(-0.5,0) |- node[sig, pos=0.25, left] {Yes} (rnd.east);
  \draw[wire] (d2.west) -- ++(-0.5,0) |- node[sig, pos=0.25, left] {No} (pred.east);
  \draw[draw=navy] (rnd.west) -- ++(-0.4,0) coordinate (m1);
  \draw[draw=navy] (pred.west) -- ++(-0.4,0) coordinate (m2);
  \draw[draw=navy] (m1) -- (m2);
  \draw[wire] (m1 |- show) -- (show);
  \draw[wire] (show) -- (upd);

  % ---------- 次の回へ ----------
  \draw[wire] (upd.north) -- ++(0,1.5) coordinate (back) -| ($(input.south)+(-0.8,0)$);
  \node[sig, anchor=south] at ($(back)+(2.1,0)$) {次の回へ（\texttt{while} ループ）};
\end{tikzpicture}
