#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    head/.style={font=\footnotesize\bfseries, text=navy, align=center},
    seg/.style={draw=navy, fill=aliceblue},
    segsel/.style={draw=navy, fill=paleskyblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[anchor=west, font=\small\bfseries, text=navy] at (-0.6,2.1)
       {行 \texttt{\{4, 0, 6\}}，$\eta = 0.1$ のとき};

  % ---------- 上段：score と重み ----------
  \node[head] at (0.4,1.3) {手 \texttt{a}};
  \node[head] at (2.9,1.3) {\texttt{score[a]}\\勝ち − 負け};
  \node[head] at (6.6,1.3) {\texttt{w[a]}\\\texttt{exp(η * (score[a] - top))}};
  \node[head] at (10.0,1.3) {出す確率\\\texttt{w[a] / total}};
  \foreach \i/\h/\s/\w/\p in {0/グー/$0 - 6 = -6$/$e^{-1.0} = 0.37$/17\%,
                              1/チョキ/$6 - 4 = +2$/$e^{-0.2} = 0.82$/37\%,
                              2/パー/$4 - 0 = +4$/$e^{0} = 1.00$/46\%} {
    \pgfmathsetmacro{\y}{0.35-\i*0.6}
    \node at (0.4,\y) {\h};
    \node at (2.9,\y) {\s};
    \node at (6.6,\y) {\w};
    \node at (10.0,\y) {\p};
  }
  \draw[draw=navy] (-0.6,0.72) -- (12.2,0.72);
  \node[note, anchor=west] at (-0.6,-1.45)
       {\texttt{top} = 4（\texttt{score} の最大値）．引いても確率は変わらず，\texttt{exp} のあふれを防げる};

  % ---------- 下段：u で区間を選ぶ ----------
  % 長さ 4.5cm = 重み 1
  \def\s{4.5}
  \def\y{-3.65}
  \draw[seg]    (0,\y) rectangle ++(0.37*\s,0.6);
  \draw[segsel] (0.37*\s,\y) rectangle ++(0.82*\s,0.6);
  \draw[seg]    (1.19*\s,\y) rectangle ++(1.00*\s,0.6);
  \node at (0.185*\s,\y+0.3) {グー};
  \node at (0.78*\s,\y+0.3) {チョキ};
  \node at (1.69*\s,\y+0.3) {パー};
  \foreach \x/\t in {0/0, 0.37/0.37, 1.19/1.19, 2.19/\texttt{total} = 2.19} {
    \node[note, anchor=north] at (\x*\s,\y-0.05) {\t};
  }
  % u の例
  \draw[wire, draw=azureblue] (1.0*\s,\y+1.05) -- (1.0*\s,\y+0.62);
  \node[step, anchor=south] at (1.0*\s,\y+1.05) {\texttt{u = uniform01() * total}（例：1.0）};

  \node[note, anchor=north west, align=left] at (2.35*\s,\y+0.6)
       {\texttt{u < w[0]}？ → No，\texttt{u -= w[0]}（0.63）\\
        \texttt{u < w[1]}？ → Yes → チョキを返す};
\end{tikzpicture}
