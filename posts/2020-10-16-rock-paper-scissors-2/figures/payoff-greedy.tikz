#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    win/.style={draw=navy, fill=paleskyblue},
    lose/.style={draw=navy, fill=white},
    head/.style={font=\footnotesize\bfseries, text=navy, align=center},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
  ]
  % 1 回 = 0.045cm（60 回 = 2.7cm）
  \def\u{0.045}

  \node[anchor=west, font=\small\bfseries, text=navy] at (-5.6,2.45)
       {行 \texttt{\{40, 0, 60\}}（人間：グー 40 回，チョキ 0 回，パー 60 回）のとき};

  \node[head] at (-1.35,1.35) {← 負ける回数};
  \node[head] at (1.35,1.35) {勝つ回数 →};
  \node[head] at (5.3,1.35) {\texttt{score}\\勝ち − 負け};
  \node[head] at (6.9,1.35) {本文の\\ルール};
  \node[head] at (8.7,1.35) {A. 期待利得\\の貪欲法};

  \foreach \i/\h/\w/\l/\s/\wh/\lh in {
      0/グー/0/60/$-60$/チョキに 0/パーに 60,
      1/チョキ/60/40/$+20$/パーに 60/グーに 40,
      2/パー/40/0/$+40$/グーに 40/チョキに 0} {
    \pgfmathsetmacro{\y}{0.5-\i*1.05}
    \node[anchor=east, font=\small] at (-4.3,\y) {\h};
    \ifnum\w>0 \draw[win] (0,\y-0.22) rectangle ++(\w*\u,0.44); \fi
    \ifnum\l>0 \draw[lose] (0,\y-0.22) rectangle ++(-\l*\u,0.44); \fi
    \node[note, anchor=west] at (\w*\u+0.08,\y) {\wh};
    \node[note, anchor=east] at (-\l*\u-0.08,\y) {\lh};
    \node[font=\small] at (5.3,\y) {\s};
  }
  \draw[draw=navy] (0,0.9) -- (0,-2.0);
  \node[head, anchor=east] at (-4.3,1.35) {コンピュータの手};

  % 選ぶ手
  \node[step] at (6.9,0.5-1*1.05) {選ぶ};
  \node[step] at (8.7,0.5-2*1.05) {選ぶ};
  \node[note, anchor=north] at (6.9,-1.85) {勝つ回数\\が最大};
  \node[note, anchor=north] at (8.7,-1.85) {\texttt{score}\\が最大};

  \draw[draw=lightgray] (4.5,1.9) -- (4.5,-2.6);
  \draw[draw=lightgray] (6.1,1.9) -- (6.1,-2.6);
\end{tikzpicture}
