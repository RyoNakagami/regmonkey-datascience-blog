#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\newcommand{\art}[1]{{\scriptsize\color{darkgray}#1}}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    penalty/.style={draw=navy, fill=paleskyblue, rounded corners=3pt, align=center,
                    minimum width=5.4cm, minimum height=1.6cm, inner sep=5pt, anchor=north},
    act/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                font=\footnotesize, minimum width=5.4cm, minimum height=1.05cm,
                inner sep=4pt, anchor=north},
    head/.style={font=\bfseries, text=navy, anchor=south},
    note/.style={font=\footnotesize, text=darkgray, align=center, anchor=north},
  ]
  \def\xa{0}
  \def\xb{6.1}
  \def\xc{12.2}
  \def\gap{1.25}

  % 罰則（列の見出し）
  \node[penalty] (pa) at (\xa,0) {\textbf{3年以下の拘禁刑}\\または\\\textbf{100万円以下の罰金}};
  \node[penalty] (pb) at (\xb,0) {\textbf{1年以下の拘禁刑}\\または\\\textbf{50万円以下の罰金}};
  \node[penalty] (pc) at (\xc,0) {\textbf{30万円以下の罰金}};

  \node[head] at ([yshift=2mm]pa.north) {不正アクセス行為};
  \node[head] at ([yshift=2mm]pb.north) {不正アクセスの準備行為など};
  \node[head] at ([yshift=2mm]pc.north) {不正アクセスの助長};

  % 不正アクセス行為（第2条第4項の3類型）
  \node[act] (a1) at (\xa,-2.0)        {① 他人のID・パスワードで\\制限された機能を使う};
  \node[act] (a2) at (\xa,-2.0-\gap)   {② セキュリティホールを突いて\\制限された機能を使う};
  \node[act] (a3) at (\xa,-2.0-2*\gap) {③ 認証サーバで守られた\\コンピュータに不正な手段で入る};
  \node[note] at ([yshift=-2mm]a3.south) {第3条（罰則は第11条）};

  % 準備行為など
  \node[act] (b1) at (\xb,-2.0)        {他人のID・パスワードを不正に取得する\\\art{第4条}};
  \node[act] (b2) at (\xb,-2.0-\gap)   {不正アクセスに使うと知りながら\\他人のID・パスワードを提供する \art{第5条}};
  \node[act] (b3) at (\xb,-2.0-2*\gap) {不正に取得されたID・パスワードを\\保管する \art{第6条}};
  \node[act] (b4) at (\xb,-2.0-3*\gap) {偽サイトなどでID・パスワードの\\入力を求める（フィッシング）\art{第7条}};
  \node[note] at ([yshift=-2mm]b4.south) {罰則は第12条};

  % 助長
  \node[act] (c1) at (\xc,-2.0)        {正当な理由なく他人のID・パスワードを\\第三者に教える \art{第5条}};
  \node[note] at ([yshift=-2mm]c1.south) {例：掲示板にIDとパスワードを書き込む\\相手の目的を知らなくても処罰される\\（罰則は第13条）};

  % 罰則の重さ
  \draw[<->, >=Latex, draw=darkgray] (\xa-2.7,1.3) -- (\xc+2.7,1.3);
  \node[note, anchor=south west] at (\xa-2.7,1.35) {罰則が重い};
  \node[note, anchor=south east] at (\xc+2.7,1.35) {罰則が軽い};
\end{tikzpicture}
