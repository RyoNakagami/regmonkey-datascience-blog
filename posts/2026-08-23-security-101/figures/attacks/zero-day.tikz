#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.2cm, inner sep=5pt},
    attacker/.style={block, draw=crimsonred, fill=mistyrose},
    title/.style={font=\large\bfseries, text=navy, anchor=west},
    subtitle/.style={font=\footnotesize, text=darkgray, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    step/.style={font=\footnotesize, text=fontblack, align=left, inner sep=2pt},
    num/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
    atk/.style={->, draw=crimsonred},
    data/.style={draw=lightgray, fill=white, rounded corners=2pt, font=\footnotesize\ttfamily,
                 align=left, inner sep=4pt},
    measure/.style={font=\footnotesize, text=fontblack, anchor=west},
  ]
  % タイトル
  \node[title] at (0,4.2) {ゼロデイ攻撃};
  \node[subtitle] at (0,3.6) {脆弱性の発見から修正プログラムが行き渡るまでの「無防備な期間」を突く};

  % 無防備な期間
  \fill[mistyrose] (2.0,0.4) rectangle (12.4,1.6);
  \draw[crimsonred, dashed] (2.0,0.4) rectangle (12.4,1.6);
  \node[font=\footnotesize\bfseries, text=crimsonred] at (6.7,0.65) {パッチなし（猶予0日）};
  \node[font=\footnotesize, text=crimsonred] at (10.6,0.65) {パッチ未適用};
  \draw[crimsonred] (8.8,0.4) -- (8.8,1.6);

  % 時間軸
  \draw[wire] (0.3,1.0) -- (14.8,1.0);
  \node[note, anchor=north east] at (14.8,0.9) {時間};

  % イベント
  \foreach \x/\n/\t in {2.0/①/脆弱性の発見, 4.6/②/攻撃開始, 8.8/③/パッチ公開, 12.4/④/パッチ適用} {
    \fill[navy] (\x,1.0) circle (0.09);
  }
  \node[step, anchor=south] at (2.0,1.75) {\textcolor{azureblue}{\textbf{①}} 脆弱性の発見};
  \node[step, anchor=south] at (4.6,1.75) {\textcolor{azureblue}{\textbf{②}} 攻撃開始};
  \node[step, anchor=south] at (8.8,1.75) {\textcolor{azureblue}{\textbf{③}} パッチ公開};
  \node[step, anchor=south] at (12.4,1.75) {\textcolor{azureblue}{\textbf{④}} パッチ適用};

  % 攻撃
  \node[attacker, minimum width=2.4cm, minimum height=0.9cm] (atk) at (4.6,-0.6) {攻撃者};
  \draw[atk] (atk.north) -- (4.6,0.88);
  \node[note, right=3mm of atk, align=left] {ベンダーより先に脆弱性を知り，\\修正方法がない状態で攻撃};

  % 期間ラベル
  \draw[darkgray, |-|] (2.0,-1.45) -- (12.4,-1.45);
  \node[note, fill=white] at (10.6,-1.45) {無防備な期間};

  % 対策
  \draw[lightgray] (0,-2.0) -- (15,-2.0);
  \node[measure] at (0,-2.5) {\textcolor{navy}{\textbf{対策}}\quad IPS・WAFによる振る舞い検知（仮想パッチ）／EDRによる端末監視／多層防御と権限の最小化};
\end{tikzpicture}
