#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=2.6cm, inner sep=5pt},
    attacker/.style={block, draw=crimsonred, fill=mistyrose},
    bot/.style={attacker, minimum height=0.7cm, minimum width=2.2cm},
    title/.style={font=\large\bfseries, text=navy, anchor=west},
    subtitle/.style={font=\footnotesize, text=darkgray, anchor=west},
    head/.style={font=\bfseries, text=navy, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=crimsonred, inner sep=2pt},
    atk/.style={->, draw=crimsonred},
    measure/.style={font=\footnotesize, text=fontblack, anchor=west},
  ]
  % タイトル
  \node[title] at (0,5.3) {DoS／DDoS攻撃};
  \node[subtitle] at (0,4.7) {処理能力を超える要求を送りつけ，正規の利用者がサービスを使えない状態にする（可用性の侵害）};

  % ===== 左：DoS =====
  \node[head] at (0,3.9) {DoS攻撃 \textcolor{darkgray}{\footnotesize（Denial of Service）}};
  \node[attacker] (atk1) at (1.3,1.5) {攻撃者\\\footnotesize 1台};
  \node[block] (srv1) at (6.0,1.5) {標的サーバー};
  \draw[atk, line width=2.2pt] (atk1.east) -- (srv1.west)
    node[midway, above=1mm, sig] {大量の要求};
  \node[note, below=2mm of atk1] {\textcolor{azureblue}{\textbf{①}} 1台から\\要求を送り続ける};
  \node[note, below=2mm of srv1] {\textcolor{azureblue}{\textbf{②}} 処理能力があふれ\\サービス停止};
  \node[note, text=crimsonred, anchor=north] at (3.65,-0.8) {送信元が1つなので，そのIPを遮断すれば止めやすい};

  % 区切り線
  \draw[lightgray] (8.0,4.1) -- (8.0,-1.3);

  % ===== 右：DDoS =====
  \node[head] at (8.5,3.9) {DDoS攻撃 \textcolor{darkgray}{\footnotesize（Distributed DoS）}};
  \node[attacker] (atk2) at (9.8,1.5) {攻撃者\\\footnotesize 指令役};
  \node[bot] (b1) at (13.2,2.7) {ボット};
  \node[bot] (b2) at (13.2,1.5) {ボット};
  \node[bot] (b3) at (13.2,0.3) {ボット};
  \node[block] (srv2) at (17.0,1.5) {標的サーバー};

  \foreach \b in {b1, b2, b3} {
    \draw[atk, dashed] (atk2.east) -- (\b.west);
    \draw[atk, line width=2.2pt] (\b.east) -- (srv2.west);
  }
  \node[sig, text=darkgray, above=1mm of b1] {マルウェア感染PC（ボットネット）};
  \node[sig, anchor=south] at (11.45,2.25) {指令};

  \node[note, below=2mm of atk2] {\textcolor{azureblue}{\textbf{①}} 乗っ取った\\多数の端末に指令};
  \node[note, below=2mm of b3] {\textcolor{azureblue}{\textbf{②}} 一斉に要求を送る};
  \node[note, below=2mm of srv2] {\textcolor{azureblue}{\textbf{③}} 処理能力があふれ\\サービス停止};
  \node[note, text=crimsonred, anchor=north] at (13.4,-0.8) {送信元が分散しているので，IPの遮断だけでは防ぎにくい};

  % 対策
  \draw[lightgray] (0,-1.7) -- (18.4,-1.7);
  \node[measure] at (0,-2.2) {\textcolor{navy}{\textbf{対策}}\quad 送信元ごとの流量制限（レート制限）／IPS・WAFによる異常通信の遮断／CDN・DDoS対策サービスで通信を分散・吸収};
\end{tikzpicture}
