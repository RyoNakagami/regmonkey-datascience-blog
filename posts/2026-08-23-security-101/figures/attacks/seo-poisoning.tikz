#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.2cm, inner sep=5pt},
    attacker/.style={block, draw=crimsonred, fill=mistyrose},
    title/.style={font=\large\bfseries, text=navy, anchor=west},
    subtitle/.style={font=\footnotesize, text=darkgray, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    step/.style={font=\footnotesize, text=fontblack, align=left, inner sep=2pt},
    num/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
    atk/.style={->, draw=crimsonred},
    data/.style={draw=lightgray, fill=white, rounded corners=2pt, font=\footnotesize\ttfamily,
                 align=left, inner sep=4pt},
    measure/.style={font=\footnotesize, text=fontblack, anchor=west},
  ]
  % タイトル
  \node[title] at (0,4.2) {SEOポイズニング};
  \node[subtitle] at (0,3.6) {SEOの手法を悪用して悪意のあるサイトを検索上位に表示させ，訪問者を誘導する};

  % 登場人物
  \node[attacker] (site) at (1.6,1.3) {悪意のあるサイト};
  \node[block] (se) at (7.6,1.3) {検索エンジン};
  \node[block] (usr) at (13.4,1.3) {利用者};
  \node[note, below=2mm of site] {攻撃者が用意した\\偽サイト・配布サイト};
  \node[note, below=2mm of usr] {上位の結果を\\信用してクリック};

  % ① 上位表示
  \draw[atk] (site.east) -- (se.west)
    node[midway, above=4pt, step] {\textcolor{azureblue}{\textbf{①}} SEOで上位表示};
  % ② 検索
  \draw[wire] ([yshift=0.25cm]usr.west) -- ([yshift=0.25cm]se.east)
    node[midway, above=4pt, step] {\textcolor{azureblue}{\textbf{②}} 「無料 ソフト」};
  % ③ 検索結果
  \draw[atk] ([yshift=-0.25cm]se.east) -- ([yshift=-0.25cm]usr.west)
    node[midway, below=4pt, step] {\textcolor{azureblue}{\textbf{③}} 上位に偽サイト};
  % ④ 誘導
  \draw[atk] (usr.north) -- ++(0,0.8) -| (site.north)
    node[pos=0.25, above=2pt, step] {\textcolor{azureblue}{\textbf{④}} クリックして訪問 → マルウェアをダウンロード};

  % 検索結果の例
  \node[data, anchor=north] (res) at (7.6,-0.3)
    {1. \textcolor{crimsonred}{無料ソフト公式DL - free-soft.xyz}\\2. 無料ソフト - 公式サイト\\3. 使い方まとめ};
  \node[note, anchor=south] at (res.north) {③ の検索結果};

  % 対策
  \draw[lightgray] (0,-2.0) -- (15,-2.0);
  \node[measure] at (0,-2.5) {\textcolor{navy}{\textbf{対策}}\quad URL（ドメイン）が公式のものか確認する／ソフトは公式サイトから入手／OSやブラウザの更新};
\end{tikzpicture}
