#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.2cm, inner sep=5pt},
    attacker/.style={block, draw=crimsonred, fill=mistyrose},
    title/.style={font=\large\bfseries, text=navy, anchor=west},
    subtitle/.style={font=\footnotesize, text=darkgray, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    step/.style={font=\footnotesize, text=fontblack, align=left, inner sep=2pt},
    num/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
    atk/.style={->, draw=crimsonred},
    data/.style={draw=lightgray, fill=white, rounded corners=2pt, font=\footnotesize\ttfamily,
                 align=left, inner sep=4pt},
    measure/.style={font=\footnotesize, text=fontblack, anchor=west},
  ]
  % タイトル
  \node[title] at (0,4.2) {辞書攻撃};
  \node[subtitle] at (0,3.6) {辞書の単語やよく使われるパスワードの一覧を順に試し，推測しやすいパスワードを破る};

  % 登場人物
  \node[block, shape=cylinder, shape border rotate=90, aspect=0.25, minimum width=2.6cm, minimum height=1.0cm] (dict) at (1.6,1.3) {パスワード辞書};
  \node[attacker] (atk) at (7.3,1.3) {攻撃者};
  \node[block] (tgt) at (13.3,1.3) {ログイン画面};
  \node[note, below=2mm of dict] {定番のPW・辞書の単語};
  \node[note, below=2mm of tgt] {ID：taro};

  % ① 読み込み
  \draw[atk] (dict.east) -- (atk.west)
    node[midway, above=4pt, step] {\textcolor{azureblue}{\textbf{①}} 候補を読む};
  % ② 試行
  \draw[atk] ([yshift=0.25cm]atk.east) -- ([yshift=0.25cm]tgt.west)
    node[midway, above=4pt, step] {\textcolor{azureblue}{\textbf{②}} 順に試行};
  % ③ 成功
  \draw[atk] ([yshift=-0.25cm]tgt.west) -- ([yshift=-0.25cm]atk.east)
    node[midway, below=4pt, step] {\textcolor{azureblue}{\textbf{③}} 一致で突破};

  % 試行の例
  \node[data, anchor=north] (try) at (10.3,-0.75)
    {password \textcolor{crimsonred}{×}\quad 123456 \textcolor{crimsonred}{×}\quad qwerty \textcolor{crimsonred}{×}\quad \textcolor{navy}{\textbf{dragon ✓}}};
  \node[note, anchor=south] at (try.north) {② の試行の例};
  \node[note, anchor=north west, align=left] (cmp) at (0,-0.6)
    {総当たり（英小文字8桁）：$26^8 \approx$ 2000億通り\\辞書攻撃：数千〜数万通りで済む};

  % 対策
  \draw[lightgray] (0,-2.0) -- (15,-2.0);
  \node[measure] at (0,-2.5) {\textcolor{navy}{\textbf{対策}}\quad 辞書に載る単語や定番のパスワードを使わない／ログイン試行回数の制限／多要素認証};
\end{tikzpicture}
