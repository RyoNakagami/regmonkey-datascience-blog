#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.0cm, minimum width=2.8cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=12pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    num/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
    ext/.style={->, draw=darkgray, dashed},
    data/.style={draw=lightgray, fill=white, rounded corners=2pt, font=\footnotesize,
                 align=left, inner sep=5pt},
  ]
  % 登場人物
  \node[accent] (ca) at (0,3.6) {認証局（CA）};
  \node[block] (srv) at (0,0) {Webサーバー};
  \node[block] (br) at (10,0) {ブラウザ};

  % ① 申請・② 発行
  \draw[wire] ([xshift=-0.7cm]srv.north) -- ([xshift=-0.7cm]ca.south)
    node[midway, left, sig] {\textcolor{azureblue}{\textbf{①}} 申請\\公開鍵・ドメイン名};
  \draw[wire] ([xshift=0.7cm]ca.south) -- ([xshift=0.7cm]srv.north)
    node[midway, right, sig, align=left] {\textcolor{azureblue}{\textbf{②}} 本人確認のうえ，\\CAの\textbf{秘密鍵}で署名した\\証明書を発行};

  % ルート証明書
  \draw[ext] (ca.east) -| (br.north);
  \node[sig, anchor=south] at ($(ca.east)!0.5!(br.north |- ca.east)$) {ルート証明書（CAの公開鍵）を\\OS・ブラウザにあらかじめ組み込み};

  % ③ 証明書の送付
  \draw[wire] (srv) -- (br)
    node[midway, above, sig] {\textcolor{azureblue}{\textbf{③}} 接続時に証明書を送る};

  % 証明書の中身
  \node[data, anchor=north] (cert) at (5,-0.9)
    {\textbf{電子証明書}（③で送られる）\\ドメイン名：www.example.com\\サーバーの公開鍵\\有効期限\\\textcolor{azureblue}{CAの署名}};

  % ④ 検証
  \node[note, anchor=north, align=left] at ([yshift=-0.3cm]br.south)
    {\textcolor{azureblue}{\textbf{④}} CAの\textbf{公開鍵}で証明書の\\署名を検証する\\→ 成功すれば，サーバーの\\公開鍵は本物と確認できる};
\end{tikzpicture}
