#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, inner sep=4pt, anchor=north},
    elem/.style={block, fill=paleskyblue, minimum width=4.0cm},
    threat/.style={block, draw=crimsonred, fill=mistyrose, minimum width=3.4cm},
    measure/.style={block, minimum width=6.0cm, minimum height=0.7cm},
    head/.style={font=\bfseries, text=navy},
    link/.style={draw=navy},
    hit/.style={draw=crimsonred},
  ]
  % 各グループ（要素・脅威・対策）の上端を揃える．脅威・要素の高さは対応する対策の範囲に合わせる
  \def\ex{0}
  \def\tx{5.6}
  \def\mx{11.4}

  % 対策（1つずつ）
  \node[measure] (ssl)   at (\mx, 0)    {SSL/TLS {\footnotesize\color{darkgray}：Web・メールの暗号化}};
  \node[measure] (ssh)   at (\mx,-0.95) {SSH {\footnotesize\color{darkgray}：リモートログインの暗号化}};
  \node[measure] (ipsec) at (\mx,-1.9)  {IPsec {\footnotesize\color{darkgray}：IPパケットの暗号化}};
  \node[measure] (ac)    at (\mx,-2.85) {アクセスコントロール {\footnotesize\color{darkgray}：多要素認証・認可}};
  \node[measure] (fw)    at (\mx,-3.8)  {FW {\footnotesize\color{darkgray}：境界での通信の遮断}};
  \node[measure] (mac)   at (\mx,-5.1)  {MAC・ハッシュ {\footnotesize\color{darkgray}：改ざんの検知}};
  \node[measure] (sig)   at (\mx,-6.4)  {電子署名 {\footnotesize\color{darkgray}：送信者の証明}};
  \node[measure] (ca)    at (\mx,-7.35) {認証局 {\footnotesize\color{darkgray}：公開鍵の持ち主を証明}};
  \node[measure] (ips)   at (\mx,-8.65) {IPS {\footnotesize\color{darkgray}：異常な通信の遮断}};
  \node[measure] (red)   at (\mx,-9.6)  {冗長化・CDN {\footnotesize\color{darkgray}：負荷の分散}};

  % 脅威（1つずつ）
  \node[threat, minimum height=2.6cm]  (tap)    at (\tx, 0)    {盗聴};
  \node[threat, minimum height=1.65cm] (unauth) at (\tx,-2.85) {不正アクセス};
  \node[threat, minimum height=0.7cm]  (tamp)   at (\tx,-5.1)  {改ざん};
  \node[threat, minimum height=1.65cm] (spoof)  at (\tx,-6.4)  {なりすまし\\{\footnotesize 送信元の偽装}};
  \node[threat, minimum height=1.65cm] (dos)    at (\tx,-8.65) {DoS / DDoS 攻撃};

  % 3要素
  \node[elem, minimum height=4.5cm]  (c) at (\ex, 0)    {\textbf{機密性}\\{\footnotesize Confidentiality}\\[1pt]{\footnotesize\color{darkgray}許可された者だけが見られる}};
  \node[elem, minimum height=2.95cm] (i) at (\ex,-5.1)  {\textbf{完全性}\\{\footnotesize Integrity}\\[1pt]{\footnotesize\color{darkgray}正確で，送信元も正しい}};
  \node[elem, minimum height=1.65cm] (a) at (\ex,-8.65) {\textbf{可用性}\\{\footnotesize Availability}\\[1pt]{\footnotesize\color{darkgray}必要なときに使える}};

  % 見出し
  \node[head] at (\ex,0.6) {セキュリティの3要素};
  \node[head] at (\tx,0.6) {脅威};
  \node[head] at (\mx,0.6) {対策の例};
  \node[font=\footnotesize, text=darkgray, anchor=north east] at ([yshift=-0.15cm]red.south east) {※ 主目的で分類．SSL/TLS・SSH・IPsec は MAC/AEAD で改ざんも検知する};

  \foreach \e/\t in {c/tap, c/unauth, i/tamp, i/spoof, a/dos} {
    \draw[hit] (\e.east |- \t.west) -- (\t.west);
  }
  \foreach \t/\m in {tap/ssl, tap/ssh, tap/ipsec, unauth/ac, unauth/fw,
                     tamp/mac, spoof/sig, spoof/ca, dos/ips, dos/red} {
    \draw[link] (\t.east |- \m.west) -- (\m.west);
  }
\end{tikzpicture}
