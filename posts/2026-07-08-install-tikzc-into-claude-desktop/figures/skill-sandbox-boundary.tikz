#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.05cm, minimum width=3.6cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue, minimum width=2.6cm, minimum height=1.3cm},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, minimum height=1.05cm, minimum width=3.6cm, inner sep=4pt},
    folder/.style={draw=navy, fill=none, rounded corners=8pt, inner sep=10pt},
    flabel/.style={anchor=south west, font=\footnotesize\bfseries, text=navy},
    title/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]

  % ---------- Before ----------
  \node[accent] (s1) at (0,0) {SKILL.md};
  \node[ext] (a1) at (4.6, 1.8) {PATH 上のコマンド};
  \node[ext] (a2) at (4.6, 0.6) {リポジトリ内の docs/};
  \node[ext] (a3) at (4.6,-0.6) {ネットワーク\\\footnotesize pip / curl / git clone};
  \node[ext] (a4) at (4.6,-1.8) {IDE・ツール固有の操作};
  \foreach \d in {a1,a2,a3,a4}
    \draw[->, draw=darkgray, dashed] (s1.east) -- (\d.west);

  \begin{scope}[on background layer]
    \node[folder, fit=(s1)] (f1) {};
  \end{scope}
  \node[flabel] at (f1.north west) {skill フォルダ};
  \node[title] at (2.3,3.35) {Before：ローカル環境が前提};
  \node[sig, text=crimsonred, anchor=north] at (4.6,-2.4) {フォルダの外に依存 → サンドボックスで壊れる};

  % ---------- 変換 ----------
  \draw[->, draw=azureblue, line width=1.6pt] (7.0,0) -- (8.6,0)
    node[midway, above, font=\footnotesize\bfseries, text=azureblue] {同梱}
    node[midway, below, font=\footnotesize\bfseries, text=azureblue, align=center] {削除\\書き換え};

  % ---------- After ----------
  \node[accent] (s2) at (10.4,0) {SKILL.md};
  \node[block] (b1) at (15.0, 1.8) {bin/\\\footnotesize 静的バイナリ};
  \node[block] (b2) at (15.0, 0.6) {references/\\\footnotesize 必要な資料だけ};
  \node[block] (b3) at (15.0,-0.6) {templates/ ・ scripts/};
  \node[ng] (b4) at (15.0,-2.6) {ネットワーク};
  \foreach \d in {b1,b2,b3}
    \draw[wire] (s2.east) -- (\d.west);
  \draw[->, draw=crimsonred, dashed] (s2.east) -- (b4.west)
    node[pos=0.78, left=2pt, font=\footnotesize, text=crimsonred] {× 前提にしない};

  \begin{scope}[on background layer]
    \node[folder, fit=(s2)(b1)(b3)] (f2) {};
  \end{scope}
  \node[flabel] at (f2.north west) {skill フォルダ（= zip の中身）};
  \node[title] at (12.7,3.35) {After：サンドボックス用};
  \node[sig, anchor=west] at ([xshift=4pt, yshift=8pt]f2.south west) {相対パスで参照};
\end{tikzpicture}
