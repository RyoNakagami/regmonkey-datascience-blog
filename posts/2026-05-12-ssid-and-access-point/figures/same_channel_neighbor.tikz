#| mainfont: IPAexGothic
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    ap/.style={block, minimum width=3.4cm, minimum height=1.4cm},
    zonebox/.style={draw=paleskyblue, rounded corners=8pt, line width=0.9pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=left},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    dot/.style={circle, fill=navy, inner sep=1.4pt},
    wire/.style={->, draw=navy},
  ]

  % ---------------- ゾーン枠（2つのオフィス） ----------------
  \foreach \x/\y/\t in {0/9.2/自社オフィス, 10.0/19.2/隣の会社} {
    \draw[zonebox] (\x,-0.5) rectangle (\y,5.6);
    \node[zlabel] at ({(\x+\y)/2}, 5.65) {\t};
  }

  % ---------------- AP と端末 ----------------
  \node[ap] (A1) at (2.6,4.0)  {\textbf{AP1}（自社）\\{\footnotesize SSID: OFFICE}\\{\footnotesize \textcolor{azureblue}{チャネル 1}}};
  \node[ap] (A2) at (16.6,4.0) {\textbf{AP2}（隣の会社）\\{\footnotesize SSID: NEIGHBOR}\\{\footnotesize \textcolor{azureblue}{チャネル 1}}};
  \node[accent, minimum width=3.0cm] (T) at (6.6,0.7) {\textbf{端末}\\{\footnotesize 設定SSID: OFFICE}};

  % ---------------- 届くフレーム ----------------
  \draw[wire] (A1.south) |- (T.west);
  \node[sig, anchor=west] at (2.75,2.0) {フレーム（チャネル 1）\\SSID: OFFICE};
  \draw[wire] (A2.south) |- (T.east);
  \node[sig, anchor=south] at (13.0,0.8) {フレーム（チャネル 1）\\SSID: NEIGHBOR};
  \node[note] at (12.3,4.0) {同じチャネルの電波は\\壁を越えて届く};

  % ---------------- 端末での判定 ----------------
  \node[dot] (bp) at (6.6,-1.3) {};
  \draw[draw=navy] (T.south) -- (bp);
  \node[ng, minimum width=8.2cm] (R1) at (4.6,-2.75)
    {\textcolor{crimsonred}{SSIDがない場合}\\どのネットワークのフレームか区別できない\\→ 混信（他社のフレームを受け取る・誤って接続する）};
  \node[accent, minimum width=8.2cm] (R2) at (14.6,-2.75)
    {SSIDがある場合\\OFFICE ○ 受け取る ／ NEIGHBOR × 無視する\\→ 自分のネットワークだけを選べる};
  \draw[wire] (bp) -| (R1.north);
  \draw[wire] (bp) -| (R2.north);
  \node[sig, anchor=west] at (6.75,-1.0) {端末の判定};

  \node[font=\bfseries, text=navy] at (9.6,-4.3)
    {電波（チャネル）は共有されるので，SSIDで「どのネットワークのフレームか」を見分ける};
\end{tikzpicture}
