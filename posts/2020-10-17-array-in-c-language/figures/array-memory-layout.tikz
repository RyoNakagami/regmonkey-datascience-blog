#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  \def\w{1.4}   % 1要素の幅
  \def\h{0.8}   % 高さ
  % ---- 10個の int ----
  \foreach \k in {0,...,9} {
    \pgfmathsetmacro{\x}{\k*\w}
    \ifnum\k=3
      \filldraw[draw=navy, fill=paleskyblue] (\x,0) rectangle ++(\w,\h);
      \node[font=\footnotesize\ttfamily, text=navy] at (\x+0.5*\w, 0.5*\h) {data[\k]};
    \else
      \filldraw[draw=navy, fill=aliceblue] (\x,0) rectangle ++(\w,\h);
      \node[font=\footnotesize\ttfamily] at (\x+0.5*\w, 0.5*\h) {data[\k]};
    \fi
    % 1バイトごとの目盛り
    \foreach \b in {1,2,3} {
      \draw[darkgray, line width=0.5pt] (\x+\b*\w/4, 0) -- ++(0,0.14);
      \draw[darkgray, line width=0.5pt] (\x+\b*\w/4, \h) -- ++(0,-0.14);
    }
  }
  % ---- 先頭からのオフセット ----
  \foreach \k in {0,...,10} {
    \pgfmathtruncatemacro{\off}{4*\k}
    \ifnum\k=3
      \node[font=\footnotesize\bfseries, text=azureblue, anchor=north] at (\k*\w,-0.05) {+\off};
    \else
      \node[sig, anchor=north] at (\k*\w,-0.05) {+\off};
    \fi
  }
  \node[sig, anchor=east] at (-0.45,-0.27) {先頭からのバイト数};

  % ---- 1要素 = 4バイト ----
  \draw[navy, decorate, decoration={brace, amplitude=5pt}] (0,\h+0.08) -- (\w,\h+0.08)
    node[midway, above=6pt, sig] {\texttt{int} 1個 = 4 バイト};

  % ---- 先頭の場所 ----
  \node[align=right, anchor=east, font=\footnotesize] (head) at (-0.9,0.5*\h) {先頭の場所\\\texttt{\&data[0]}};
  \draw[wire] (head.east) -- (0,0.5*\h);

  % ---- data[3] の場所 ----
  \draw[wire, azureblue] (3*\w+0.6, \h+0.75) -- (3*\w+0.6, \h+0.4) -| (3*\w, \h);
  \node[anchor=west, font=\footnotesize, inner sep=2pt] at (3*\w+0.65, \h+0.75)
    {\texttt{\&data[3]} = 先頭 + 4 × 3 = 先頭 + 12 バイト};

  % ---- 全体 40 バイト ----
  \draw[navy, decorate, decoration={brace, mirror, amplitude=6pt}] (0,-0.6) -- (10*\w,-0.6)
    node[midway, below=8pt, font=\footnotesize] {\texttt{data} 全体：4 × 10 = 40 バイトの連続した領域};
\end{tikzpicture}
