#| mainfont: IPAexGothic
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    q/.style={draw=gray!60!black, fill=gray!8, diamond, aspect=2.4, align=center, inner sep=1pt},
    res/.style={draw=#1!55!black, fill=#1!12, rounded corners=3pt, align=center,
                minimum height=1.3cm, inner sep=6pt},
    ext/.style={draw=gray!70, dashed, fill=gray!5, rounded corners=3pt, align=center, inner sep=5pt},
    lab/.style={font=\footnotesize\bfseries, fill=white, inner sep=1.5pt},
  ]
  \node[q] (q1) {受信者に Action / Decision /\\Approval が必要か？};
  \node[q, below=1.3cm of q1] (q2) {単一の明確な\\結論があるか？};
  \node[res=blue, right=2.0cm of q1] (b1) {\textbf{依頼内容・期限}\\{\footnotesize 対応・承認・判断・署名・調整依頼}};
  \node[res=blue, at={(b1 |- q2)}] (b2) {\textbf{結論}\\{\footnotesize 結論そのものを先頭に置く}};
  \node[res=teal, below=1.2cm of q2] (m) {\textbf{最重要の情報・変更点}\\{\footnotesize 状況共有・方針変更・周知・報告など}};
  \draw[->] (q1) -- node[lab, above] {Yes} (b1);
  \draw[->] (q1) -- node[lab, right] {No} (q2);
  \draw[->] (q2) -- node[lab, above] {Yes} (b2);
  \draw[->] (q2) -- node[lab, right] {No} (m);
  \node[ext, left=1.6cm of q1] (u) {ユーザー指定\\{\footnotesize「結論先出しで」など}};
  \draw[->, dashed, gray] (u) -- node[lab, above, text=gray!70!black, font=\scriptsize] {最優先} (q1);
  \node[font=\bfseries, text=blue!45!black, anchor=south] at ($(b1.north)+(0,0.3)$) {冒頭に置く主メッセージ};
\end{tikzpicture}
