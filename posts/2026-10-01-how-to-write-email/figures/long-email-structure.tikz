#| mainfont: IPAexGothic
#| libraries: [decorations.pathreplacing]
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    sec/.style={draw=#1!55!black, fill=#1!12, rounded corners=3pt, align=left,
                text width=5.4cm, minimum height=0.95cm, inner sep=5pt},
    note/.style={align=left, font=\footnotesize, anchor=west, text=black!75},
  ]
  \node[sec=gray] (subj) {\textbf{件名}\enspace【確認依頼】来期予算案};
  \node[sec=blue, below=0.35cm of subj] (m) {\textbf{Main Message (MMUF)}};
  \node[sec=blue, below=0.2cm of m] (a) {\textbf{Required Action}};
  \node[sec=teal, below=0.2cm of a] (b) {\textbf{Background}};
  \node[sec=teal, below=0.2cm of b] (d) {\textbf{Details}};
  \node[sec=orange, below=0.2cm of d] (ref) {\textbf{Reference}};
  \node[note] at ($(subj.east)+(0.4,0)$) {件名だけで目的（Intent）と行動の要否が分かる};
  \node[note] at ($(m.east)+(0.4,0)$) {10月4日（金）までに，来期予算案をご確認ください．};
  \node[note] at ($(a.east)+(0.4,0)$) {誰が・何を・いつまでに（複数なら箇条書き）};
  \node[note] at ($(b.east)+(0.4,0)$) {9月の経営会議で事業計画が更新されています．};
  \node[note] at ($(d.east)+(0.4,0)$) {主な変更点：広告費／採用費／開発予算};
  \node[note] at ($(ref.east)+(0.4,0)$) {詳細：\textless URL\textgreater（実在するリンクのみ）};
  \draw[decorate, decoration={brace, amplitude=6pt, mirror}, line width=0.9pt, blue!55!black]
    ($(m.north west)+(-0.25,0)$) -- ($(a.south west)+(-0.25,0)$)
    node[midway, left=8pt, align=right, font=\footnotesize\bfseries, text=blue!45!black] {冒頭1〜3文\\最重要領域};
  \draw[->, gray, line width=1.1pt] ($(subj.north west)+(-2.6,0)$) -- ($(ref.south west)+(-2.6,0)$)
    node[pos=0.75, left, font=\footnotesize, text=gray!70!black, align=right] {読まれる\\順序};
\end{tikzpicture}
