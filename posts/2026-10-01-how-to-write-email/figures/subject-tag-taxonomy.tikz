#| mainfont: IPAexGothic
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    root/.style={draw=gray!60!black, fill=gray!10, rounded corners=3pt, align=center, inner sep=6pt},
    cat/.style={draw=#1!55!black, fill=#1!12, rounded corners=3pt, align=center,
                minimum width=3.0cm, minimum height=0.9cm, inner sep=4pt},
    tag/.style={draw=#1!55!black, fill=white, rounded corners=2pt, anchor=west, text width=6.0cm,
                minimum height=0.75cm, inner sep=4pt},
    sub/.style={draw=#1!40, dashed, fill=white, rounded corners=2pt, anchor=west, text width=6.0cm,
                minimum height=0.75cm, inner sep=4pt},
  ]
  \node[root] (r) {受信者に\\何を求めるか？};
  \node[cat=teal, right=1.6cm of r, yshift=2.6cm] (none) {何も求めない};
  \node[cat=blue, right=1.6cm of r, yshift=-0.4cm] (act) {行動を求める};
  \node[tag=teal] (info) at ($(none.east)+(1.2,0)$) {\textbf{【共有】}\ {\footnotesize INFO：情報共有，原則対応不要}};
  \foreach \t/\d [count=\i] in {
      {【対応依頼】}/{ACTION：具体的な行動},
      {【署名依頼】}/{SIGN：署名},
      {【判断依頼】}/{DECISION：選択・意思決定},
      {【承認依頼】}/{REQUEST：許可・承認},
      {【調整依頼】}/{COORD：関係者との調整}}
    \node[tag=blue] (t\i) at ($(act.east)+(1.2,{1.9-(\i-1)*0.95})$) {\textbf{\t}\ {\footnotesize \d}};
  \foreach \t/\d [count=\i] in {
      {【確認依頼】}/{内容の確認},
      {【回答依頼】}/{質問への回答},
      {【日程調整】}/{候補日の調整}}
    \node[sub=blue] (u\i) at ($(act.east)+(1.2,{1.9-(\i+4)*0.95})$) {\textbf{\t}\ {\footnotesize 補助：\d}};
  \draw[->] (r.east) -- ++(0.6,0) |- (none);
  \draw[->] (r.east) -- ++(0.6,0) |- (act);
  \draw[->] (none) -- (info);
  \coordinate (br) at ($(act.east)+(0.6,0)$);
  \draw (act.east) -- (br);
  \foreach \n in {t1,t2,t3,t4,t5} \draw[->] (br |- \n) -- (\n);
  \foreach \n in {u1,u2,u3} \draw[->, dashed, gray] (br |- \n) -- (\n);
  \draw (br |- t1) -- (br |- u3);
\end{tikzpicture}
