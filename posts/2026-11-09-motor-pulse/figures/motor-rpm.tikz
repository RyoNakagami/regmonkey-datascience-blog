#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.5cm, minimum width=3.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % ---------- 上段：計算の流れ ----------
  \node[block] (b1) {1カウントの時間\\[2pt]{\large $1\,\mu\mathrm{s}$}};
  \node[block, right=1.9cm of b1] (b2) {パルスの周期\\[2pt]{\large $10\,\mathrm{ms}$}};
  \node[block, right=1.9cm of b2] (b3) {1秒あたりのパルス数\\[2pt]{\large $100$ 回}};
  \node[accent, right=1.9cm of b3] (b4) {回転数\\[2pt]{\large $50$ 回転/秒}};

  \foreach \n/\s/\t in {b1/Step 1/クロック $1\,\mathrm{MHz}$\\$=1$秒に$10^{6}$回,
                        b2/Step 2/$10{,}000\times1\,\mu\mathrm{s}$,
                        b3/Step 3/パルス周波数\\$100\,\mathrm{Hz}$,
                        b4/Step 4/答え} {
    \node[step, above=2mm of \n] {\s};
    \node[note, below=2mm of \n] {\t};
  }

  \draw[wire] (b1) -- node[midway, above, sig] {$\times 10{,}000$} (b2);
  \draw[wire] (b2) -- node[midway, above, sig] {$1\,\mathrm{s}\div10\,\mathrm{ms}$} (b3);
  \draw[wire] (b3) -- node[midway, above, sig] {$\div 2$} node[midway, below, sig, align=center] {1回転\\=2パルス} (b4);

  % ---------- 下段：パルス波形 ----------
  \def\y{-4.6}
  \def\h{0.9}
  \def\p{2.6}   % 1周期の長さ（図上）
  \def\w{0.9}   % パルス幅
  \coordinate (w0) at (1.0,\y);
  \node[sig, anchor=east] at ($(w0)+(-0.2,0.45)$) {センサー出力};
  \draw[navy, line width=1pt] (w0) -- ++(0.4,0);
  \foreach \k in {0,...,4} {
    \draw[navy, line width=1pt] ($(w0)+(0.4+\k*\p,0)$) -- ++(0,\h) -- ++(\w,0) -- ++(0,-\h) -- ++(\p-\w,0);
  }
  \draw[navy, line width=1pt] ($(w0)+(0.4+5*\p,0)$) -- ++(0.6,0);

  % 周期 T の寸法線（1つ目の立ち上がり → 2つ目の立ち上がり）
  \coordinate (r1) at ($(w0)+(0.4,0)$);
  \coordinate (r2) at ($(r1)+(\p,0)$);
  \coordinate (r3) at ($(r1)+(2*\p,0)$);
  \draw[lightgray, dashed] (r1) -- ++(0,-0.75);
  \draw[lightgray, dashed] (r2) -- ++(0,-0.75);
  \draw[lightgray, dashed] (r3) -- ++(0,-0.75);
  \draw[|<->|, azureblue] ($(r1)+(0,-0.55)$) -- node[midway, below, font=\footnotesize, text=azureblue] {周期 $T = 10\,\mathrm{ms}$（$10{,}000$カウント）} ($(r2)+(0,-0.55)$);

  % 1回転 = 2パルス のブレース
  \draw[navy, decorate, decoration={brace, amplitude=6pt}]
    ($(r1)+(0,\h+0.25)$) -- node[midway, above=7pt, font=\footnotesize, text=navy] {軸が1回転（$20\,\mathrm{ms}$）} ($(r3)+(0,\h+0.25)$);
  \draw[navy, decorate, decoration={brace, amplitude=6pt}]
    ($(r3)+(0,\h+0.25)$) -- node[midway, above=7pt, font=\footnotesize, text=navy] {次の1回転} ($(r3)+(2*\p,\h+0.25)$);

  \node[note, anchor=west] at ($(r1)+(5*\p+0.9,0.45)$) {1秒間に\\$1000\,\mathrm{ms} \div 20\,\mathrm{ms}$\\$= 50$ 回転};
\end{tikzpicture}
