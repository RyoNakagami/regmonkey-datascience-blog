#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    accent/.style={draw=navy, fill=paleskyblue, rounded corners=3pt,
                   align=center, inner sep=8pt},
  ]
  % クロック刻み x = 1.2 i  (i = 0..11)，1 刻み = 1 カウント = 1 μs
  % パルス立ち上がり：xs = 1.8（i=1.5），xe = 11.1（i=9.25）
  \def\yc{0}
  \def\ylo{2.4}
  \def\yhi{3.6}
  \def\xs{1.8}
  \def\xe{11.1}

  % --- 端数の領域（数えられない時間） ---
  \fill[mistyrose] (\xs,\yc) rectangle (2.4,\ylo);
  \fill[mistyrose] (10.8,\yc) rectangle (\xe,\ylo);
  \node[font=\footnotesize, text=crimsonred] at (2.1,1.55) {$\delta_s$};
  \node[font=\footnotesize, text=crimsonred] at (2.1,1.05) {$0.5$};
  \node[font=\footnotesize, text=crimsonred] at (11.5,1.55) {$\delta_e$};
  \node[font=\footnotesize, text=crimsonred] at (11.5,1.05) {$0.25$};

  % --- 行ラベル ---
  \node[anchor=east, sig] at (-0.4,{(\ylo+\yhi)/2}) {センサー\\パルス};
  \node[anchor=east, sig] at (-0.4,\yc+0.25) {クロック\\$f=1\,$MHz};

  % --- クロック ---
  \draw[lightgray] (-0.2,\yc) -- (13.4,\yc);
  \foreach \i in {0,1,10,11} {
    \draw[darkgray] ({1.2*\i},\yc) -- ({1.2*\i},\yc+0.5);
  }
  \foreach \i [count=\j from 1] in {2,...,9} {
    \draw[navy, line width=1.4pt] ({1.2*\i},\yc) -- ({1.2*\i},\yc+0.5);
    \node[font=\footnotesize, text=azureblue] at ({1.2*\i},\yc-0.35) {\j};
  }

  % --- パルス波形 ---
  \draw[navy, line width=1.1pt]
    (-0.2,\ylo) -- (\xs,\ylo) -- (\xs,\yhi) -- (6.6,\yhi) -- (6.6,\ylo)
    -- (\xe,\ylo) -- (\xe,\yhi) -- (13.4,\yhi);
  \draw[darkgray, dashed] (\xs,\ylo) -- (\xs,\yc);
  \draw[darkgray, dashed] (\xe,\ylo) -- (\xe,\yc);
  \node[sig, anchor=south] at (\xs,\yhi+0.05) {開始エッジ};
  \node[sig, anchor=south] at (\xe,\yhi+0.05) {終了エッジ};

  % --- 真の周期 T ---
  \draw[<->, navy] (\xs,4.6) -- (\xe,4.6)
    node[midway, above, text=fontblack] {真の周期 $T$：$Tf = 7.75$ カウント（実数）};

  % --- 計数値 N ---
  \draw[<->, azureblue] (2.4,-0.95) -- (10.8,-0.95);
  \node[text=azureblue, anchor=north] at (6.6,-1.1)
    {タイマーが数えたクロック：$N = 8$ カウント（整数）};

  % --- 補足 ---
  \node[sig, anchor=west, align=left] at (13.6,1.3)
    {赤い区間は\\1 カウント未満で\\数えられない};

  % --- 結論 ---
  \node[accent, anchor=north] (res) at (6.6,-2.2)
    {$e = N - Tf = 8 - 7.75 = 0.25$\qquad
     一般に\ \ $e = 1 - (\delta_s + \delta_e)$\\[5pt]
     エッジとクロックの位相は毎回ばらばら $\Rightarrow$ $e$ は毎回変わる確率変数
     （本問では $e \sim \mathcal{U}[-0.5,\,0.5]$ とモデル化）};

  \node[sig, anchor=north west] at (-2.0,-4.3)
    {※ 模式図は $N=8$．実際の計測は $N=10{,}000$．};
\end{tikzpicture}
