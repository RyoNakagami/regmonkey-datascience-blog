#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, inner sep=5pt, minimum width=3.8cm},
    accent/.style={block, fill=paleskyblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % --- 上段：caffeinate（一時的な「お願い」） ---
  \node[block] (c) {caffeinate -s\\（一般ユーザー権限）};
  \node[accent, right=4.2cm of c] (p) {powerd\\（root で常駐）};
  \node[block, right=2.2cm of p] (s) {アイドルスリープ\\判定（sleep 1 分）};
  \node[block, right=2.0cm of s] (r) {pmset -g の表示\\sleep prevented\\by caffeinate};

  \draw[wire] ([yshift=3mm]c.east) -- node[midway, above, sig]
      {PreventSystemSleep\\アサーション作成} ([yshift=3mm]p.west);
  \draw[wire, dashed] ([yshift=-3mm]p.west) -- node[midway, below, sig]
      {プロセス終了を検知して\\自動で解放} ([yshift=-3mm]c.east);
  \draw[wire] (p) -- node[midway, above, sig] {抑止} (s);
  \draw[wire] (s) -- (r);

  \node[step, above=2mm of c] {一時的・プロセスに紐づく};
  \node[note, below=2mm of s] {-s は AC 電源時のみ有効};

  % --- 下段：pmset（恒久的な設定変更） ---
  \node[block, below=1.8cm of c] (pm) {sudo pmset -a sleep 0};
  \node[block, right=1.6cm of pm] (pl) {システム設定 plist\\/Library/Preferences/};
  \draw[wire] (pm) -- node[midway, above, sig] {root 必須} (pl);
  \draw[wire] (pl.east) -| node[pos=0.75, right, sig] {起動時・変更時に\\読み込む} (p.south);
  \node[step, above=2mm of pm] {恒久的・再起動後も残る};
\end{tikzpicture}
