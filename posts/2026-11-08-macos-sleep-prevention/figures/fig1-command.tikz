#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt, minimum width=3.2cm},
    accent/.style={block, fill=paleskyblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b1) {\texttt{nohup}};
  \node[accent, right=1.4cm of b1] (b2) {\texttt{caffeinate -s}};
  \node[block, right=0.9cm of b2] (b3) {\texttt{>/dev/null}};
  \node[block, right=0.9cm of b3] (b4) {\texttt{2>\&1}};
  \node[block, right=0.9cm of b4] (b5) {\texttt{\&}};
  \foreach \n/\s/\t in {
    b1/① SIGHUP を無視/SIGHUP を SIG\_IGN にして\\exec する（無視は継承）,
    b2/② 本体/PreventSystemSleep の\\アサーションを保持,
    b3/③ stdout を捨てる/切断後の tty へ\\書き込まない,
    b4/④ stderr も同じ先へ/nohup.out も\\作られない,
    b5/⑤ バックグラウンド/プロンプトを即返す\\（ジョブとして登録）} {
    \node[step, above=2mm of \n] {\s};
    \node[note, below=2mm of \n] {\t};
  }
  \draw[wire] (b1) -- node[midway, above, font=\footnotesize, text=darkgray, inner sep=2pt] {exec} (b2);
  \draw[draw=lightgray] ($(b2.east)!0.5!(b3.west)+(0,0.9)$) -- ++(0,-1.8);
\end{tikzpicture}
