#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    tag/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                minimum height=0.9cm, inner sep=5pt, font=\ttfamily},
    io/.style={tag, minimum width=3.2cm},
    keep/.style={tag, fill=white},
    hit/.style={tag, fill=paleskyblue, dashed},
    head/.style={font=\footnotesize\bfseries, text=azureblue, anchor=south},
    note/.style={font=\footnotesize, text=darkgray, anchor=north, align=center},
    wire/.style={->, draw=navy},
  ]
  % 中央列の区切り位置（残る部分 | マッチする部分）
  \def\cx{6.2}

  % ---- 1行目：CRON[812]: ----
  \node[io] (i1) at (0,2) {CRON[812]:};
  \node[keep, anchor=east] (k1) at (\cx,2) {CRON};
  \node[hit,  anchor=west] (h1) at (\cx,2) {[812]:};
  \node[io] (o1) at (12,2) {CRON};

  % ---- 2行目：systemd[1]: ----
  \node[io] (i2) at (0,0) {systemd[1]:};
  \node[keep, anchor=east] (k2) at (\cx,0) {systemd};
  \node[hit,  anchor=west] (h2) at (\cx,0) {[1]:};
  \node[io] (o2) at (12,0) {systemd};

  % ---- 3行目：kernel: ----
  \node[io] (i3) at (0,-2) {kernel:};
  \node[keep] (k3) at (\cx,-2) {kernel:};
  \node[io] (o3) at (12,-2) {kernel:};

  % ---- 配線 ----
  \draw[wire] (i1.east) -- (k1.west);
  \draw[wire] (h1.east) -- (o1.west);
  \draw[wire] (i2.east) -- (k2.west);
  \draw[wire] (h2.east) -- (o2.west);
  \draw[wire] (i3.east) -- (k3.west);
  \draw[wire] (k3.east) -- (o3.west);

  % ---- 補足 ----
  \node[note] at ([yshift=-1mm]h1.south) {マッチ → 削除};
  \node[note] at ([yshift=-1mm]h2.south) {マッチ → 削除};
  \node[note] at ([yshift=-1mm]k3.south) {\texttt{[...]} がないので\\マッチしない};
  \node[note] at ([yshift=-1mm]o3.south) {末尾の \texttt{:} は置換2で消す};

  % ---- 列見出し ----
  \node[head] at ([yshift=4mm]i1.north) {入力（\texttt{\$3} のタグ）};
  \node[head] at ([yshift=4mm]\cx,2.45) {置換1がマッチする部分};
  \node[head] at ([yshift=4mm]o1.north) {出力};

  % ---- 置換式 ----
  \node[font=\small, text=navy, anchor=south] at (6,3.55) {置換1：\verb|s/\[[0-9]*\]:*$//|};
\end{tikzpicture}
