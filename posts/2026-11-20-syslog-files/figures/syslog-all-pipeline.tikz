#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.6cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, minimum height=1.1cm, minimum width=2.6cm, inner sep=5pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center, anchor=north},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b0) {\texttt{zcat -f syslog*}\\[2pt]{\footnotesize 全世代を連結}};
  \node[block, right=0.75cm of b0] (b1) {\texttt{awk}\\[2pt]{\footnotesize 第3フィールド}};
  \node[block, right=0.75cm of b1] (b2) {\texttt{sed}\\[2pt]{\footnotesize PID・\texttt{:}を除去}};
  \node[block, right=0.75cm of b2] (b3) {\texttt{sort}\\[2pt]{\footnotesize 同名を隣接}};
  \node[accent, right=0.75cm of b3] (b4) {\texttt{uniq -c}\\[2pt]{\footnotesize 連続行を数える}};
  \node[block, right=0.75cm of b4] (b5) {\texttt{sort -rn}\\[2pt]{\footnotesize 件数の降順}};
  \node[block, right=0.75cm of b5] (b6) {\texttt{head -15}\\[2pt]{\footnotesize 上位15件}};

  \foreach \n/\s in {b0/Step 0, b1/Step 1, b2/Step 2, b3/Step 3, b4/Step 4, b5/Step 5, b6/Step 6} {
    \node[step, above=2mm of \n] {\s};
  }
  \node[note, align=left, below=2mm of b0.south] {\texttt{syslog}，\texttt{syslog.1}，…\\\texttt{host CRON[812]: ...}};
  \node[note, align=left, below=2mm of b1.south] {\texttt{CRON[812]:}\\\texttt{kernel:}};
  \node[note, align=left, below=2mm of b2.south] {\texttt{CRON}\\\texttt{kernel}};
  \node[note, align=left, below=2mm of b3.south] {\texttt{CRON}\\\texttt{CRON}\\\texttt{kernel}};
  \node[note, align=left, below=2mm of b4.south] {\texttt{2 CRON}\\\texttt{1 kernel}};
  \node[note, below=2mm of b5.south] {多い順に並べ替え\\（\texttt{-n} 数値比較）};
  \node[note, below=2mm of b6.south] {ランキング\\表示};

  \foreach \a/\b in {b0/b1, b1/b2, b2/b3, b3/b4, b4/b5, b5/b6} {
    \draw[wire] (\a) -- (\b);
  }
  \node[font=\footnotesize\bfseries, text=azureblue, anchor=north east] at ([xshift=-0.5cm, yshift=-2mm]b0.south west) {例};
  \node[font=\footnotesize, text=darkgray, anchor=north west] at ([yshift=-1.6cm]b0.south west)
    {※ 「例」の行（\texttt{CRON}，\texttt{kernel}，PID \texttt{812}，件数など）は説明用の例で，実際のログの値ではない．};
\end{tikzpicture}
