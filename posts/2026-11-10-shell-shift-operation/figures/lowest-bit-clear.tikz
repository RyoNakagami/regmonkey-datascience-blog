#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
% セルを1行描く：\bitrow{x0}{y}{b4,b3,b2,b1,b0}{強調する列番号の集合（0 始まり，左から）}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    cell/.style={draw=navy, fill=aliceblue, minimum size=0.8cm, inner sep=0pt,
                 font=\large\ttfamily},
    hit/.style={cell, fill=paleskyblue},
    rowlabel/.style={anchor=east, font=\ttfamily},
    value/.style={anchor=west},
    idx/.style={font=\footnotesize, text=darkgray},
    title/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray},
    result/.style={font=\footnotesize\bfseries, text=azureblue, anchor=west},
  ]
  % 列の x 座標：パネル A は 2.4 + 0.9*i，パネル B は 9.4 + 0.9*i（i = 0..4，左が上位ビット）
  % ---- 行ラベル ----
  \node[rowlabel] at (1.7, 0)    {m};
  \node[rowlabel] at (1.7, -1.1) {m - 1};
  \node[rowlabel] at (1.7, -2.4) {m \& (m - 1)};

  % ---- ビット番号 ----
  \foreach \i/\b in {0/4,1/3,2/2,3/1,4/0} {
    \node[idx] at ({2.4 + 0.9*\i}, 0.7) {\b};
    \node[idx] at ({9.4 + 0.9*\i}, 0.7) {\b};
  }

  % ================= パネル A：m = 16 =================
  \node[title] at (4.2, 1.4) {2の冪：m = 16};
  % m = 10000
  \foreach \i/\v/\s in {0/1/hit,1/0/cell,2/0/cell,3/0/cell,4/0/cell}
    \node[\s] at ({2.4 + 0.9*\i}, 0) {\v};
  % m - 1 = 01111（全ビットが反転）
  \foreach \i/\v in {0/0,1/1,2/1,3/1,4/1}
    \node[hit] at ({2.4 + 0.9*\i}, -1.1) {\v};
  % 結果 = 00000
  \foreach \i in {0,...,4}
    \node[cell] at ({2.4 + 0.9*\i}, -2.4) {0};
  \node[value] at (6.5, 0)    {$= 16$};
  \node[value] at (6.5, -1.1) {$= 15$};
  \node[value] at (6.5, -2.4) {$= 0$};
  \draw[navy] (1.95, -1.75) -- (7.6, -1.75);
  \node[note] at (4.2, -3.2) {ただ1つの 1 が消えて 0 になる};

  % ================= パネル B：m = 12 =================
  \node[title] at (11.2, 1.4) {2の冪でない：m = 12};
  % m = 01100
  \foreach \i/\v/\s in {0/0/cell,1/1/cell,2/1/hit,3/0/cell,4/0/cell}
    \node[\s] at ({9.4 + 0.9*\i}, 0) {\v};
  % m - 1 = 01011（一番下の 1 から下が反転）
  \foreach \i/\v/\s in {0/0/cell,1/1/cell,2/0/hit,3/1/hit,4/1/hit}
    \node[\s] at ({9.4 + 0.9*\i}, -1.1) {\v};
  % 結果 = 01000
  \foreach \i/\v in {0/0,1/1,2/0,3/0,4/0}
    \node[cell] at ({9.4 + 0.9*\i}, -2.4) {\v};
  \node[value] at (13.5, 0)    {$= 12$};
  \node[value] at (13.5, -1.1) {$= 11$};
  \node[value] at (13.5, -2.4) {$= 8$};
  \draw[navy] (8.95, -1.75) -- (14.6, -1.75);
  \node[note] at (11.2, -3.2) {上位の 1 が残るので 0 にならない};

  % ---- 凡例 ----
  \node[hit, minimum size=0.4cm] (lg) at (4.6, -3.95) {};
  \node[note, anchor=west] at ([xshift=1mm]lg.east)
    {m では一番下の 1，m - 1 では 1 を引いて反転したビット};
\end{tikzpicture}
