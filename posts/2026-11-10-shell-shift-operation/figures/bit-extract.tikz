#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    cell/.style={draw=navy, fill=aliceblue, minimum size=0.8cm, inner sep=0pt,
                 font=\large\ttfamily},
    hit/.style={cell, fill=paleskyblue},
    pad/.style={cell, draw=darkgray, dashed, fill=white, text=darkgray},
    rowlabel/.style={anchor=east, font=\ttfamily},
    value/.style={anchor=west},
    idx/.style={font=\footnotesize, text=darkgray},
    note/.style={font=\footnotesize, text=darkgray, anchor=west},
    step/.style={font=\footnotesize\bfseries, text=azureblue, anchor=west},
  ]
  % 列の x 座標：ビット番号 b のセルは x = 3 + (3 - b)
  % ---- ビット番号 ----
  \foreach \b in {3,2,1,0} {
    \node[idx] at ({3 + (3 - \b)}, 0.75) {\b};
  }
  \node[note, anchor=east] at (1.6, 0.75) {ビット番号};

  % ---- 行1：x = 10 ----
  \node[cell] (a3) at (3,0) {1};
  \node[cell] (a2) at (4,0) {0};
  \node[hit]  (a1) at (5,0) {1};
  \node[cell] (a0) at (6,0) {0};
  \node[rowlabel] at (1.6,0) {x};
  \node[value] at (9.8,0) {$= 10$};

  % ---- 行2：x >> 1 = 5 ----
  \node[pad]  (b3) at (3,-1.9) {0};
  \node[cell] (b2) at (4,-1.9) {1};
  \node[cell] (b1) at (5,-1.9) {0};
  \node[hit]  (b0) at (6,-1.9) {1};
  \node[pad]  (bx) at (7,-1.9) {0};
  \node[rowlabel] at (1.6,-1.9) {x >> 1};
  \node[value] at (9.8,-1.9) {$= 5$};
  \node[note] at ([xshift=1mm]bx.east) {捨てる};
  \node[note, anchor=north] at ([yshift=-1mm]b3.south) {0 で埋める};

  % シフトの矢印（1つ右下へ移動）
  \draw[->, darkgray] (a3.south) -- (b2.north);
  \draw[->, darkgray] (a2.south) -- (b1.north);
  \draw[->, azureblue, line width=1.1pt] (a1.south) -- (b0.north);
  \draw[->, darkgray] (a0.south) -- (bx.north);
  \node[step] at (6.75,-0.95) {右へ1ビット};

  % ---- 行3：& 1 ----
  \node[cell] (c3) at (3,-3.4) {0};
  \node[cell] (c2) at (4,-3.4) {0};
  \node[cell] (c1) at (5,-3.4) {0};
  \node[cell] (c0) at (6,-3.4) {1};
  \node[rowlabel] at (1.6,-3.4) {\& 1};
  \node[value] at (9.8,-3.4) {$= 1$};

  % ---- 区切り線 ----
  \draw[navy] (0.4,-4.05) -- (10.6,-4.05);

  % ---- 行4：結果 ----
  \node[cell] (d3) at (3,-4.7) {0};
  \node[cell] (d2) at (4,-4.7) {0};
  \node[cell] (d1) at (5,-4.7) {0};
  \node[hit]  (d0) at (6,-4.7) {1};
  \node[rowlabel, font=\small] at (1.6,-4.7) {結果};
  \node[value] at (9.8,-4.7) {$= 1$};
  \node[note] at (6.6,-4.7) {← 1 ビット目の値};
\end{tikzpicture}
