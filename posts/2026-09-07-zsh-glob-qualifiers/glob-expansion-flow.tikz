#| mainfont: IPAexGothic
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    stepbox/.style={draw=blue!55!black, fill=blue!10, rounded corners=3pt,
                 align=center, minimum height=1.0cm, minimum width=8.6cm,
                 inner sep=6pt},
    io/.style={draw=orange!60!black, fill=orange!12, rounded corners=3pt,
               align=center, minimum height=1.0cm, minimum width=8.6cm,
               inner sep=6pt, font=\small},
    sig/.style={font=\footnotesize},
  ]

  \node[io] (input) {入力: \texttt{dirA/*}};

  \node[stepbox, below=0.85cm of input] (detect)
    {シェルが glob 文字（\texttt{*}, \texttt{?}, \texttt{[ ]} など）を検出};

  \node[stepbox, below=0.85cm of detect] (pattern)
    {パターンとして解釈};

  \node[stepbox, below=0.85cm of pattern] (match)
    {カレントディレクトリ（この場合 \texttt{dirA}）の中身と照合};

  \node[stepbox, below=0.85cm of match] (replace)
    {マッチしたファイル名のソート済みリストに置換};

  \node[io, below=0.85cm of replace] (output)
    {出力: \texttt{dirA/test dirA/file1 dirA/file2 ...}};

  \draw[->] (input) -- (detect);
  \draw[->] (detect) -- (pattern);
  \draw[->] (pattern) -- (match);
  \draw[->] (match) -- (replace);
  \draw[->] (replace) -- (output);

\end{tikzpicture}
