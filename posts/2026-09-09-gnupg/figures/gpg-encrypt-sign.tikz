#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    data/.style={block, fill=white},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=4pt, font=\footnotesize},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    dot/.style={circle, fill=navy, inner sep=1.4pt},
    wire/.style={->, draw=navy},
    kwire/.style={->, draw=darkgray, dashed},
  ]
  % ---- row 1: encryption ----
  \node[data, minimum width=2.4cm] (p1) at (0,0) {平文};
  \node[block, minimum width=2.6cm] (enc) at (3.8,0) {暗号化};
  \node[data, minimum width=2.4cm] (c1) at (7.7,0) {暗号文};
  \node[block, minimum width=2.6cm] (dec) at (11.6,0) {復号};
  \node[data, minimum width=2.4cm] (p2) at (15.4,0) {平文};
  \node[ext] (kpub) at (3.8,1.75) {Bob の公開鍵};
  \node[ext] (kpriv) at (11.6,1.75) {Bob の秘密鍵};
  \draw[wire] (p1) -- (enc);
  \draw[wire] (enc) -- (c1) node[midway, above, sig] {送信};
  \draw[wire] (c1) -- (dec);
  \draw[wire] (dec) -- (p2);
  \draw[kwire] (kpub) -- (enc);
  \draw[kwire] (kpriv) -- (dec);
  \node[step, anchor=south west] at (-1.2,2.3) {① 暗号化：Bob だけが読めるようにする（機密性）};
  \node[note, below=2mm of c1] {秘密鍵を持つ Bob 以外は読めない};

  % ---- row 2: signature ----
  \node[data, minimum width=2.4cm] (d1) at (0,-4.2) {文書};
  \node[block, minimum width=2.6cm] (sgn) at (3.8,-4.2) {署名};
  \node[data, minimum width=2.4cm] (ds) at (7.7,-4.2) {文書＋署名};
  \node[block, minimum width=2.6cm] (vrf) at (11.6,-4.2) {検証};
  \node[data, minimum width=2.4cm] (ok) at (15.4,-4.2) {OK / NG};
  \node[ext] (spriv) at (3.8,-2.45) {Alice の秘密鍵};
  \node[ext] (spub) at (11.6,-2.45) {Alice の公開鍵};
  \draw[wire] (d1) -- (sgn);
  \draw[wire] (sgn) -- (ds) node[midway, above, sig] {送信};
  \draw[wire] (ds) -- (vrf);
  \draw[wire] (vrf) -- (ok);
  \draw[kwire] (spriv) -- (sgn);
  \draw[kwire] (spub) -- (vrf);
  \node[step, anchor=south west] at (-1.2,-1.9) {② 署名：Alice が作った・改ざんされていないことを示す（真正性・完全性）};
  \node[note, below=2mm of sgn] {文書のハッシュ値に\\秘密鍵で署名};
  \node[note, below=2mm of ok] {送信者の確認と\\改ざんの有無};

  % ---- header ----
  \node[zlabel] (ha) at (1.9,3.15) {送信者 Alice};
  \node[zlabel] (hb) at (13.5,3.15) {受信者 Bob};
  \draw[lightgray, line width=1pt] (-1.2,3.1) -- (5.1,3.1);
  \draw[lightgray, line width=1pt] (10.3,3.1) -- (16.6,3.1);
  \draw[lightgray, line width=1pt] (-1.2,-1.5) -- (16.6,-1.5);
\end{tikzpicture}
