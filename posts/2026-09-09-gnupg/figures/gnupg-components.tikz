#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    data/.style={block, fill=white},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=4pt, font=\footnotesize},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    dot/.style={circle, fill=navy, inner sep=1.4pt},
    wire/.style={->, draw=navy},
    kwire/.style={->, draw=darkgray, dashed},
    file/.style={draw=navy, fill=white, rounded corners=3pt, align=center,
                 minimum width=5.6cm, minimum height=0.95cm, inner sep=5pt, anchor=west},
  ]
  % ---- processes ----
  \node[block, minimum width=2.8cm] (gpg) at (0,1.0) {\texttt{gpg} コマンド};
  \node[block, minimum width=2.8cm] (agent) at (5.0,-2.0) {gpg-agent};
  \node[block, minimum width=2.8cm] (pin) at (5.0,-4.2) {pinentry};
  \node[note, below=2mm of gpg] {暗号化・署名・\\鍵の管理};
  \node[note, above=2mm of agent] {秘密鍵の操作と\\パスフレーズのキャッシュ};

  % ---- ~/.gnupg ----
  \node[file] (conf) at (9.4,2.2) {\texttt{gpg.conf} など\\{\footnotesize\color{darkgray} 設定ファイル（任意）}};
  \node[file] (pub) at (9.4,1.0) {\texttt{pubring.kbx}\\{\footnotesize\color{darkgray} 公開鍵のキーリング}};
  \node[file] (trust) at (9.4,-0.2) {\texttt{trustdb.gpg}\\{\footnotesize\color{darkgray} 鍵の信頼度データベース}};
  \node[file] (priv) at (9.4,-2.0) {\texttt{private-keys-v1.d/}\\{\footnotesize\color{darkgray} 秘密鍵（鍵ごとに1ファイル）}};
  \node[file] (rev) at (9.4,-3.2) {\texttt{openpgp-revocs.d/}\\{\footnotesize\color{darkgray} 失効証明書}};

  % ---- wires ----
  \draw[wire] (gpg.east) -- (pub.west);
  \node[dot] (bus) at (7.9,1.0) {};
  \draw[wire] (bus) |- (conf.west);
  \draw[wire] (bus) |- (trust.west);
  \draw[wire] (gpg.south) ++(0,-0.95) -- (0,-2.0) -- (agent.west) node[midway, above, sig] {ソケット経由で依頼};
  \draw[wire] (agent) -- (priv);
  \draw[wire] (agent) -- (pin) node[midway, right, sig] {パスフレーズ入力};

  % ---- zone ----
  \coordinate (ztop) at (9.4,2.75);
  \coordinate (zbot) at (9.4,-3.75);
  \begin{scope}[on background layer]
    \node[zone, fit=(conf)(rev)(ztop)(zbot)] (zg) {};
  \end{scope}
  \node[zlabel] at (zg.north) {\texttt{\textasciitilde/.gnupg}（パーミッション 700）};
\end{tikzpicture}
