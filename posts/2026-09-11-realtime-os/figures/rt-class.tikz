#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south},
    val/.style={draw=navy, line width=1.4pt},
    ngval/.style={draw=crimsonred, line width=1.4pt},
  ]
  \foreach \i/\tt/\ex in {0/ハードリアルタイム/例：エアバッグ，ブレーキ制御,
                          1/ファームリアルタイム/例：映像フレームの描画,
                          2/ソフトリアルタイム/例：Web ページの表示} {
    \begin{scope}[xshift=\i*5.4cm]
      \draw[->, draw=navy] (0,0) -- (4.3,0) node[sig, anchor=north east, yshift=-2pt] {完了時刻};
      \draw[->, draw=navy] (0,-1.5) -- (0,2.0) node[sig, anchor=south] {結果の価値};
      \draw[draw=navy, densely dashed] (2.2,-1.5) -- (2.2,1.75);
      \node[sig, anchor=north west] at (2.2,-0.05) {$d$};
      \node[ttl] at (2.0,2.45) {\tt};
      \node[sig, anchor=north] at (2.0,-1.65) {\ex};
      \node[sig, anchor=east] at (0,1.2) {$1$};
      \node[sig, anchor=east] at (0,0) {$0$};
    \end{scope}
  }
  % ハード：締切後は大きな負の価値
  \draw[val] (0,1.2) -- (2.2,1.2);
  \draw[ngval] (2.2,1.2) -- (2.2,-1.2) -- (4.0,-1.2);
  \node[font=\footnotesize\bfseries, text=crimsonred, anchor=south] at (3.15,-1.15) {損害};
  % ファーム：締切後は価値ゼロ
  \begin{scope}[xshift=5.4cm]
    \draw[val] (0,1.2) -- (2.2,1.2);
    \draw[ngval] (2.2,1.2) -- (2.2,0) -- (4.0,0);
    \node[font=\footnotesize\bfseries, text=crimsonred, anchor=south] at (3.15,0.05) {無価値};
  \end{scope}
  % ソフト：締切後は徐々に低下
  \begin{scope}[xshift=10.8cm]
    \draw[val] (0,1.2) -- (2.2,1.2);
    \draw[ngval] (2.2,1.2) .. controls (2.9,1.2) and (3.2,0.25) .. (4.0,0.15);
    \node[font=\footnotesize\bfseries, text=crimsonred, anchor=south west] at (2.9,0.9) {徐々に低下};
  \end{scope}
\end{tikzpicture}
