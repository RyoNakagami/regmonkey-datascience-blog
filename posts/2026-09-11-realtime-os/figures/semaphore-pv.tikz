\begin{algorithm}[name=semaphore-pv]
\caption{セマフォ $S$ による資源 $R$ の利用}
\begin{algorithmic}
\STATE \CALL{P}{$S$} \COMMENT{資源 $R$ を使う前に取得する．使用中なら待ち状態になる}
\STATE $R$ を読み書きする \COMMENT{クリティカルセクション}
\STATE \CALL{V}{$S$} \COMMENT{解放する．待っているタスクがいれば実行可能状態に戻す}
\end{algorithmic}
\end{algorithm}

