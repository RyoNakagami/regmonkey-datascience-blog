#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt, x=1.15cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    rowlabel/.style={font=\small, anchor=east, align=right},
    op/.style={font=\footnotesize\bfseries, text=azureblue, inner sep=1pt},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south west},
  ]
  \newcommand{\use}[3]{\draw[draw=navy, fill=aliceblue, rounded corners=1.5pt] (#1,#3-0.28) rectangle (#2,#3+0.28); \node[font=\footnotesize] at ({(#1+#2)/2},#3) {資源を使用};}
  \newcommand{\wt}[3]{\draw[draw=darkgray, densely dashed, fill=white, rounded corners=1.5pt] (#1,#3-0.28) rectangle (#2,#3+0.28); \node[sig] at ({(#1+#2)/2},#3) {待ち};}
  \newcommand{\cnt}[3]{\draw[draw=navy, fill=white] (#1,-1.28) rectangle (#2,-0.72); \node[font=\footnotesize\bfseries, text=navy] at ({(#1+#2)/2},-1) {#3};}

  \node[ttl] at (-2.2,2.75) {計数セマフォ（初期値 $S = 2$：同時に使える資源が2つ）};
  \node[rowlabel] at (-0.15,2) {タスク A};
  \node[rowlabel] at (-0.15,1) {タスク B};
  \node[rowlabel] at (-0.15,0) {タスク C};
  \node[rowlabel] at (-0.15,-1) {カウンタ $S$};
  \draw[->, draw=navy] (0,-1.55) -- (10.6,-1.55) node[sig, anchor=west] {時間};

  % タスクの帯（B が待たされる）
  \use{1}{5}{2}
  \wt{3}{5}{1}
  \use{5}{9}{1}
  \use{2}{8}{0}
  % P / V 操作
  \foreach \x/\y/\o in {1/2/P, 3/1/P, 2/0/P, 5/2/V, 9/1/V, 8/0/V} {
    \node[op, anchor=south] at (\x,\y+0.28) {\o};
  }
  % カウンタ
  \cnt{0}{1}{2}
  \cnt{1}{2}{1}
  \cnt{2}{8}{0}
  \cnt{8}{9}{1}
  \cnt{9}{10}{2}
  % 注記
  \draw[->, draw=azureblue, line width=1.0pt] (5.05,1.72) -- (5.05,1.32);
  \node[sig, anchor=west, text=azureblue, align=left] at (5.3,2.0) {A の V 操作で，待ち行列にいる B を起こす\\（B が資源を引き継ぐ）};
  \node[sig, anchor=east, text=darkgray] at (2.9,1.0) {$S = 0$ なので待ち行列へ};
  \node[sig, anchor=north, text=darkgray] at (6.6,-1.85) {B を起こしたので $S$ は 0 のまま};
  \draw[->, draw=darkgray] (6.6,-1.9) -- (6.0,-1.32);
\end{tikzpicture}
