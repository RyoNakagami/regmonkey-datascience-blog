#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south west},
  ]
  % ---- 上段：ポーリングの周期 ----
  \node[ttl] at (-0.2,4.55) {(a) ポーリングの順番（1つの装置に 10 ミリ秒ずつ）};
  \foreach \s/\a/\b/\dev [count=\i] in {0/①/②/入金部, 3.6/③/④/出金部, 7.2/⑤/⑥/印刷部, 10.8/①/②/入金部} {
    \draw[draw=navy, fill=aliceblue] (\s+0.2,3.0) rectangle (\s+0.9,3.6);
    \node[font=\footnotesize] at (\s+0.55,3.3) {\a};
    \draw[draw=navy, fill=white] (\s+1.1,3.0) rectangle (\s+1.8,3.6);
    \node[font=\footnotesize] at (\s+1.45,3.3) {\b};
    \node[sig, anchor=west] at (\s+1.85,3.3) {\dev};
  }
  \foreach \s in {0, 3.6, 7.2} {
    \draw[|<->|, draw=navy] (\s,4.0) -- (\s+3.6,4.0) node[midway, above, sig, text=navy] {10 ミリ秒};
  }
  \draw[->, draw=navy] (0,2.8) -- (14.6,2.8) node[sig, anchor=west] {時間};
  \node[sig, anchor=north west, align=left] at (0,2.75) {① ③ ⑤：制御部 → 各部　② ④ ⑥：各部 → 制御部};
  % 拡大の補助線
  \draw[draw=paleskyblue, line width=1.2pt, rounded corners=2pt] (7.1,2.9) rectangle (10.9,4.4);
  \node[sig, anchor=north, text=azureblue] at (9.0,2.75) {\textbf{(b) で拡大}};

  % ---- 下段：最悪ケースの ⑤⑥ の区間 ----
  \node[ttl] at (-0.2,1.25) {(b) 印刷部の区間（⑤⑥）の最悪ケース};
  \draw[draw=navy, fill=aliceblue, rounded corners=1.5pt] (0,0.1) rectangle (7.8,0.85);
  \node[font=\footnotesize] at (3.9,0.475) {⑤ 制御部 → 印刷部：894 バイト};
  \draw[draw=darkgray, densely dashed, fill=white, rounded corners=1.5pt] (7.8,0.1) rectangle (10.2,0.85);
  \node[sig] at (9.0,0.475) {印刷部の処理\\750 μs};
  \draw[draw=navy, fill=white, rounded corners=1.5pt] (10.2,0.1) rectangle (11.4,0.85);
  \node[font=\footnotesize] at (10.8,0.475) {⑥ 6 B};
  \draw[draw=darkgray, densely dashed, fill=white, rounded corners=1.5pt] (11.4,0.1) rectangle (13.2,0.85);
  \node[sig] at (12.3,0.475) {制御部の\\処理 250 μs};
  \draw[->, draw=navy, line width=1.1pt] (13.2,1.25) -- (13.2,0.9);
  \node[sig, anchor=west, text=navy] at (13.3,1.1) {\textbf{① 入金部へ送信開始}};

  % 10 ms の制約
  \draw[|<->|, draw=navy] (0,-0.25) -- (13.2,-0.25)
    node[midway, below, sig, text=navy] {\textbf{この区間全体を 10 ミリ秒以内に収める}};
  \draw[|<->|, draw=azureblue] (0,-1.05) -- (7.8,-1.05)
    node[midway, below, sig, text=azureblue] {894 × 10 = 8940 ビット};
  \draw[|<->|, draw=azureblue] (10.2,-1.05) -- (11.4,-1.05)
    node[midway, below, sig, text=azureblue] {60 ビット};
  \node[sig, anchor=north, align=center] at (6.6,-1.65)
    {送信するビット数：8940 + 60 = 9000 ビット\qquad 送信に使える時間：10 ミリ秒 − 750 μs − 250 μs = 9 ミリ秒\\（区間の長さは模式的）};
\end{tikzpicture}
