#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=1.8mm]}, font=\small, line width=0.7pt, x=0.95cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small, anchor=east, align=right},
  ]
  \newcommand{\job}[4]{\draw[draw=navy, fill=#4, rounded corners=1.5pt] (#1,#3-0.28) rectangle (#2,#3+0.28);}
  \newcommand{\rel}[2]{\draw[->, draw=navy, line width=0.9pt] (#1,#2-0.3) -- (#1,#2+0.45);}
  % 行ラベル
  \node[rowlabel] at (-0.2,2.4) {$\tau_1$\quad{\footnotesize\color{darkgray}$C_1=1,\ T_1=4$（優先度 高）}};
  \node[rowlabel] at (-0.2,1.2) {$\tau_2$\quad{\footnotesize\color{darkgray}$C_2=2,\ T_2=6$（優先度 中）}};
  \node[rowlabel] at (-0.2,0)   {$\tau_3$\quad{\footnotesize\color{darkgray}$C_3=3,\ T_3=12$（優先度 低）}};
  % 補助線
  \foreach \y in {0,1.2,2.4} { \draw[draw=lightgray] (0,\y-0.28) -- (12.4,\y-0.28); }
  % 時間軸
  \draw[->, draw=navy] (0,-0.75) -- (12.7,-0.75) node[sig, anchor=west] {時間};
  \foreach \t in {0,...,12} { \draw[draw=navy] (\t,-0.75) -- (\t,-0.85); \node[sig, anchor=north] at (\t,-0.85) {\t}; }
  % リリース（周期の始まり ＝ 前のジョブのデッドライン）
  \foreach \t in {0,4,8,12} { \rel{\t}{2.4} }
  \foreach \t in {0,6,12} { \rel{\t}{1.2} }
  \foreach \t in {0,12} { \rel{\t}{0} }
  % 実行
  \job{0}{1}{2.4}{paleskyblue} \job{4}{5}{2.4}{paleskyblue} \job{8}{9}{2.4}{paleskyblue}
  \job{1}{3}{1.2}{aliceblue} \job{6}{8}{1.2}{aliceblue}
  \job{3}{4}{0}{white} \job{5}{6}{0}{white} \job{9}{10}{0}{white}
  % 注記
  \node[font=\footnotesize\bfseries, text=azureblue] at (4.5,0) {中断};
  \node[font=\footnotesize\bfseries, text=azureblue] at (7.5,0) {中断};
  \node[font=\footnotesize\bfseries, text=navy, anchor=west] at (10.1,0) {完了 ✓};
  \node[sig, anchor=north west] at (0,-1.35) {↑ はジョブの到着（リリース）．次の ↑ がそのジョブのデッドライン};
\end{tikzpicture}
