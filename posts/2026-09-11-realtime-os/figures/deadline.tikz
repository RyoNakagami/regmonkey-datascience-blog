#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    bar/.style={draw=navy, fill=aliceblue, rounded corners=2pt, minimum height=0.75cm},
    ngbar/.style={draw=crimsonred, fill=mistyrose, rounded corners=2pt, minimum height=0.75cm},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small\bfseries, anchor=east},
  ]
  % 時間軸
  \draw[->, draw=navy] (0,-0.2) -- (11.6,-0.2) node[sig, anchor=north east, yshift=-2pt] {時間};
  % イベント発生
  \draw[->, draw=navy, line width=1.1pt] (0,4.3) -- (0,3.55);
  \node[font=\small\bfseries, text=navy, anchor=south] at (0,4.3) {入力（イベント発生）};
  \draw[draw=lightgray, dashed] (0,3.5) -- (0,-0.2);
  % デッドライン
  \draw[draw=navy, densely dashed, line width=1.1pt] (8,4.0) -- (8,-0.2);
  \node[font=\small\bfseries, text=navy, anchor=south] at (8,4.0) {デッドライン};
  % 制限時間
  \draw[<->, draw=azureblue] (0,3.1) -- (8,3.1)
    node[midway, above, font=\footnotesize\bfseries, text=azureblue] {制限時間 $D$};
  % OK 行
  \node[rowlabel, text=navy] at (-0.3,2.0) {間に合う};
  \node[bar, minimum width=5.6cm, anchor=west] (ok) at (0,2.0) {処理};
  \draw[->, draw=navy, line width=1.1pt] (5.6,2.0) -- (6.5,2.0);
  \node[font=\small\bfseries, text=navy, anchor=west] at (6.5,2.0) {応答 ✓};
  % NG 行
  \node[rowlabel, text=crimsonred] at (-0.3,0.65) {間に合わない};
  \node[ngbar, minimum width=9.6cm, anchor=west] (ng) at (0,0.65) {処理};
  \draw[->, draw=crimsonred, line width=1.1pt] (9.6,0.65) -- (10.2,0.65);
  \node[font=\small\bfseries, text=crimsonred, anchor=west] at (10.2,0.65) {応答 ×};
  \node[sig, text=crimsonred, anchor=south east] at (11.4,1.05) {結果が正しくても失敗};
\end{tikzpicture}
