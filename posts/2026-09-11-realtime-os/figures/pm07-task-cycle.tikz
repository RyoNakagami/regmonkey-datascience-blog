#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt, x=0.95cm, y=1.0cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small, anchor=east, align=right},
  ]
  % 実行中（塗り），実行可能（実線白），待ち（破線白）
  \newcommand{\run}[4]{\draw[draw=navy, fill=#3, rounded corners=1.5pt] (#1,#4-0.28) rectangle (#2,#4+0.28);}
  \newcommand{\rdy}[3]{\draw[draw=darkgray, fill=white, rounded corners=1.5pt] (#1,#3-0.28) rectangle (#2,#3+0.28); \node[sig] at ({(#1+#2)/2},#3) {実行可能};}
  \newcommand{\wt}[3]{\draw[draw=darkgray, densely dashed, fill=white, rounded corners=1.5pt] (#1,#3-0.28) rectangle (#2,#3+0.28); \node[sig] at ({(#1+#2)/2},#3) {待ち};}
  % クロック制御タスクが実行状態の区間を強調
  \foreach \a/\b in {3.5/10, 12/14} {
    \draw[draw=paleskyblue, fill=none, rounded corners=3pt, line width=1.2pt] (\a,-0.45) rectangle (\b,3.45);
  }
  \node[font=\footnotesize\bfseries, text=azureblue, anchor=south] at (6.75,3.45) {クロック制御タスクが実行状態 ⇒ ほかは全て待ち};
  \node[font=\footnotesize\bfseries, text=azureblue, anchor=south] at (13,3.45) {同上};
  % 行ラベル
  \node[rowlabel] at (-0.15,3) {タスク A\\[-1pt]{\footnotesize\color{darkgray}優先度：高}};
  \node[rowlabel] at (-0.15,2) {タスク B\\[-1pt]{\footnotesize\color{darkgray}優先度：中}};
  \node[rowlabel] at (-0.15,1) {クロック制御タスク\\[-1pt]{\footnotesize\color{darkgray}優先度：最低}};
  \node[rowlabel] at (-0.15,0) {割込み処理};
  \draw[->, draw=navy] (0,-0.6) -- (14.6,-0.6) node[sig, anchor=west] {時間};
  % タスク A
  \run{0}{2}{aliceblue}{3} \node[font=\footnotesize] at (1,3) {実行};
  \wt{2}{10}{3}
  \run{10}{12}{aliceblue}{3} \node[font=\footnotesize] at (11,3) {実行};
  \wt{12}{14}{3}
  % タスク B
  \rdy{0}{2}{2}
  \run{2}{3.5}{aliceblue}{2} \node[font=\footnotesize] at (2.75,2) {実行};
  \wt{3.5}{14}{2}
  % クロック制御タスク
  \rdy{0}{3.5}{1}
  \run{3.5}{4.5}{paleskyblue}{1} \node[font=\footnotesize] at (4,1) {①②};
  \draw[draw=navy, densely dashed, fill=white, rounded corners=1.5pt] (4.5,0.72) rectangle (9,1.28);
  \node[sig] at (6.75,1) {MPU 停止（アイドル／スタンバイ）};
  \rdy{10}{12}{1}
  \run{12}{13}{paleskyblue}{1} \node[font=\footnotesize] at (12.5,1) {①②};
  \draw[draw=navy, densely dashed, fill=white, rounded corners=1.5pt] (13,0.72) rectangle (14,1.28);
  % 割込み処理
  \draw[->, draw=navy, line width=1.1pt] (9,-0.15) ++(0,0.75) -- (9,0.32);
  \run{9}{10}{aliceblue}{0} \node[font=\footnotesize] at (9.5,0) {処理};
  \node[sig, anchor=east, text=navy] at (8.9,0.2) {\textbf{割込み発生}};
  % メール送信 → A が実行可能 → 最高優先度なので即実行
  \draw[->, draw=azureblue, line width=1.0pt] (9.7,0.28) .. controls (9.9,1.5) and (10.3,2.0) .. (10.35,2.7);
  \node[font=\footnotesize, text=azureblue, anchor=west] at (10.05,0) {A へメール送信};
  % 受信要求
  \foreach \x/\y in {2/3, 3.5/2, 12/3} {
    \node[sig, anchor=south, font=\scriptsize] at (\x,\y+0.28) {受信要求};
  }
\end{tikzpicture}
