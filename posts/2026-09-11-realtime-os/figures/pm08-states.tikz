#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    state/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=2.6cm, minimum height=1.1cm, font=\small\bfseries},
    accent/.style={state, fill=paleskyblue},
    ng/.style={state, draw=crimsonred, fill=mistyrose, text=crimsonred},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[state]  (ok)  at (0,0)     {利用可};
  \node[accent] (ex)  at (8,0)     {両替状態};
  \node[ng]     (ng)  at (4,-3.6)  {利用不可};

  % 利用可 → 両替状態
  \draw[wire] (ok.north east) to[bend left=18]
    node[midway, above, sig] {1枚目の外貨紙幣を挿入（入金部から挿入通知）} (ex.north west);
  % 両替状態 → 利用可
  \draw[wire] (ex.west) -- (ok.east)
    node[midway, above, sig] {両替完了（異常なし）}
    node[midway, below, sig, text=azureblue] {\textbf{3分間 1枚も格納しない（タイマ）}};
  % 両替状態 → 利用不可
  \draw[wire] (ex.south) to[bend left=15]
    node[pos=0.55, right=3pt, sig] {両替完了（異常あり）\\格納不可・日本円 10 万円未満\\・用紙不足のどれか} (ng.east);
  % 利用不可 → 利用可
  \draw[wire] (ng.west) to[bend left=15]
    node[pos=0.45, left=3pt, sig] {保守作業で\\全事象を解決} (ok.south);
  % 自己ループ
  \draw[wire] (ex.north east) to[out=40, in=-40, looseness=4] (ex.south east);
  \node[sig, anchor=west] at (10.45,0) {外貨紙幣を挿入\\→ 識別して格納\\　または入金口に返却};
  \draw[wire] (ok.south west) to[out=220, in=140, looseness=4] (ok.north west);
  \node[sig, anchor=east] at (-2.45,0) {両替レートを\\定期的に更新};

  % 注記
  \node[sig, anchor=north, align=left] at (4,-4.7)
    {※ 両替完了：両替ボタンへのタッチ後，明細書の印刷・排出と日本円の出金がすべて完了した時点\\
     ※ 両替完了時に，管理サーバへ利用可／利用不可を報告する\\
     ※ 両替レートは両替状態を解除するときに更新する（両替状態の間は更新しない）};
\end{tikzpicture}
