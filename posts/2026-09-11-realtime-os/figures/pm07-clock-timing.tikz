#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt, x=1.15cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small, anchor=east, align=right},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south west},
  ]
  \newcommand{\seg}[3]{\draw[draw=navy, fill=#3, rounded corners=1.5pt] (#1,-0.3) rectangle (#2,0.3);}
  \newcommand{\offseg}[2]{\draw[draw=darkgray, densely dashed, fill=white, rounded corners=1.5pt] (#1,-0.3) rectangle (#2,0.3);}
  \foreach \yo/\tt/\ev in {0/(a) タイマ割込みの $T$ ミリ秒前に発振を再開した場合/{（$T$ ミリ秒前を検知）},
                           -4.4/(b) ほかの割込みで発振を再開した場合/{（ほかの割込みを検知）}} {
    \begin{scope}[yshift=\yo cm]
      \node[ttl] at (-1.6,2.05) {\tt};
      \node[rowlabel] at (-0.15,0) {MPU};
      \draw[->, draw=navy] (0,-0.55) -- (11.6,-0.55) node[sig, anchor=west] {時間};
      % 帯
      \seg{0}{1}{aliceblue} \node[font=\footnotesize] at (0.5,0) {①②};
      \offseg{1}{6} \node[sig] at (3.5,0) {クロック発振停止（スタンバイ）};
      \offseg{6}{9} \node[sig] at (7.5,0) {発振安定待ち};
      \seg{9}{11}{paleskyblue} \node[font=\footnotesize] at (10,0) {割込み処理};
      % 時刻ラベル
      \foreach \x/\lab in {1/停止指示, 6/発振再開, 9/MPU へクロック供給} {
        \draw[draw=navy] (\x,-0.55) -- (\x,-0.65);
        \node[sig, anchor=north] at (\x,-0.65) {\lab};
      }
      \node[sig, anchor=north, align=center] at (6,-1.0) {\ev};
      % T ミリ秒
      \draw[<->, draw=navy] (6,0.55) -- (9,0.55) node[midway, above, sig, text=navy] {$T$ ミリ秒};
    \end{scope}
  }
  % (a) タイマ割込みは MPU へのクロック供給と同時刻
  \draw[->, draw=navy, line width=1.1pt] (6,1.75) -- (6,1.2);
  \node[sig, anchor=east, text=navy, align=right] at (5.95,1.5) {\textbf{タイマ割込みの $T$ ミリ秒前を検知}\\タイマは別クロックで計時しているので割込み時刻が事前にわかる};
  \draw[->, draw=navy, line width=1.1pt] (9,1.75) -- (9,1.2);
  \node[sig, anchor=south, text=navy] at (9,1.75) {\textbf{タイマ割込み発生}};
  \node[font=\footnotesize\bfseries, text=navy, anchor=west] at (9.1,1.45) {遅延なし ✓};
  % (b) ほかの割込みは発振再開の時刻 → 処理は T 遅れる
  \begin{scope}[yshift=-4.4cm]
    \draw[->, draw=crimsonred, line width=1.1pt] (6,1.75) -- (6,1.2);
    \node[sig, anchor=east, text=crimsonred] at (5.95,1.6) {\textbf{ほかの割込みを検知}};
    \draw[->, draw=crimsonred] (6,1.05) -- (9,1.05);
    \draw[->, draw=crimsonred, line width=1.1pt] (9,1.75) -- (9,1.2);
    \node[font=\footnotesize\bfseries, text=crimsonred, anchor=west] at (9.1,1.45) {$T$ ミリ秒の遅延 ×};
    \node[sig, anchor=south, text=crimsonred] at (9,1.75) {処理開始};
  \end{scope}
\end{tikzpicture}
