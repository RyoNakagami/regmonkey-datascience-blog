#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.0mm]}, font=\small, line width=0.7pt, x=0.9cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small, anchor=east},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south west},
    chip/.style={draw=navy, rounded corners=1.5pt, minimum width=0.6cm, minimum height=0.4cm},
  ]
  \newcommand{\run}[3]{\draw[draw=navy, fill=aliceblue, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3);}
  \newcommand{\crit}[3]{\draw[draw=navy, fill=paleskyblue, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3); \node[font=\footnotesize] at ({(#1+#2)/2},#3) {R};}
  \newcommand{\blk}[3]{\draw[draw=crimsonred, densely dashed, fill=mistyrose, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3);}
  \newcommand{\wt}[3]{\draw[draw=darkgray, densely dashed, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3);}
  \newcommand{\arr}[2]{\draw[->, draw=navy, line width=1.0pt] (#1,#2+0.85) -- (#1,#2+0.35);}
  % 凡例
  \node[chip, fill=aliceblue] (c1) at (0.4,6.55) {};
  \node[sig, anchor=west] at (c1.east) {通常の処理};
  \node[chip, fill=paleskyblue] (c2) at (3.4,6.55) {};
  \node[sig, anchor=west] at (c2.east) {共有資源 R を使用中（ロック保持）};
  \node[chip, draw=crimsonred, densely dashed, fill=mistyrose] (c3) at (9.6,6.55) {};
  \node[sig, anchor=west] at (c3.east) {R の解放待ち（ブロック）};
  \foreach \yo/\tt in {3.0/(a) 優先度逆転, -1.6/(b) 優先度継承で解決} {
    \begin{scope}[yshift=\yo cm]
      \node[ttl] at (-2.0,2.55) {\tt};
      \node[rowlabel] at (-0.15,1.8) {H（高）};
      \node[rowlabel] at (-0.15,0.9) {M（中）};
      \node[rowlabel] at (-0.15,0) {L（低）};
      \draw[->, draw=navy] (0,-0.5) -- (12.7,-0.5) node[sig, anchor=west] {時間};
      \foreach \t in {0,2,...,12} { \draw[draw=navy] (\t,-0.5) -- (\t,-0.6); \node[sig, anchor=north] at (\t,-0.6) {\t}; }
      \draw[draw=navy, densely dashed, line width=1.0pt] (8,2.4) -- (8,-0.5);
      \node[sig, text=navy, anchor=south] at (8,2.4) {H のデッドライン};
      \arr{2}{1.8} \arr{4}{0.9}
    \end{scope}
  }
  % (a) 優先度逆転
  \begin{scope}[yshift=3.0cm]
    \run{0}{1}{0} \crit{1}{2}{0} \crit{3}{4}{0} \crit{8}{9}{0} \run{11}{12}{0}
    \run{2}{3}{1.8} \blk{3}{9}{1.8} \crit{9}{11}{1.8}
    \node[font=\footnotesize, text=crimsonred] at (6,1.8) {R 待ち};
    \draw[draw=crimsonred, fill=mistyrose, rounded corners=1.5pt] (4,0.6) rectangle (8,1.2);
    \node[font=\footnotesize\bfseries, text=crimsonred] at (6,0.9) {M が割り込む};
    \node[font=\footnotesize\bfseries, text=crimsonred, anchor=west] at (11.1,1.8) {締切超過 ×};
  \end{scope}
  % (b) 優先度継承
  \begin{scope}[yshift=-1.6cm]
    \run{0}{1}{0} \crit{1}{2}{0} \crit{3}{5}{0} \run{11}{12}{0}
    \run{2}{3}{1.8} \blk{3}{5}{1.8} \crit{5}{7}{1.8}
    \wt{4}{7}{0.9} \node[sig] at (5.5,0.9) {待ち};
    \run{7}{11}{0.9}
    \node[font=\footnotesize\bfseries, text=azureblue, anchor=west, align=left] at (5.1,0) {← H の優先度を\\\phantom{← }継承して実行};
    \node[font=\footnotesize\bfseries, text=navy, anchor=west] at (8.1,1.8) {締切内 ✓};
  \end{scope}
\end{tikzpicture}
