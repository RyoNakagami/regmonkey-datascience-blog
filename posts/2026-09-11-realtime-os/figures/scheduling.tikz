#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt, x=1.15cm,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\small, anchor=east, align=right},
    ttl/.style={font=\small\bfseries, text=navy, anchor=south west},
  ]
  \newcommand{\seg}[4]{\draw[draw=navy, fill=#4, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3);}
  \newcommand{\ngseg}[3]{\draw[draw=crimsonred, fill=mistyrose, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3);}
  \newcommand{\waitseg}[3]{\draw[draw=darkgray, densely dashed, rounded corners=1.5pt] (#1,#3-0.3) rectangle (#2,#3+0.3); \node[sig] at ({(#1+#2)/2},#3) {待ち};}
  \foreach \yo/\tt in {0/(a) ラウンドロビン（タイムクォンタム 4）, -4.6/(b) 優先度ベースのプリエンプティブ} {
    \begin{scope}[yshift=\yo cm]
      \node[ttl] at (-2.6,2.35) {\tt};
      \node[rowlabel] at (-0.15,0.9) {タスク H\\[-1pt]{\footnotesize\color{darkgray}高優先：ブレーキ制御}};
      \node[rowlabel] at (-0.15,0) {タスク L\\[-1pt]{\footnotesize\color{darkgray}低優先：ログ保存}};
      \draw[->, draw=navy] (0,-0.55) -- (8.6,-0.55) node[sig, anchor=west] {時間};
      \foreach \t in {0,...,8} { \draw[draw=navy] (\t,-0.55) -- (\t,-0.65); \node[sig, anchor=north] at (\t,-0.65) {\t}; }
      % イベントとデッドライン
      \draw[->, draw=navy, line width=1.1pt] (2,1.75) -- (2,1.25);
      \node[sig, anchor=south, text=navy] at (2,1.75) {センサ入力};
      \draw[draw=navy, densely dashed, line width=1.1pt] (5,1.5) -- (5,-0.55);
      \node[sig, anchor=south, text=navy] at (5,1.5) {デッドライン};
    \end{scope}
  }
  % (a) ラウンドロビン
  \seg{0}{4}{0}{aliceblue} \node at (2,0) {L};
  \waitseg{2}{4}{0.9}
  \ngseg{4}{6}{0.9} \node[text=crimsonred] at (5.5,0.9) {H};
  \seg{6}{8}{0}{aliceblue} \node at (7,0) {L};
  \node[font=\footnotesize\bfseries, text=crimsonred, anchor=west] at (6.1,0.9) {締切超過 ×};
  % (b) 優先度プリエンプティブ
  \begin{scope}[yshift=-4.6cm]
    \seg{0}{2}{0}{aliceblue} \node at (1,0) {L};
    \seg{2}{4}{0.9}{paleskyblue} \node at (3,0.9) {H};
    \seg{4}{8}{0}{aliceblue} \node at (6,0) {L};
    \node[font=\footnotesize\bfseries, text=navy, anchor=west] at (5.15,0.9) {締切内 ✓};
  \end{scope}
\end{tikzpicture}
