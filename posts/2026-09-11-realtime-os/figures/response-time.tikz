#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    seg/.style={draw=navy, rounded corners=1.5pt, minimum height=0.9cm, anchor=west, align=center, inner sep=2pt},
  ]
  % 区間: 0-2.4 割込み, 2.4-5.0 ディスパッチ, 5.0-10.6 処理, deadline 12.2
  \node[seg, fill=paleskyblue, minimum width=2.4cm] at (0,0) {割込み\\[-1pt]レイテンシ};
  \node[seg, fill=paleskyblue, minimum width=2.6cm] at (2.4,0) {ディスパッチ\\[-1pt]レイテンシ};
  \node[seg, fill=aliceblue, minimum width=5.6cm] at (5.0,0) {タスクの処理時間};
  % イベント・応答
  \draw[->, draw=navy, line width=1.1pt] (0,1.55) -- (0,0.5);
  \node[font=\small\bfseries, text=navy, anchor=south] at (0,1.55) {イベント発生};
  \draw[->, draw=navy, line width=1.1pt] (10.6,0) -- (11.3,0);
  \node[font=\small\bfseries, text=navy, anchor=west] at (11.3,0) {応答};
  % デッドライン
  \draw[draw=navy, densely dashed, line width=1.1pt] (12.6,1.55) -- (12.6,-2.4);
  \node[font=\small\bfseries, text=navy, anchor=south] at (12.6,1.55) {デッドライン};
  % 各区間の説明
  \node[sig, align=center, anchor=north] at (1.2,-0.6) {割込みハンドラが\\動き出すまで};
  \node[sig, align=center, anchor=north] at (3.7,-0.6) {待っていたタスクに\\切り替わるまで};
  \node[sig, align=center, anchor=north] at (7.8,-0.6) {最悪実行時間（WCET）で見積もる};
  % 責任範囲
  \draw[|<->|, draw=azureblue] (0,-1.75) -- (5.0,-1.75)
    node[midway, below, font=\footnotesize\bfseries, text=azureblue] {RTOS が上限を保証する部分};
  \draw[|<->|, draw=azureblue] (5.0,-1.75) -- (10.6,-1.75)
    node[midway, below, font=\footnotesize\bfseries, text=azureblue] {アプリケーションが見積もる部分};
  \draw[<->, draw=navy] (0,0.95) -- (10.6,0.95)
    node[midway, above, font=\footnotesize] {応答時間 $R$};
\end{tikzpicture}
