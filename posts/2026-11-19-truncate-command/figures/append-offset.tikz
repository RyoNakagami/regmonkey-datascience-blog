#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    rowlabel/.style={anchor=east, align=right},
    note/.style={font=\footnotesize, text=darkgray, anchor=west, align=left},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
  ]
  % 横軸：0 〜 10 が旧ファイルの 0 〜 50 MB に対応

  % ---------- 行1：O_APPEND あり ----------
  \node[rowlabel] at (-0.4, 0) {O\_APPEND あり\\{\footnotesize\color{darkgray}>> で open．rsyslog など}};
  \draw[draw=lightgray] (0,-0.35) rectangle (10,0.35);
  \draw[draw=navy, fill=paleskyblue] (0,-0.35) rectangle (1.3,0.35);
  \node at (0.65,0) {\footnotesize 新ログ};
  \draw[->, draw=azureblue] (0.65,0.95) -- (0.65,0.4);
  \node[step, anchor=south] at (0.65,0.95) {次の write はファイル末尾 = 先頭へ};
  \node[note] at (10.3,0) {サイズ：新ログ分だけ};

  % ---------- 行2：O_APPEND なし ----------
  \node[rowlabel] at (-0.4,-2.2) {O\_APPEND なし\\{\footnotesize\color{darkgray}> で open}};
  \draw[draw=darkgray, dashed, fill=white] (0,-2.55) rectangle (8.7,-1.85);
  \node[text=darkgray] at (4.35,-2.2) {\footnotesize ホール（読むと 0 バイト．ディスクは使わない）};
  \draw[draw=crimsonred, fill=mistyrose] (8.7,-2.55) rectangle (10,-1.85);
  \node at (9.35,-2.2) {\footnotesize 新ログ};
  \draw[->, draw=crimsonred] (9.35,-1.25) -- (9.35,-1.8);
  \node[font=\footnotesize\bfseries, text=crimsonred, anchor=south] at (9.35,-1.25) {古い offset から書き続ける};
  \node[note] at (10.3,-2.0) {見かけのサイズ：50 MB のまま};
  \node[note] at (10.3,-2.45) {実使用量：4 KB 程度};

  % ---------- 軸 ----------
  \draw[draw=darkgray] (0,-3.1) -- (10,-3.1);
  \foreach \x/\t in {0/offset 0, 10/truncate 前の offset（50 MB）} {
    \draw[draw=darkgray] (\x,-3.0) -- (\x,-3.2);
    \node[font=\footnotesize, text=darkgray, anchor=north] at (\x,-3.25) {\t};
  }
\end{tikzpicture}
