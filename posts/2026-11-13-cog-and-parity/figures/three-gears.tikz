#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
% \gear{x}{y}{pitch radius}{teeth}{phase}
\newcommand{\gear}[5]{
  \draw[navy, fill=aliceblue, shift={(#1,#2)}, domain=0:360, samples=600, smooth]
    plot ({(#3+0.09*tanh(3*sin(#4*\x+#5)))*cos(\x)}, {(#3+0.09*tanh(3*sin(#4*\x+#5)))*sin(\x)}) -- cycle;
  \draw[navy, fill=white] (#1,#2) circle (0.1);
}
\begin{tikzpicture}[font=\small, line width=0.7pt, every node/.style={text=fontblack}, >={Latex[length=3mm, width=2.6mm]}]
  \gear{0.0000}{0.0000}{1.125}{15}{90.0000}
  \gear{2.2500}{0.0000}{1.125}{15}{90.0000}
  \gear{1.1250}{1.9486}{1.125}{15}{90.0000}
  \draw[->, azureblue, line width=1.1pt] (0.6578,0.2394) arc[start angle=20, end angle=300, radius=0.7];
  \draw[->, azureblue, line width=1.1pt] (1.5922,0.2394) arc[start angle=160, end angle=-120, radius=0.7];
  \draw[->, crimsonred, line width=1.1pt] (0.4484,1.7023) arc[start angle=200, end angle=340, radius=0.72];
  \draw[->, crimsonred, line width=1.1pt] (0.4484,2.1948) arc[start angle=160, end angle=20, radius=0.72];
  \node[font=\bfseries] at (-0.3000,-0.3000) {A};
  \node[font=\bfseries] at (2.5500,-0.3000) {B};
  \node[font=\bfseries] at (1.1250,1.5886) {C};
  \node[font=\footnotesize, align=center] at (0.0000,-1.6000) {反時計回り};
  \node[font=\footnotesize, align=center] at (2.2500,-1.6000) {時計回り};
  \node[font=\footnotesize, align=left, anchor=west, text=crimsonred] at (2.5750,2.1986) {A から見ると時計回り（上の矢印）};
  \node[font=\footnotesize, align=left, anchor=west, text=crimsonred] at (2.5750,1.6986) {B から見ると反時計回り（下の矢印）};
\end{tikzpicture}
