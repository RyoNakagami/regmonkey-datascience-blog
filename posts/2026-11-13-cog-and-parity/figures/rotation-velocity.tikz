#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[font=\small, line width=0.8pt, every node/.style={text=fontblack},
    >={Latex[length=2.8mm, width=2.2mm]}]
  % circular path of x
  \draw[darkgray, dashed] (0,0) circle (2);
  % rotation direction (omega > 0)
  \draw[->, darkgray, line width=1pt] ({2.35*cos(-55)},{2.35*sin(-55)}) arc[start angle=-55, end angle=-15, radius=2.35];
  \node[font=\footnotesize, text=darkgray, anchor=west] at ({2.4*cos(-38)+0.05},{2.4*sin(-38)}) {$\omega > 0$（反時計回り）};
  % 90 degree arc at O
  \draw[azureblue] ({0.6*cos(35)},{0.6*sin(35)}) arc[start angle=35, end angle=125, radius=0.6];
  \node[font=\footnotesize, text=azureblue] at ({0.85*cos(80)},{0.85*sin(80)}) {$90^\circ$};
  % J(x - O) drawn from O
  \draw[->, azureblue, dashed] (0,0) -- (-1.147,1.638);
  \node[font=\footnotesize, text=azureblue, anchor=east] at (-1.2,1.7) {$J(\mathbf{x}-O)$};
  % position vector
  \draw[->, navy, line width=1.1pt] (0,0) -- (1.638,1.147);
  \node[font=\footnotesize, text=navy, anchor=north west] at (0.85,0.55) {$\mathbf{x}-O$};
  % right angle mark at x
  \draw[darkgray, line width=0.6pt] (1.433,1.004) -- (1.290,1.209) -- (1.495,1.352);
  % velocity vector at x
  \draw[->, azureblue, line width=1.3pt] (1.638,1.147) -- (0.778,2.376);
  \node[font=\footnotesize, text=azureblue, anchor=south west] at (0.85,2.4) {$\mathbf{v}(\mathbf{x}) = \omega\,J(\mathbf{x}-O)$};
  % points
  \fill[navy] (0,0) circle (0.07);
  \node[anchor=north east, text=navy] at (-0.05,-0.05) {$O$};
  \fill[navy] (1.638,1.147) circle (0.07);
  \node[anchor=north west, text=navy] at (1.7,1.1) {$\mathbf{x}$};
\end{tikzpicture}
