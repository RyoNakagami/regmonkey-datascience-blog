#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
% \gear{x}{y}{pitch radius}{teeth}{phase}
\newcommand{\gear}[5]{
  \draw[navy, fill=aliceblue, shift={(#1,#2)}, domain=0:360, samples=600, smooth]
    plot ({(#3+0.09*tanh(3*sin(#4*\x+#5)))*cos(\x)}, {(#3+0.09*tanh(3*sin(#4*\x+#5)))*sin(\x)}) -- cycle;
  \draw[navy, fill=white] (#1,#2) circle (0.12);
}
\begin{tikzpicture}[font=\small, line width=0.7pt, every node/.style={text=fontblack}]
  \gear{0}{0}{1.2}{16}{90}
  \gear{2.1}{0}{0.9}{12}{-90}
  % pitch radii
  \draw[darkgray, dashed] (0,0) -- (1.2,0);
  \draw[darkgray, dashed] (2.1,0) -- (1.2,0);
  \node[font=\footnotesize, text=darkgray, above] at (0.6,0) {$r_A$};
  \node[font=\footnotesize, text=darkgray, above] at (1.68,0) {$r_B$};
  % rotation arrows
  \draw[->, >={Latex[length=2.4mm]}, azureblue, line width=1.1pt]
    ({0.78*cos(30)},{0.78*sin(30)}) arc[start angle=30, end angle=300, radius=0.78];
  \draw[->, >={Latex[length=2.4mm]}, azureblue, line width=1.1pt]
    ({2.1+0.6*cos(150)},{0.6*sin(150)}) arc[start angle=150, end angle=-150, radius=0.6];
  \node[font=\bfseries] at (-0.3,-0.3) {A};
  \node[font=\bfseries] at (2.32,-0.26) {B};
  % contact point and velocity
  \fill[navy] (1.2,0) circle (0.06);
  \draw[->, >={Latex[length=2.4mm]}, navy, line width=1.1pt] (1.2,0) -- (1.2,1.55);
  \node[font=\footnotesize, right] at (1.22,1.45) {$v_P$};
  \node[font=\footnotesize, text=navy, fill=white, inner sep=1pt] at (1.2,-0.36) {$P$};
  % captions
  \node[font=\footnotesize, align=center] at (0,-1.75) {反時計回り\\$\omega_A>0$};
  \node[font=\footnotesize, align=center] at (2.1,-1.75) {時計回り\\$\omega_B<0$};
\end{tikzpicture}
