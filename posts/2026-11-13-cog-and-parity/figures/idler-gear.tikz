#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
% \gear{x}{y}{pitch radius}{teeth}{phase}
\newcommand{\gear}[5]{
  \draw[navy, fill=aliceblue, shift={(#1,#2)}, domain=0:360, samples=600, smooth]
    plot ({(#3+0.09*tanh(3*sin(#4*\x+#5)))*cos(\x)}, {(#3+0.09*tanh(3*sin(#4*\x+#5)))*sin(\x)}) -- cycle;
  \draw[navy, fill=white] (#1,#2) circle (0.1);
}
% \ccw{x}{y}{radius} / \cw{x}{y}{radius}
\newcommand{\ccw}[3]{
  \draw[->, azureblue, line width=1.1pt] ({#1+#3*cos(-60)},{#2+#3*sin(-60)}) arc[start angle=-60, end angle=180, radius=#3];
}
\newcommand{\cw}[3]{
  \draw[->, azureblue, line width=1.1pt] ({#1+#3*cos(60)},{#2+#3*sin(60)}) arc[start angle=60, end angle=-180, radius=#3];
}
\begin{tikzpicture}[font=\small, line width=0.7pt, every node/.style={text=fontblack},
    >={Latex[length=3mm, width=2.6mm]},
    role/.style={font=\footnotesize, align=center},
    title/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray}]
  % ---- left: n = 2
  \gear{0}{0}{1.2}{16}{90}
  \gear{2.1}{0}{0.9}{12}{270}
  \ccw{0}{0}{0.75}
  \cw{2.1}{0}{0.58}
  \node[title] at (1.05,1.95) {$n=2$：直接つなぐ};
  \node[role] at (0,-1.75) {入力 $g_1$\\反時計回り};
  \node[role] at (2.1,-1.75) {出力 $g_2$\\時計回り};
  \node[note] at (1.05,-2.75) {向きは逆：$\omega_2 = -\frac{r_1}{r_2}\,\omega_1$};
  % ---- right: n = 3 with idler
  \gear{6}{0}{1.2}{16}{90}
  \gear{7.95}{0}{0.75}{10}{270}
  \gear{9.6}{0}{0.9}{12}{90}
  \ccw{6}{0}{0.75}
  \cw{7.95}{0}{0.46}
  \ccw{9.6}{0}{0.58}
  \node[title] at (7.8,1.95) {$n=3$：アイドラギアを挟む};
  \node[role] at (6,-1.75) {入力 $g_1$\\反時計回り};
  \node[role] at (7.95,-1.75) {アイドラ $g_2$\\時計回り};
  \node[role] at (9.6,-1.75) {出力 $g_3$\\反時計回り};
  \node[note] at (7.8,-2.75) {向きは同じ：$\omega_3 = \frac{r_1}{r_3}\,\omega_1$（$r_2$ は現れない）};
  % separator
  \draw[lightgray] (4.0,-2.9) -- (4.0,2.1);
\end{tikzpicture}
