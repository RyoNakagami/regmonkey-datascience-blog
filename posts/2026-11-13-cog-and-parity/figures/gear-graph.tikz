#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[font=\small, line width=0.8pt, every node/.style={text=fontblack},
    pos/.style={circle, draw=navy, fill=white, minimum size=0.62cm, inner sep=0pt, font=\bfseries},
    neg/.style={circle, draw=navy, fill=paleskyblue, minimum size=0.62cm, inner sep=0pt, font=\bfseries},
    bad/.style={circle, draw=crimsonred, fill=mistyrose, minimum size=0.62cm, inner sep=0pt, font=\bfseries, text=crimsonred},
    edge/.style={draw=navy},
    oddedge/.style={draw=crimsonred, line width=1.6pt},
  ]
  % ---- left: bipartite (even cycle + tree)
  \node[pos] (a1) at (0,1.4) {$+$};
  \node[neg] (a2) at (1.25,0.7) {$-$};
  \node[pos] (a3) at (1.25,-0.7) {$+$};
  \node[neg] (a4) at (0,-1.4) {$-$};
  \node[pos] (a5) at (-1.25,-0.7) {$+$};
  \node[neg] (a6) at (-1.25,0.7) {$-$};
  \node[neg] (a7) at (2.75,-0.7) {$-$};
  \node[pos] (a8) at (3.5,0.6) {$+$};
  \node[pos] (a9) at (-2.75,0.7) {$+$};
  
  \node[font=\bfseries, text=navy] at (0.35,-2.45) {二部グラフ：回る};
  \node[font=\footnotesize, text=darkgray] at (0.35,-3.0) {隣どうしの符号を交互に割り当てられる};
  % ---- right: contains an odd cycle
  \node[pos] (b1) at (6.4,1.3) {$+$};
  \node[neg] (b2) at (7.9,1.3) {$-$};
  \node[bad] (b3) at (7.15,0.0) {?};
  \node[neg] (b4) at (9.4,0.6) {$-$};
  \node[pos] (b5) at (8.9,-1.2) {$+$};
  \node[pos] (b6) at (5.6,-0.9) {$+$};
  \node[font=\bfseries, text=crimsonred] at (7.5,-2.45) {奇閉路を含む：回らない};
  \node[font=\footnotesize, text=darkgray] at (7.5,-3.0) {長さ 3 の閉路で符号が決まらない};
  \begin{scope}[on background layer]
    \foreach \u/\v in {a1/a2,a2/a3,a3/a4,a4/a5,a5/a6,a6/a1,a3/a7,a7/a8,a6/a9,b2/b4,b4/b5,b5/b3,b3/b6} {\draw[edge] (\u) -- (\v);}
    \foreach \u/\v in {b1/b2,b2/b3,b3/b1} {\draw[oddedge] (\u) -- (\v);}
  \end{scope}
\end{tikzpicture}
