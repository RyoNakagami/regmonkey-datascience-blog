#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    seg/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                font=\footnotesize, minimum height=0.8cm, inner sep=4pt},
    body/.style={seg, fill=paleskyblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
  ]
  \node[seg] (t) {\texttt{Nov 25 15:39:02}};
  \node[seg, right=1.5mm of t] (h) {\texttt{ryo-billiken-Desktop}};
  \node[seg, right=1.5mm of h] (p) {\texttt{gnome-shell[4099]:}};
  \node[body, right=1.5mm of p] (m) {\texttt{Extension tiling-assistant@ubuntu.com: Error: ...}};
  \node[body, anchor=north west] (s) at ($(m.south west)+(0,-1.2)$)
    {\texttt{@file:///usr/share/.../src/extension/tilingWindowManager.js:1323:31}};

  \foreach \n/\s in {t/時刻, h/ホスト名, p/プロセス名[PID], m/本文（メッセージ）} {
    \node[step, above=2mm of \n] {\s};
  }
  \node[note, below=2mm of p] {ログインし直すと\\PID が変わる};
  \node[step, anchor=east] at ($(s.west)+(-0.3,0)$) {スタックトレース};
  \node[note, below=2mm of s] {エラーの発生箇所（ファイル:行:列）};
  \draw[->, draw=navy] ([xshift=6mm]m.south west) -- ([xshift=6mm]s.north west);
\end{tikzpicture}
