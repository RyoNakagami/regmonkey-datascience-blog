#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.3cm, inner sep=5pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[block] (s1) {\texttt{gnome-extensions}\\とは？};
  \node[block, right=0.9cm of s1] (s2) {\texttt{gnome-extensions}\\\texttt{list}};
  \node[block, right=0.9cm of s2] (s3) {install / enable\\disable / uninstall};
  \node[block, right=0.9cm of s3] (s4) {ログの見方\\（journalctl）};
  \node[block, right=0.9cm of s4] (s5) {他のデバイスに\\同じ拡張を設定};
  \foreach \n/\s/\t in {
      s1/Section 1/CLI の概要・UUID\\インストール先,
      s2/Section 2/インストール済みの\\拡張を確認する,
      s3/Section 3/ライフサイクルと\\再ログインの要否,
      s4/Section 4/gnome-shell のログで\\エラーの原因を読む,
      s5/Section 5/書き出し → 導入\\→ 有効化・設定の復元} {
    \node[step, above=2mm of \n] {\s};
    \node[note, below=2mm of \n] {\t};
  }
  \foreach \a/\b in {s1/s2, s2/s3, s3/s4, s4/s5} {
    \draw[wire] (\a) -- (\b);
  }
\end{tikzpicture}
