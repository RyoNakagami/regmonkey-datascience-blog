#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=white, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.0cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    cl/.style={draw=azureblue, line width=1.2pt, dashed, fill=none, rounded corners=6pt, inner sep=10pt},
    cllabel/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize, text=darkgray, align=center, inner sep=2pt},
    wire/.style={->, draw=navy},
    chip/.style={draw=navy, rounded corners=2pt, minimum width=0.7cm, minimum height=0.45cm},
  ]
  % ---------- 登場人物 ----------
  \node[block]  (au) at (0,0)    {著作権者\\（作者）};
  \node[accent] (ra) at (6.5,0)  {受け取った人 A\\（利用者・企業）};
  \node[accent] (rb) at (13.0,0) {A から受け取った人 B\\（A の顧客など）};

  \draw[wire] (au) -- node[above, sig] {ライセンスを付けて\\公開・配布} (ra);
  \draw[wire] (ra) -- node[above, sig] {再配布\\（ライセンスも一緒に渡す）} (rb);

  % ---------- 縛られる範囲 ----------
  \node[cl, fit=(ra)(rb)] (bound) {};
  \node[cllabel, anchor=north] at ([yshift=-1pt]bound.south) {ライセンスの条件に縛られる範囲};

  % ---------- ライセンスは著作権者から直接 ----------
  \draw[->, draw=darkgray, dashed, rounded corners=6pt]
    (au.north) -- ++(0,1.7) -| node[pos=0.25, above, sig]
    {B も追加の契約なしに，著作権者から同じライセンスを受ける} (rb.north);

  % ---------- 補足 ----------
  \node[note, below=1.05cm of au] {自分の著作物なので\\ライセンスに縛られない\\
    {\color{navy}→ 別ライセンスでも出せる}};
  \node[note, below=1.05cm of ra] {使う・改変する：条件なし\\
    {\color{navy}再配布する：条件を守る}};
  \node[note, below=1.05cm of rb] {元のコードは A と同じ権利と条件\\
    {\color{navy}さらに再配布するなら条件を守る}};

  % ---------- 凡例 ----------
  \node[chip, fill=white] (c1) at (2.4,-3.3) {};
  \node[anchor=west, font=\footnotesize] at (c1.east) {権利を持つ人（ライセンスを与える側）};
  \node[chip, fill=paleskyblue] (c2) at (8.6,-3.3) {};
  \node[anchor=west, font=\footnotesize] at (c2.east) {ライセンスを受ける人（条件に縛られる側）};
\end{tikzpicture}
