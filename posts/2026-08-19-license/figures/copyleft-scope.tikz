#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=white, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=2.3cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    panel/.style={draw=navy, fill=none, rounded corners=8pt, inner sep=14pt},
    plabel/.style={anchor=south, font=\large\bfseries, text=navy},
    cl/.style={draw=azureblue, line width=1.2pt, dashed, fill=none, rounded corners=6pt, inner sep=7pt},
    cllabel/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    chip/.style={draw=navy, rounded corners=2pt, minimum width=0.7cm, minimum height=0.45cm},
  ]
  % ---------- GPL ----------
  \node[accent] (g1) at (0,0) {GPLライブラリ\\（改変あり）};
  \node[accent] (g2) at (3.5,0) {自社コード\\main.c};
  \node[accent] (g3) at (7.0,0) {自社コード\\util.c};
  \draw[<->, draw=navy] (g1) -- node[above, font=\scriptsize, text=darkgray] {リンク} (g2);
  \draw[<->, draw=navy] (g2) -- (g3);
  \node[cl, fit=(g1)(g3)] (gcl) {};
  \node[cllabel, anchor=south] at ([yshift=1pt]gcl.north) {コピーレフトの範囲＝プログラム全体};
  \node[panel, fit=(g1)(g3)([yshift=0.55cm]gcl.north)] (gp) {};
  \node[plabel] at (gp.north) {GPL：結合した派生物ごと};
  \node[note, below=0.55cm of g2] {リンクして1つのプログラムになった部分は派生物とみなされる\\
    {\color{navy}→ 配布するなら全体をGPLにしてソースを公開}};

  % ---------- MPL ----------
  \node[accent] (m1) at (11.0,0) {MPLファイル\\lib.c（改変あり）};
  \node[block]  (m2) at (15.0,0) {自社コード\\main.c};
  \node[block]  (m3) at (18.5,0) {自社コード\\util.c};
  \draw[<->, draw=navy] (m1) -- (m2);
  \draw[<->, draw=navy] (m2) -- (m3);
  \node[cl, fit=(m1)] (mcl) {};
  \node[font=\scriptsize, text=darkgray, anchor=south] at ($(mcl.east |- m2)!0.5!(m2.west)+(0,0.05)$) {リンク};
  \node[cllabel, anchor=south] at ([yshift=1pt]mcl.north) {範囲＝MPLのファイルだけ};
  \node[panel, fit=(m1)(m3)([yshift=0.55cm]mcl.north)] (mp) {};
  \node[plabel] at (mp.north) {MPL 2.0：ファイル単位};
  \node[note, below=0.55cm of m2] {MPLのファイルと，そこに書き足したコードだけが対象\\
    {\color{navy}→ 別ファイルの自社コードは非公開・別ライセンスでよい}};

  % ---------- 凡例 ----------
  \node[chip, fill=paleskyblue] (c1) at (5.2,3.6) {};
  \node[anchor=west, font=\footnotesize] at (c1.east) {コピーレフトが及ぶ（同じライセンスで公開）};
  \node[chip, fill=white] (c2) at (12.0,3.6) {};
  \node[anchor=west, font=\footnotesize] at (c2.east) {自由（非公開・別ライセンス可）};
\end{tikzpicture}
