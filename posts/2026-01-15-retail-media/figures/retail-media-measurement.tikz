#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.0cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, dashed},
    rowlabel/.style={font=\bfseries, text=navy, align=center},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    span/.style={|<->|, draw=navy},
    wire/.style={->, draw=navy},
  ]
  % ---- 上段：一般的なデジタル広告 ----
  \node[rowlabel] at (-3.6,0) {一般的な\\デジタル広告};
  \node[sig] at (-3.6,-0.85) {（検索・SNS）};
  \node[block] (a1) at (0,0)  {広告接触};
  \node[block] (a2) at (4,0)  {クリック};
  \node[block] (a3) at (8,0)  {サイト訪問};
  \node[ng]    (a4) at (12,0) {店舗での購買};
  \draw[wire] (a1) -- (a2);
  \draw[wire] (a2) -- (a3);
  \draw[->, draw=crimsonred, dashed] (a3) -- (a4);

  \draw[span] ($(a1.south west)+(0,-0.35)$) -- ($(a3.south east)+(0,-0.35)$)
    node[midway, below, sig] {Cookie・広告IDで計測できる範囲};
  \node[font=\footnotesize, text=crimsonred, below=0.3cm of a4] {計測が途切れる};

  % ---- 区切り線 ----
  \draw[lightgray] (-5,-2.15) -- (13.7,-2.15);

  % ---- 下段：リテールメディア ----
  \node[rowlabel] at (-3.6,-3.3) {リテールメディア};
  \node[sig] at (-3.6,-4.0) {（小売が媒体社）};
  \node[accent] (b1) at (0,-3.3)  {広告接触\\{\footnotesize 店頭・EC・アプリ}};
  \node[accent] (b2) at (4,-3.3)  {クリック・閲覧};
  \node[accent] (b3) at (8,-3.3)  {来店・EC訪問};
  \node[accent] (b4) at (12,-3.3) {購買\\{\footnotesize ID-POS・EC注文}};
  \draw[wire] (b1) -- (b2);
  \draw[wire] (b2) -- (b3);
  \draw[wire] (b3) -- (b4);

  \draw[span] ($(b1.south west)+(0,-0.35)$) -- ($(b4.south east)+(0,-0.35)$)
    node[midway, below, sig] {同じ会員IDで広告接触から購買まで結びつけられる};
\end{tikzpicture}
