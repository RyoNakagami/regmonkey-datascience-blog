#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.2cm, minimum width=3.4cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    slot/.style={block, fill=white, minimum width=4.6cm, minimum height=1.0cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
  ]
  % ---- 主経路 ----
  \node[block] (maker) at (0,0) {\textbf{メーカー}\\（広告主）};
  \node[accent] (retail) at (6,0) {\textbf{小売チェーン}\\（媒体社として広告枠を販売）};

  \node[slot] (s2) at (12.6,0)    {自社EC・アプリ\\検索連動・バナー広告};
  \node[slot] (s1) at (12.6,1.55) {店頭\\サイネージ・売場・チラシ};
  \node[slot] (s3) at (12.6,-1.55){外部メディア（オフサイト）\\購買データで配信};

  \node[block] (shopper) at (18.2,0) {\textbf{買い物客}};

  \begin{scope}[on background layer]
    \node[zone, fit=(s1)(s2)(s3)] (zslot) {};
  \end{scope}
  \node[zlabel] at (zslot.north) {小売が持つ広告枠};

  \draw[wire] (maker) -- node[sig, above] {① 広告費} (retail);
  \draw[wire] (retail) -- node[sig, above] {② 配信} (s2.west -| zslot.west);
  \draw[wire] (zslot.east |- shopper) -- node[sig, above] {接触} (shopper);

  % ---- データと測定（下段） ----
  \node[block] (data) at (6,-3.6) {\textbf{購買データ}\\ID-POS・会員データ};

  \draw[wire] (shopper.south) |- node[sig, pos=0.75, below] {③ 購買} (data.east);
  \draw[wire, dashed] (data.north) -- node[sig, right, align=left] {ターゲティング\\（EC・アプリ等で行う場合）} (retail.south);
  \draw[wire] (data.west) -| node[sig, pos=0.25, below] {④ 効果測定レポート\\（広告接触 → 購買を照合）} (maker.south);

\end{tikzpicture}
