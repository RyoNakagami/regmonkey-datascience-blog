#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
% 1.0 = 3.6cm
\def\H{3.6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    title/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    tick/.style={font=\footnotesize, text=fontblack},
    pick/.style={draw=navy, fill=paleskyblue},
    greedy/.style={draw=navy, fill=aliceblue},
    note/.style={font=\footnotesize, text=azureblue, align=center},
  ]
  % ================= 左：奇を衒う =================
  \begin{scope}
    \draw[lightgray] (0,0) -- (6.5,0);
    \draw[draw=darkgray, ->] (0,0) -- (0,\H+0.5);
    \foreach \y/\t in {0/0, 0.5/0.5, 1/1.0} {
      \draw[draw=darkgray] (-0.08,\y*\H) -- (0,\y*\H);
      \node[sig, anchor=east] at (-0.1,\y*\H) {\t};
    }
    \foreach \i/\n in {1/A,2/B,3/C,4/D,5/E} {
      \node[tick, below] at (\i*1.2-0.35,0) {店\n};
    }
    % E にすべての確率
    \fill[pick] (5*1.2-0.75,0) rectangle (5*1.2+0.05,\H);
    \draw[draw=navy] (5*1.2-0.75,0) rectangle (5*1.2+0.05,\H);
    \node[note, anchor=east] at (5*1.2-0.95,0.8*\H) {最も「変わった」\\店だけを狙う};
    \node[title] at (3.25,\H+0.7) {奇を衒う};
  \end{scope}

  % ================= 右：epsilon-greedy =================
  \begin{scope}[xshift=9cm]
    \draw[lightgray] (0,0) -- (6.5,0);
    \draw[draw=darkgray, ->] (0,0) -- (0,\H+0.5);
    \foreach \y/\t in {0/0, 0.5/0.5, 1/1.0} {
      \draw[draw=darkgray] (-0.08,\y*\H) -- (0,\y*\H);
      \node[sig, anchor=east] at (-0.1,\y*\H) {\t};
    }
    \foreach \i/\n in {1/A,2/B,3/C,4/D,5/E} {
      \node[tick, below] at (\i*1.2-0.35,0) {店\n};
      % 探索部分：どの店も eps/K = 0.1
      \draw[pick] (\i*1.2-0.75,0) rectangle (\i*1.2+0.05,0.1*\H);
    }
    % 活用部分：店B（いつもの店）に 1-eps = 0.5
    \draw[greedy] (2*1.2-0.75,0.1*\H) rectangle (2*1.2+0.05,0.6*\H);
    \node[note, anchor=south] at (2*1.2-0.35,0.6*\H+0.05) {いつもの店\\（$\hat{Q}$ が最大）};
    % eps/K の水準線
    \draw[draw=azureblue, dashed] (0,0.1*\H) -- (6.5,0.1*\H);
    \node[note, anchor=south west] at (3.0*1.2-0.75,0.1*\H+0.08) {探索：どの店も同じ $\varepsilon/K=0.1$};
    \node[title] at (3.25,\H+0.7) {$\varepsilon$-greedy（$\varepsilon=0.5$，$K=5$）};
    % 凡例
    \node[draw=navy, fill=aliceblue, minimum width=0.4cm, minimum height=0.3cm, inner sep=0pt]
      (lg1) at (4.4,0.88*\H) {};
    \node[sig, anchor=west] at (lg1.east) {活用（$1-\varepsilon$）};
    \node[draw=navy, fill=paleskyblue, minimum width=0.4cm, minimum height=0.3cm, inner sep=0pt]
      (lg2) at (4.4,0.74*\H) {};
    \node[sig, anchor=west] at (lg2.east) {探索（$\varepsilon$）};
  \end{scope}

  % 共通の軸ラベル
  \node[sig, rotate=90, anchor=south] at (-0.75,0.5*\H) {選ぶ確率};
  \foreach \x in {0, 9} {
    \node[sig, anchor=west] at (\x+0.4,-0.95) {← 定番};
    \node[sig, anchor=east] at (\x+6.1,-0.95) {変わった →};
  }
\end{tikzpicture}
