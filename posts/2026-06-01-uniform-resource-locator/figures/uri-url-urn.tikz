#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    title/.style={font=\Large\bfseries, text=navy},
    sub/.style={font=\small, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    ex/.style={font=\footnotesize\ttfamily, align=left, anchor=north},
    card/.style={draw=navy, fill=aliceblue, rounded corners=6pt, inner sep=10pt},
    outer/.style={draw=navy, fill=none, rounded corners=10pt, inner sep=10pt},
  ]
  % ---- URL ----
  \node[title] (urlT) at (-4.2,0) {URL};
  \node[sub, below=1mm of urlT] (urlS) {Uniform Resource Locator：「どこにあるか」};
  \node[ex, below=3mm of urlS] (urlE)
    {https://arxiv.org/abs/1706.03762\\ftp://ftp.example.com/pub/a.tar.gz\\file:///home/user/data.csv};

  % ---- URN ----
  \node[title] (urnT) at (4.2,0) {URN};
  \node[sub, below=1mm of urnT] (urnS) {Uniform Resource Name：「何という名前か」};
  \node[ex, below=3mm of urnS] (urnE)
    {urn:isbn:978-4-00-000000-0\\urn:ietf:rfc:3986\\urn:uuid:6e8bc430-9c3a-11d9-...};

  % ---- URI（外枠）----
  \node[title, font=\huge\bfseries] (uriT) at (0,2.0) {URI（Uniform Resource Identifier）};
  \node[note, font=\small, below=1mm of uriT] (uriS) {リソースを識別する文字列の総称（RFC 3986）};

  \begin{scope}[on background layer]
    \node[card, fit=(urlT)(urlS)(urlE)(urlS.west |- urnE.south)] (urlBox) {};
    \node[card, fit=(urnT)(urnS)(urnE)(urnS.east |- urlE.south)] (urnBox) {};
    \node[outer, fit=(uriT)(uriS)(urlBox)(urnBox)] (uriBox) {};
  \end{scope}

  \node[note, font=\small, below=3mm of uriBox]
    {※ URL も URN も URI の一種．「すべての URL は URI だが，すべての URI が URL とは限らない」};
\end{tikzpicture}
