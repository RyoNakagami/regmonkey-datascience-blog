#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    seg/.style={font=\small\ttfamily, inner xsep=0pt, inner ysep=4pt},
    slug/.style={seg, fill=paleskyblue, inner xsep=1pt, rounded corners=2pt},
    rowlabel/.style={font=\footnotesize\bfseries, text=azureblue, anchor=east},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    brace/.style={decorate, decoration={brace, mirror, amplitude=5pt}, draw=darkgray},
    slugbrace/.style={decorate, decoration={brace, mirror, amplitude=5pt}, draw=navy},
  ]
  % ---- 公開URL（下段）----
  \node[seg] (u1) at (0,0) {https://ryonakagami.github.io};
  \node[seg, anchor=base west] (u2) at (u1.base east) {/regmonkey-datascience-blog/posts/};
  \node[slug, anchor=base west] (u3) at (u2.base east) {2026-06-01-uniform-resource-locator};
  \node[seg, anchor=base west] (u4) at (u3.base east) {/};

  % ---- リポジトリ内のファイル（上段）．slug の位置を URL と揃える ----
  \node[slug, above=1.5cm of u3] (f2) {2026-06-01-uniform-resource-locator};
  \node[seg, anchor=base east] (f1) at (f2.base west) {posts/};
  \node[seg, anchor=base west] (f3) at (f2.base east) {/index.qmd};

  % 行ラベル
  \node[rowlabel] at ([xshift=-4mm]u1.west) {公開URL};
  \node[rowlabel] at ([xshift=-4mm]u1.west |- f2) {記事ファイル};

  % ディレクトリ名 → URL のパス
  \draw[->, draw=navy] (f2.south) -- (u3.north)
    node[midway, right=2mm, note, align=left]
      {Quarto でレンダリングすると，\\ディレクトリ名がそのまま URL のパスになる};

  % ---- URL の各部分の説明 ----
  \draw[brace] ([yshift=-1mm]u1.south west) -- ([yshift=-1mm]u1.south east)
    node[midway, below=3mm, note] {ドメイン名};
  \draw[brace] ([yshift=-1mm]u2.south west) -- ([yshift=-1mm]u2.south east)
    node[midway, below=3mm, note] {リポジトリ名＋\texttt{posts/}};
  \draw[slugbrace] ([yshift=-1mm]u3.south west) -- ([yshift=-1mm]u3.south east)
    node[midway, below=3mm, font=\small\bfseries, text=navy] {slug（記事を識別する部分）};
\end{tikzpicture}
