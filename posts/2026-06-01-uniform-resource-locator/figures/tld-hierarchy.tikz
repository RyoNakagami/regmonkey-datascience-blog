#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    dn/.style={draw=navy, fill=aliceblue, rounded corners=3pt, font=\ttfamily,
               minimum height=0.75cm, minimum width=1.5cm, inner xsep=5pt},
    tld/.style={dn, fill=paleskyblue},
    root/.style={dn, fill=white, minimum width=2.2cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=9pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    level/.style={font=\footnotesize\bfseries, text=azureblue, anchor=east},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    link/.style={draw=navy},
  ]
  % ---- ルート ----
  \node[root] (root) at (0,0) {.（ルート）};

  % ---- TLD ----
  \def\yT{-1.9}
  \node[tld] (com) at (-6.0,\yT) {com};
  \node[tld] (org) at (-4.0,\yT) {org};
  \node[tld] (app) at (-2.0,\yT) {app};
  \node[tld] (jp)  at ( 2.0,\yT) {jp};
  \node[tld] (uk)  at ( 4.0,\yT) {uk};
  \node[tld] (fr)  at ( 6.0,\yT) {fr};

  % ---- 第2レベル ----
  \def\yS{-3.5}
  \node[dn] (excom) at (-6.0,\yS) {example};
  \node[dn] (co) at (0.0,\yS) {co};
  \node[dn] (ac) at (2.6,\yS) {ac};
  \node[dn] (exjp) at (5.0,\yS) {example};

  % ---- 第3レベル ----
  \def\yH{-5.1}
  \node[dn] (exco) at (0.0,\yH) {example};
  \node[dn] (ut) at (2.6,\yH) {u-tokyo};

  % ---- 枝 ----
  \foreach \c in {com,org,app,jp,uk,fr} { \draw[link] (root.south) -- (\c.north); }
  \draw[link] (com.south) -- (excom.north);
  \foreach \c in {co,ac,exjp} { \draw[link] (jp.south) -- (\c.north); }
  \draw[link] (co.south) -- (exco.north);
  \draw[link] (ac.south) -- (ut.north);

  % ---- 完成したドメイン名 ----
  \node[note, below=1.5mm of excom] {\texttt{example.com}};
  \node[note, below=1.5mm of exco]  {\texttt{example.co.jp}};
  \node[note, below=1.5mm of ut]    {\texttt{u-tokyo.ac.jp}};
  \node[note, below=1.5mm of exjp]  {\texttt{example.jp}};

  % ---- gTLD / ccTLD のゾーン ----
  \begin{scope}[on background layer]
    \node[zone, fit=(com)(app)] (zg) {};
    \node[zone, fit=(jp)(fr)] (zc) {};
  \end{scope}
  \node[zlabel, anchor=south west] at (zg.north west) {gTLD（用途別）};
  \node[zlabel, anchor=south east] at (zc.north east) {ccTLD（国・地域別）};

  % ---- 階層の名前（左）----
  \node[level] at (-7.6,\yT) {TLD};
  \node[level] at (-7.6,\yS) {第2レベル};
  \node[level] at (-7.6,\yH) {第3レベル};
  \node[level] at (-7.6,0) {ルート};
\end{tikzpicture}
