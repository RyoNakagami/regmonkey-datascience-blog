#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    lab/.style={draw=navy, fill=aliceblue, rounded corners=3pt, font=\large\ttfamily,
                minimum height=0.9cm, inner xsep=8pt},
    tld/.style={lab, fill=paleskyblue},
    dotsep/.style={font=\large\ttfamily\bfseries, text=navy},
    level/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    upbrace/.style={decorate, decoration={brace, amplitude=4pt}, draw=navy},
    dnbrace/.style={decorate, decoration={brace, mirror, amplitude=6pt}, draw=darkgray},
  ]
  % ---- ラベル ----
  \node[lab] (l4) at (0,0) {www};
  \node[dotsep, right=0.25cm of l4] (d1) {.};
  \node[lab, right=0.25cm of d1] (l3) {example};
  \node[dotsep, right=0.25cm of l3] (d2) {.};
  \node[lab, right=0.25cm of d2] (l2) {co};
  \node[dotsep, right=0.25cm of l2] (d3) {.};
  \node[tld, right=0.25cm of d3] (l1) {jp};

  % ---- レベル名（上）----
  \foreach \n/\t in {l4/第4レベル\\ドメイン, l3/第3レベル\\ドメイン,
                     l2/第2レベル\\ドメイン, l1/トップレベル\\ドメイン（TLD）} {
    \draw[upbrace] ([yshift=1.5mm]\n.north west) -- ([yshift=1.5mm]\n.north east);
    \node[level, anchor=south] at ([yshift=4.5mm]\n.north) {\t};
  }

  % 右から数える
  \draw[->, >={Latex[length=2.2mm]}, draw=darkgray]
    ([yshift=-0.45cm]l1.south east) -- ([yshift=-0.45cm]l4.south west)
    node[midway, below=1pt, note] {右（上位）から順にレベルを数える};

  % ---- 長さの制約（下）----
  \draw[dnbrace] ([yshift=-1.35cm]l4.south west) -- ([yshift=-1.35cm]l1.south east)
    node[midway, below=3mm, note]
      {各ラベルは 1〜63 文字，ドットを含む全体は 253 文字以下};
\end{tikzpicture}
