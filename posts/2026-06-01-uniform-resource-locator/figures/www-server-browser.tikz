#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    chip/.style={draw=navy, fill=white, rounded corners=2pt, font=\footnotesize,
                 minimum width=1.0cm, minimum height=0.55cm, inner sep=2pt},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    step/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % ---- 3つの主体（左：ユーザー，中：ブラウザ，右：サーバー）----
  \node[block, fill=white, minimum width=2.2cm, minimum height=2.8cm] (user)
    {\textbf{ユーザー}};
  \node[block, minimum width=3.8cm, minimum height=2.8cm, right=3.4cm of user]
    (browser) {};
  \node[block, minimum width=3.8cm, minimum height=2.8cm, right=3.6cm of browser]
    (server) {};

  % ブロック内の見出し
  \node[font=\bfseries, below=3mm of browser.north] (btitle) {WWWブラウザ};
  \node[font=\bfseries, below=3mm of server.north] (stitle) {WWWサーバー};

  % サーバー：保管しているファイル（本棚）
  \node[chip, below=3mm of stitle] (html) {HTML};
  \node[chip, left=2mm of html] (img) {画像};
  \node[chip, right=2mm of html] (snd) {音声};
  \node[font=\scriptsize, text=darkgray, below=1.5mm of html] {保管しているファイル};

  % ブラウザ：見やすく表示されたページ
  \node[chip, minimum width=2.6cm, minimum height=0.9cm, below=3mm of btitle]
    (page) {表示されたページ};

  % ---- アナロジー（上）と機能（下）----
  \node[step, above=2mm of user] {利用者};
  \node[step, above=2mm of browser] {アナロジー：「代理人」兼「通訳」};
  \node[step, above=2mm of server] {アナロジー：本棚を管理する司書};

  \node[note, below=2.5mm of user] {情報を見たい人};
  \node[note, below=2.5mm of browser]
    {ユーザーの要求を伝え，\\サーバーから届いたファイルを\\見やすく表示するソフト};
  \node[note, below=2.5mm of server]
    {ハイパーテキストや画像，\\音声ファイルを保管し，\\要求に応じて提供する};

  % ---- やり取り（上段：要求の流れ，下段：応答の流れ）----
  \draw[wire] ([yshift=5mm]user.east) -- ([yshift=5mm]browser.west)
    node[midway, above, sig] {URL入力・クリック};
  \draw[wire] ([yshift=-5mm]browser.west) -- ([yshift=-5mm]user.east)
    node[midway, below, sig] {見やすく表示};

  \draw[wire] ([yshift=5mm]browser.east) -- ([yshift=5mm]server.west)
    node[midway, above, sig] {リクエスト（要求）};
  \draw[wire] ([yshift=-5mm]server.west) -- ([yshift=-5mm]browser.east)
    node[midway, below, sig] {レスポンス\\（HTML・画像・音声）};
\end{tikzpicture}
