#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.4cm, inner sep=5pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sub/.style={font=\scriptsize, text=darkgray},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b1) {ログイン\\[1pt]{\scriptsize\color{darkgray} 利用者・接続先の確認}};
  \node[block, right=1.2cm of b1] (b2) {通信\\[1pt]{\scriptsize\color{darkgray} HTTPS（TLS）}};
  \node[block, right=1.2cm of b2] (b3) {サービス提供\\[1pt]{\scriptsize\color{darkgray} Webサーバ・DB}};
  \node[block, right=1.2cm of b3] (b4) {操作の記録\\[1pt]{\scriptsize\color{darkgray} 監査ログ・署名}};
  \node[step, above=2mm of b1] {真正性};
  \node[step, above=2mm of b2] {機密性・完全性};
  \node[step, above=2mm of b3] {可用性・信頼性};
  \node[step, above=2mm of b4] {責任追跡性・否認防止};
  \node[note, below=2mm of b1] {多要素認証で本人を，\\証明書でサーバを確認};
  \node[note, below=2mm of b2] {暗号化で盗聴を防ぎ，\\改ざんを検知する};
  \node[note, below=2mm of b3] {冗長化で止めずに，\\一貫した応答を返す};
  \node[note, below=2mm of b4] {誰が何をしたかを\\後から証明できる};
  \draw[wire] (b1) -- (b2);
  \draw[wire] (b2) -- (b3);
  \draw[wire] (b3) -- (b4);
\end{tikzpicture}
