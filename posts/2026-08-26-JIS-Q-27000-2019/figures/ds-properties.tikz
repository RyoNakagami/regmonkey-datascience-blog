#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.4cm, inner sep=5pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue, align=center},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sub/.style={font=\scriptsize, text=darkgray},
    wire/.style={->, draw=navy},
  ]
  \node[block] (b1) {データ取得\\[1pt]{\scriptsize\color{darkgray} 外部提供・ログ収集}};
  \node[block, right=1.2cm of b1] (b2) {データ保管\\[1pt]{\scriptsize\color{darkgray} DWH・ストレージ}};
  \node[block, right=1.2cm of b2] (b3) {前処理・学習\\[1pt]{\scriptsize\color{darkgray} パイプライン}};
  \node[block, right=1.2cm of b3] (b4) {予測・レポート\\[1pt]{\scriptsize\color{darkgray} API・ダッシュボード}};
  \node[step, above=2mm of b1] {真正性・否認防止};
  \node[step, above=2mm of b2] {機密性・完全性};
  \node[step, above=2mm of b3] {信頼性・責任追跡性};
  \node[step, above=2mm of b4] {可用性};
  \node[note, below=2mm of b1] {提供元を確認し，\\受領記録を残す};
  \node[note, below=2mm of b2] {アクセス権限を絞り，\\改ざんを検知する};
  \node[note, below=2mm of b3] {シード・版数を固定し，\\実行ログを残す};
  \node[note, below=2mm of b4] {必要なときに\\結果を参照できる};
  \draw[wire] (b1) -- (b2);
  \draw[wire] (b2) -- (b3);
  \draw[wire] (b3) -- (b4);
\end{tikzpicture}
