#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, inner sep=6pt},
    accent/.style={block, fill=paleskyblue},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt, text=darkgray},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  \node[block, minimum width=5.6cm] (du)
    {\textbf{集計}\\[2pt]\texttt{sudo du -xh --max-depth=3 /}};
  \node[block, minimum width=3.0cm, right=1.6cm of du] (sort)
    {\textbf{並べ替え}\\[2pt]\texttt{sort -rh}};
  \node[block, minimum width=3.0cm, right=1.6cm of sort] (head)
    {\textbf{切り出し}\\[2pt]\texttt{head -30}};
  \node[accent, minimum width=2.6cm, right=1.6cm of head] (out)
    {\textbf{端末}\\[2pt]上位30件};

  \node[note, below=2.5mm of du]
    {ルート FS 内だけを集計（\texttt{-x}）し，\\3 階層までのディレクトリを 1 行ずつ出力};
  \node[note, below=2.5mm of sort]
    {K/M/G を解釈して（\texttt{-h}）\\大きい順に並べる（\texttt{-r}）};
  \node[note, below=2.5mm of head]
    {先頭 30 行だけ残す};

  \draw[wire] (du) -- node[midway, above, sig] {\texttt{|} stdout} (sort);
  \draw[wire] (sort) -- node[midway, above, sig] {\texttt{|} stdout} (head);
  \draw[wire] (head) -- (out);

  % stderr は捨てる
  \node[ext, anchor=west] (null) at ($(du.north)+(1.4,1.1)$) {\texttt{/dev/null}};
  \draw[->, draw=darkgray, dashed] (du.north) |- (null.west)
    node[pos=0.25, left, sig] {stderr（\texttt{2>/dev/null}）};
  \node[note, anchor=west] at ($(null.east)+(0.25,0)$) {Permission denied などのエラーを捨てる};
\end{tikzpicture}
