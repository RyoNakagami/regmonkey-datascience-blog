#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=2.4cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt, text=darkgray},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    rowlabel/.style={font=\bfseries, text=navy, align=right, anchor=east},
    wire/.style={->, draw=navy},
  ]
  % ---- 上段：2>/dev/null なし ----
  \node[block] (du1) at (0,0) {\texttt{du -xh ...}};
  \node[block, right=1.4cm of du1] (sort1) {\texttt{sort -rh}};
  \node[block, right=1.4cm of sort1] (head1) {\texttt{head -30}};
  \node[ng, right=1.4cm of head1] (out1) {端末\\[2pt]結果とエラーが混在};
  \draw[wire] (du1) -- node[midway, above, sig] {stdout} (sort1);
  \draw[wire] (sort1) -- (head1);
  \draw[wire] (head1) -- (out1);
  \coordinate (e1) at ($(du1.north)+(0,0.8)$);
  \draw[->, draw=crimsonred, dashed] (du1.north) -- (e1) -| (out1.north)
    node[pos=0.25, above, font=\footnotesize, text=crimsonred]
      {stderr はパイプを通らず，\texttt{head -30} でも切られない};
  \node[rowlabel] at ($(du1.west)+(-0.4,0)$) {\texttt{2>/dev/null}\\なし};

  % ---- 下段：2>/dev/null あり ----
  \node[block] (du2) at (0,-3.0) {\texttt{du -xh ...}};
  \node[block, right=1.4cm of du2] (sort2) {\texttt{sort -rh}};
  \node[block, right=1.4cm of sort2] (head2) {\texttt{head -30}};
  \node[accent, right=1.4cm of head2] (out2) {端末\\[2pt]結果の 30 行だけ};
  \draw[wire] (du2) -- node[midway, above, sig] {stdout} (sort2);
  \draw[wire] (sort2) -- (head2);
  \draw[wire] (head2) -- (out2);
  \node[ext, anchor=west] (null) at ($(du2.north)+(1.2,0.8)$) {\texttt{/dev/null}};
  \draw[->, draw=darkgray, dashed] (du2.north) |- (null.west);
  \node[sig, anchor=west] at ($(null.east)+(0.2,0)$) {stderr はここで捨てる};
  \node[rowlabel] at ($(du2.west)+(-0.4,0)$) {\texttt{2>/dev/null}\\あり};

  % 段の区切り
  \draw[draw=lightgray] ($(du1.south west)+(-2.6,-0.5)$) -- ($(out1.south east)+(0.2,-0.5)$);
\end{tikzpicture}
