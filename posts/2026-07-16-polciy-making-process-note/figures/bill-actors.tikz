#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=3.0cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
    back/.style={->, draw=darkgray, dashed},
  ]
  % 所管省庁
  \node[accent, minimum width=3.6cm] (sec) at (0,0) {{\bfseries 所管課}\\{\footnotesize（原局・原課）}};
  \node[sig, below=3pt of sec] {法律事務官が起草し，\\各関門との交渉窓口になる};
  \node[block, minimum width=3.6cm] (shin) at (0,3.4) {審議会};
  \node[sig, below=3pt of shin] {有識者・関係団体};
  \node[block, minimum width=3.6cm] (kan) at (0,-4.0) {官房\\{\footnotesize（文書課・総務課など）}};
  \node[sig, below=3pt of kan] {省全体の提出法案を管理};
  \draw[wire] ([xshift=-0.6cm]sec.north) -- node[sig, left] {諮問} ([xshift=-0.6cm,yshift=0.15cm]shin.south);
  \draw[wire] ([xshift=0.6cm,yshift=0.15cm]shin.south) -- node[sig, right] {答申} ([xshift=0.6cm]sec.north);
  \draw[<->, draw=navy] (kan.north) -- node[sig, right, align=left] {提出本数・順序・\\参議院先議の調整} ([yshift=-1.05cm]sec.south);

  % 3つの関門
  \foreach \y/\t/\n/\s [count=\k] in {3.4/他省庁/{全省庁の了解が必要\\（拒否権に近い）}/{協議・覚書},
                           0/内閣法制局/{必要性・公益性・\\法律事項・整合性}/{予備審査・本審査},
                           -3.4/与党/{部会→政調審議会→総務会\\（自民党の場合）}/{説明・党審査}} {
    \node[block, minimum width=3.4cm] (g\k) at (8.6,\y) {\t};
    \node[sig, below=3pt of g\k] {\n};
    \draw[wire] (sec.east) -- node[sig, above, sloped] {\s} (g\k.west);
  }

  % 出口
  \node[block] (cab) at (14.6,0) {閣議決定};
  \node[block] (diet) at (14.6,-3.4) {国会};
  \foreach \k in {1,2,3} \draw[back] (g\k.east) -- (cab.west);
  \node[sig, anchor=south] at (12.35,1.75) {すべて\\クリア};
  \draw[wire] (cab) -- node[sig, right] {提出} (diet);

  \begin{scope}[on background layer]
    \node[zone, fit=(shin)(kan)([yshift=-0.8cm]kan.south)([xshift=-0.3cm]sec.west)([xshift=0.3cm]sec.east)] (z1) {};
  \end{scope}
  \node[zlabel] at (z1.north) {法案を所管する省};
\end{tikzpicture}
