#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=3.0cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
    back/.style={->, draw=darkgray, dashed},
  ]
  % 省内段階
  \foreach \i/\t/\n in {0/調査・研究/{白書・研究会・\\現場からの問題提起},
                        1/審議会への諮問/{答申で方向性に\\お墨付きを得る},
                        2/原案作成/{所管課の法律事務官が\\条文を起草},
                        3/省議/{省としての\\意思決定}} {
    \node[block] (a\i) at ({\i*4.2},4.7) {\t};
    \node[sig, below=3pt of a\i] {\n};
  }
  \foreach \i/\j in {0/1,1/2,2/3} \draw[wire] (a\i) -- (a\j);

  % 政府・与党内の調整
  \foreach \i/\t/\s/\n in {0/各省協議/①/{全省庁から\\閣議提出の了解},
                           1/内閣法制局審査/②/{法制的な\\妥当性の確認},
                           2/与党審査/③/{国会提出への\\与党の了承}} {
    \node[accent] (b\i) at ({\i*4.2},0) {\t};
    \node[step, above=2pt of b\i] {関門\s};
    \node[sig, below=3pt of b\i] {\n};
  }
  \node[block] (cab) at (12.6,0) {閣議決定};
  \node[sig, below=3pt of cab] {内閣提出法案\\として確定};
  \node[block] (diet) at (16.8,0) {国会審議};
  \node[sig, below=3pt of diet] {委員会審査・\\本会議で議決};
  \foreach \i/\j in {0/1,1/2} \draw[wire] (b\i) -- (b\j);
  \draw[wire] (b2) -- (cab);
  \draw[wire] (cab) -- (diet);

  % 省議 → 各省協議（折り返し）
  \draw[wire] (a3.east) -- ++(0.75,0) |- (-2.2,2.35) |- (b0.west);

  % ゾーン
  \begin{scope}[on background layer]
    \node[zone, fit=(a0)(a3)([yshift=-1.0cm]a0.south)] (z1) {};
    \node[zone, fit=(b0)(cab)([yshift=0.4cm]b0.north)([yshift=-1.0cm]b0.south)] (z2) {};
    \node[zone, fit=(diet)([yshift=0.4cm]diet.north)([yshift=-1.0cm]diet.south)] (z3) {};
  \end{scope}
  \node[zlabel] at (z1.north) {省内での立案};
  \node[zlabel] at (z2.north) {政府・与党内の調整};
  \node[zlabel] at (z3.north) {立法府};
\end{tikzpicture}
