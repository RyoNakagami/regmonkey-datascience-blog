#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=3.0cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
    back/.style={->, draw=darkgray, dashed},
  ]
  % 左：修正で決着させる場合
  \node[ng] (n1) at (0,0) {条文を修正して\\A省と合意};
  \node[ng] (n2) at (5.2,0) {修正版を全省庁に\\配り直して再協議};
  \node[ng] (n3) at (2.6,-3.0) {B省から\\新たな修正要求};
  \draw[->, draw=crimsonred] (n1) -- (n2);
  \draw[->, draw=crimsonred] (n2) |- (n3);
  \draw[->, draw=crimsonred] (n3) -| (n1);
  \node[font=\footnotesize\bfseries, text=crimsonred] at (2.6,-1.35) {協議が終わらない};

  % 右：覚書で決着させる場合
  \node[block] (o1) at (10.4,0) {A省からの\\修正要求};
  \node[accent] (o2) at (15.0,0) {覚書を交わす};
  \node[block] (o3) at (15.0,-3.0) {協議クリア\\→ 閣議へ};
  \draw[wire] (o1) -- (o2);
  \draw[wire] (o2) -- node[sig, right, align=left] {条文は\\そのまま} (o3);
  \node[sig, below=3pt of o2, anchor=north east, xshift=-0.3cm] {運用・解釈・\\将来の対応を\\文書で約束};

  \begin{scope}[on background layer]
    \node[zone, draw=lightgray, fit=(n1)(n2)(n3)] (zl) {};
    \node[zone, fit=(o1)(o2)(o3)([xshift=1.2cm]o3.east)] (zr) {};
  \end{scope}
  \node[zlabel, text=crimsonred] at (zl.north) {条文修正で決着させると…};
  \node[zlabel] at (zr.north) {覚書で決着させる};
\end{tikzpicture}
