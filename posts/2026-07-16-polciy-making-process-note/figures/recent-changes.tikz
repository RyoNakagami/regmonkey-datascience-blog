#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=3.0cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt, align=center},
    wire/.style={->, draw=navy},
    back/.style={->, draw=darkgray, dashed},
  ]
  \node[font=\bfseries, text=navy] at (5.0,1.4) {従来の型};
  \node[font=\bfseries, text=navy] at (14.6,1.4) {近年の変容};
  \foreach \y/\h/\a/\d/\b [count=\k] in {
      0/{省庁間協議\\（覚書）}/{自治体での執行方法まで\\覚書で細かく取り決める}/{分権改革（2000年）\\機関委任事務の廃止}/{細かな協議は無駄と認識され，\\覚書の粒度が粗くなる},
      -2.4/{政策の\\方針決定}/{各省が所管分野の政策を\\ボトムアップで立案}/{省庁再編（2001年）\\経済財政諮問会議}/{官邸が基本方針を決め，\\各省は具体化に徹する},
      -4.8/{法案準備室}/{省・局単位で設置し，\\局内の法律事務官を集める}/{官邸主導の改革\\（有事法制・郵政民営化）}/{内閣が主導して設置し，\\各省に対抗する作業集団に}} {
    \node[font=\bfseries, text=navy, align=center] (h\k) at (0,\y) {\h};
    \node[block, minimum width=5.4cm] (a\k) at (5.0,\y) {\a};
    \node[accent, minimum width=5.4cm] (b\k) at (14.6,\y) {\b};
    \draw[wire] (a\k) -- node[sig, above] {\d} (b\k);
  }
  \foreach \y in {-1.2,-3.6} \draw[lightgray] (-1.4,\y) -- (17.4,\y);
\end{tikzpicture}
