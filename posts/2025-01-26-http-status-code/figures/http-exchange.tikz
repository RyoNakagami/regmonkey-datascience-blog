#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, inner sep=5pt},
    row/.style={draw=navy, fill=white, minimum width=6.6cm, minimum height=0.62cm,
                anchor=north, font=\footnotesize, inner sep=3pt},
    head/.style={row, fill=paleskyblue},
    lab/.style={font=\footnotesize, text=darkgray, anchor=east},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]
  % 両端のブロック
  \node[block, minimum width=2.8cm, minimum height=7.6cm] (cl) at (0,0) {Web ブラウザ\\[2pt]\footnotesize（クライアント）};
  \node[block, minimum width=2.8cm, minimum height=7.6cm] (sv) at (16.8,0) {Web サーバー\\[2pt]\footnotesize（Apache など）};

  % リクエスト
  \draw[wire] (cl.east |- 0,3.3) -- node[midway, above, step] {① リクエスト} (sv.west |- 0,3.3);
  \node[head] (q1) at (7.6,2.8) {\texttt{GET /index.html HTTP/1.1}};
  \node[row]  (q2) at (q1.south) {\texttt{Host: svr.example.com}};
  \node[row]  (q3) at (q2.south) {\textcolor{darkgray}{（空行）}};
  \node[row]  (q4) at (q3.south) {\textcolor{darkgray}{POST・PUT のときのみ送るデータ}};
  \node[lab] at ([xshift=-2mm]q1.west) {リクエストライン};
  \node[lab] at ([xshift=-2mm]q2.west) {ヘッダ};
  \node[lab] at ([xshift=-2mm]q3.west) {区切り};
  \node[lab] at ([xshift=-2mm]q4.west) {ボディ};

  % レスポンス
  \draw[wire] (sv.west |- 0,-0.5) -- node[midway, above, step] {② レスポンス} (cl.east |- 0,-0.5);
  \node[head] (r1) at (7.6,-1.0) {\texttt{HTTP/1.1 200 OK}};
  \node[row]  (r2) at (r1.south) {\texttt{Content-Type: text/html}};
  \node[row]  (r3) at (r2.south) {\textcolor{darkgray}{（空行）}};
  \node[row]  (r4) at (r3.south) {\texttt{<!DOCTYPE html> ...}};
  \node[lab] at ([xshift=-2mm]r1.west) {ステータスライン};
  \node[lab] at ([xshift=-2mm]r2.west) {ヘッダ};
  \node[lab] at ([xshift=-2mm]r3.west) {区切り};
  \node[lab] at ([xshift=-2mm]r4.west) {ボディ};
  \node[font=\footnotesize, text=azureblue, anchor=west] at ([xshift=2mm]r1.east) {← 200 がステータスコード};
\end{tikzpicture}
