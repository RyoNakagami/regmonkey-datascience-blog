#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum width=3.8cm, minimum height=1.4cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center,
                 minimum width=1.9cm, minimum height=1.05cm, inner sep=3pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  % クライアント側
  \node[block] (br) at (0,0) {\textbf{Web ブラウザ}\\[2pt]\footnotesize\textcolor{darkgray}{Chrome・Firefox・Safari・Edge}};
  \node[accent, below=1.5cm of br] (sc) {画面に表示\\[1pt]\footnotesize Web ページ};
  \draw[wire] (br) -- node[step, right=1mm] {③ ファイルを解釈する} (sc);

  % サーバー側
  \node[block] (sv) at (10,0) {\textbf{Web サーバー}\\[2pt]\footnotesize\textcolor{darkgray}{Apache・nginx}};
  \node[card, below left=1.2cm and -1.85cm of sv] (html) {HTML\\\footnotesize\textcolor{darkgray}{構造}};
  \node[card, right=0.2cm of html] (css) {CSS\\\footnotesize\textcolor{darkgray}{見た目}};
  \node[card, below=0.2cm of html] (js) {JavaScript\\\footnotesize\textcolor{darkgray}{動き}};
  \node[card, right=0.2cm of js] (img) {画像\\\footnotesize\textcolor{darkgray}{写真・アイコン}};
  \node[sig, anchor=south] (fl) at ($(html.north)!0.5!(css.north)$) {公開するファイル};
  \draw[wire] (fl.north) -- node[sig, right] {読み出す} (fl.north |- sv.south);

  % やりとり
  \draw[wire] ([yshift=3mm]br.east) -- node[step, above] {① リクエスト（HTTP）} ([yshift=3mm]sv.west);
  \draw[wire] ([yshift=-3mm]sv.west) -- node[step, below] {② ファイルを返す} ([yshift=-3mm]br.east);

  \begin{scope}[on background layer]
    \node[zone, fit=(br)(sc)(br |- js.south)] (zc) {};
    \node[zone, fit=(sv)(html)(img)(sv |- js.south)] (zs) {};
  \end{scope}
  \node[zlabel] at (zc.north) {クライアント側};
  \node[zlabel] at (zs.north) {サーバー側};
\end{tikzpicture}
