#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    actor/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=2.4cm, minimum height=0.9cm},
    lane/.style={draw=lightgray, line width=1pt},
    msg/.style={->, draw=navy},
    ngmsg/.style={->, draw=crimsonred},
    lbl/.style={font=\footnotesize, fill=white, inner sep=1.5pt, align=center},
    sig/.style={font=\footnotesize, text=darkgray, align=center},
  ]
  \node[actor] (c) at (-1.6,2.0) {クライアント};
  \node[actor] (s) at (-1.6,0) {サーバー};
  \draw[lane] (c.east) -- (15.2,2.0);
  \draw[lane] (s.east) -- (15.2,0);

  % 接続とヘッダ途中まで
  \draw[msg] (0.6,2.0) -- node[lbl, right=1pt] {① TCP 接続} (0.6,0);
  \draw[msg] (3.0,2.0) -- node[lbl, right=1pt] {② ヘッダを\\途中まで送る} (3.0,0);
  \draw[draw=darkgray, dashed] (4.2,2.0) -- (10.6,2.0);
  \node[sig, above=1mm] at (7.4,2.0) {③ 送信が止まる（回線が遅い・プログラムが止まった・接続だけ先に開いた）};

  % タイマー
  \draw[|<->|, draw=navy] (0.6,-0.9) -- node[sig, below=1mm] {待ち時間の上限（Apache: \texttt{RequestReadTimeout}，nginx: \texttt{client\_header\_timeout} など）} (11.4,-0.9);

  % 408
  \draw[ngmsg] (11.4,0) -- node[lbl, right=1pt] {④ \textcolor{crimsonred}{\texttt{408 Request Timeout}}\\\texttt{Connection: close}} (11.4,2.0);
  \node[sig, anchor=west, text=crimsonred] at (12.0,-0.4) {⑤ 接続を切る};
  \draw[->, draw=darkgray] (-0.2,-2.0) -- node[sig, right, pos=1] {時間} (14.6,-2.0);
\end{tikzpicture}
