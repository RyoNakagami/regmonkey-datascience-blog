#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum width=2.7cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, font=\footnotesize, minimum width=3.0cm, minimum height=1.5cm},
    res/.style={block, fill=white, font=\footnotesize, minimum width=5.3cm, minimum height=1.3cm},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt, align=center, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    wire/.style={->, draw=navy},
    nowire/.style={->, draw=crimsonred},
  ]
  \node[ext] (st) at (0,0) {\texttt{curl -v URL}};
  \node[block, right=1.0cm of st] (b1) {① 名前解決\\\footnotesize DNS};
  \node[block, right=0.9cm of b1] (b2) {② TCP 接続\\\footnotesize ポート 80 / 443};
  \node[block, right=0.9cm of b2] (b3) {③ TLS 確立\\\footnotesize HTTPS のみ};
  \node[accent, right=1.6cm of b3] (b4) {④ HTTP\\レスポンス};

  \draw[wire] (st) -- (b1);
  \draw[wire] (b1) -- node[sig, above] {OK} (b2);
  \draw[wire] (b2) -- node[sig, above] {OK} (b3);
  \draw[wire] (b3) -- node[sig, above] {OK} (b4);

  \node[ng, below=1.0cm of b1] (f1) {\textcolor{crimsonred}{\textbf{名前が引けない}}\\\texttt{(6) Could not}\\\texttt{resolve host}};
  \node[ng, below=1.0cm of b2] (f2) {\textcolor{crimsonred}{\textbf{つながらない}}\\\texttt{(7) Connection refused}\\\texttt{(28) Timed out}};
  \node[ng, below=1.0cm of b3] (f3) {\textcolor{crimsonred}{\textbf{TLS エラー}}\\\texttt{(60)} 証明書の検証失敗\\\texttt{(35)} ハンドシェイク失敗};
  \foreach \i in {1,2,3} { \draw[nowire] (b\i) -- node[sig, right] {NG} (f\i); }

  \node[res, right=1.4cm of b4, yshift=1.6cm] (r2) {\textbf{2xx・3xx} でも期待と違う\\→ vhost・キャッシュ・リダイレクト先};
  \node[res, right=1.4cm of b4] (r4) {\textbf{4xx} → 送った内容を見直す\\URL・メソッド・ヘッダ・認証情報};
  \node[res, right=1.4cm of b4, yshift=-1.6cm] (r5) {\textbf{5xx} → サーバー側のログを見る\\\texttt{error.log}・アプリ・上流サーバー};
  \coordinate (br) at ([xshift=0.7cm]b4.east);
  \draw[draw=navy] (b4.east) -- (br);
  \foreach \r in {r2,r4,r5} { \draw[wire] (br) |- (\r.west); }

  \begin{scope}[on background layer]
    \node[zone, fit=(b1)(b3)(f1)(f3)(b1 |- r2.north)] (z1) {};
    \node[zone, fit=(b4)(r2)(r5)(b4 |- f1.south)] (z2) {};
  \end{scope}
  \node[zlabel] at (z1.north) {HTTP より手前の層：ステータスコードは返らない};
  \node[zlabel] at (z2.north) {HTTP の層：ステータスコードで絞り込む};
\end{tikzpicture}
