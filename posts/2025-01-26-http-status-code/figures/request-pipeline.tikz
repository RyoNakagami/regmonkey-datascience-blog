#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum width=2.3cm, minimum height=1.25cm, inner sep=3pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, minimum height=1.35cm, font=\footnotesize},
    code/.style={font=\bfseries, text=crimsonred},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    wire/.style={->, draw=navy},
    nowire/.style={->, draw=crimsonred},
  ]
  \node[block] (s1) at (0,0) {リクエスト\\受信};
  \node[block, right=0.55cm of s1] (s2) {構文の\\チェック};
  \node[block, right=0.55cm of s2] (s3) {ルーティング\\\footnotesize URL→リソース};
  \node[block, right=0.55cm of s3] (s4) {メソッドの\\確認};
  \node[block, right=0.55cm of s4] (s5) {認証\\\footnotesize あなたは誰？};
  \node[block, right=0.55cm of s5] (s6) {認可\\\footnotesize 権限はある？};
  \node[block, right=0.55cm of s6] (s7) {処理の\\実行};
  \node[accent, right=0.55cm of s7] (ok) {\textbf{200 OK}\\\footnotesize 結果を返す};

  \node[sig, anchor=east] (in) at ([xshift=-0.7cm]s1.west) {リクエスト};
  \draw[wire] (in) -- (s1);
  \foreach \a/\b in {s1/s2, s2/s3, s3/s4, s4/s5, s5/s6, s6/s7, s7/ok} {
    \draw[wire] (\a) -- (\b);
  }

  % 失敗時の分岐
  \foreach \s/\c/\t in {s1/408/時間内に\\届かない, s2/400/形式が\\不正, s3/404/リソースが\\無い,
                        s4/405/許可されない\\メソッド, s5/401/資格情報が\\無い・不正,
                        s6/403/権限が\\無い, s7/500/処理中に\\エラー} {
    \node[ng, below=1.0cm of \s] (n\c) {\textcolor{crimsonred}{\textbf{\c}}\\\t};
    \draw[nowire] (\s) -- (n\c);
  }

  % 100 Continue
  \node[accent, above=0.9cm of s1, minimum height=1.0cm] (c100) {\textbf{100 Continue}\\\footnotesize ボディを送って};
  \draw[wire] (s1) -- node[sig, right, align=left] {\texttt{Expect: 100-continue}\\付きのとき，ヘッダを\\受け取った時点で返す} (c100);

  \node[note, anchor=north west] at ([yshift=-0.35cm]n408.south west)
    {※ 判定の順序は実装によって異なる．例えば Apache は認証・認可をファイルを返す処理より先に行うため，保護されたディレクトリ内の存在しないパスには 404 ではなく 401 が返る．};
\end{tikzpicture}
