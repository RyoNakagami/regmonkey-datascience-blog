#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    actor/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=2.6cm, minimum height=0.9cm},
    life/.style={draw=lightgray, line width=1pt},
    msg/.style={->, draw=navy},
    ngmsg/.style={->, draw=crimsonred},
    lbl/.style={font=\footnotesize, above, inner sep=2pt, align=center},
    title/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
  ]
  % ---- 左：受け入れる場合 ----
  \node[title] at (3.25,1.3) {サーバーが受け入れる場合};
  \node[actor] (c1) at (0,0) {クライアント};
  \node[actor] (s1) at (6.5,0) {サーバー};
  \draw[life] (c1.south) -- (0,-6.2);
  \draw[life] (s1.south) -- (6.5,-6.2);
  \draw[msg] (0,-1.55) -- node[lbl] {① ヘッダだけ送る\\\texttt{Expect: 100-continue}} (6.5,-1.55);
  \draw[msg] (6.5,-2.95) -- node[lbl] {② \texttt{100 Continue}} (0,-2.95);
  \draw[msg] (0,-4.35) -- node[lbl] {③ ボディを送る} (6.5,-4.35);
  \draw[msg] (6.5,-5.55) -- node[lbl] {④ \texttt{200 OK}} (0,-5.55);

  % ---- 右：拒否する場合 ----
  \node[title] at (13.45,1.3) {サーバーが拒否する場合};
  \node[actor] (c2) at (10.2,0) {クライアント};
  \node[actor] (s2) at (16.7,0) {サーバー};
  \draw[life] (c2.south) -- (10.2,-6.2);
  \draw[life] (s2.south) -- (16.7,-6.2);
  \draw[msg] (10.2,-1.55) -- node[lbl] {① ヘッダだけ送る\\\texttt{Expect: 100-continue}} (16.7,-1.55);
  \draw[ngmsg] (16.7,-2.95) -- node[lbl] {② \textcolor{crimsonred}{\texttt{401 Unauthorized}} など} (10.2,-2.95);
  \node[note] at (13.45,-4.6) {ボディを送らずに終わる\\→ 大きなデータの無駄な転送を防げる};
\end{tikzpicture}
