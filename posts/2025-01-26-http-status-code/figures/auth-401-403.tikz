#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum width=2.8cm, minimum height=1.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    ng/.style={block, draw=crimsonred, fill=mistyrose, minimum width=3.4cm},
    dec/.style={diamond, draw=navy, fill=white, align=center, inner sep=1pt, minimum size=2.6cm},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
    nowire/.style={->, draw=crimsonred},
  ]
  \node[block] (rq) at (0,0) {リクエスト\\\footnotesize\texttt{GET /admin/}};
  \node[dec, right=1.3cm of rq] (d1) {資格情報は\\有効？};
  \node[dec, right=2.2cm of d1] (d2) {権限は\\ある？};
  \node[accent, right=1.3cm of d2] (ok) {\textbf{200 OK}};
  \node[step, above=1mm of d1] {認証（authentication）};
  \node[step, above=1mm of d2] {認可（authorization）};

  \draw[wire] (rq) -- (d1);
  \draw[wire] (d1) -- node[sig, above] {Yes} (d2);
  \draw[wire] (d2) -- node[sig, above] {Yes} (ok);

  \node[ng, below=1.1cm of d1] (e401) {\textcolor{crimsonred}{\textbf{401 Unauthorized}}\\\footnotesize あなたが誰か分からない};
  \node[ng, below=1.1cm of d2] (e403) {\textcolor{crimsonred}{\textbf{403 Forbidden}}\\\footnotesize 誰かは分かったが許可しない};
  \draw[nowire] (d1) -- node[sig, right] {No} (e401);
  \draw[nowire] (d2) -- node[sig, right] {No} (e403);

  \node[note, below=2mm of e401] {\texttt{WWW-Authenticate} ヘッダで\\認証方式を伝える\\→ 正しく名乗り直せば通る};
  \node[note, below=2mm of e403] {名乗り直しても結果は同じ\\→ 権限設定・パーミッションを\\見直す必要がある};
\end{tikzpicture}
