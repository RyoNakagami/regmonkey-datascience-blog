#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    actor/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=2.8cm, minimum height=1.0cm},
    life/.style={draw=lightgray, line width=1pt},
    msg/.style={->, draw=navy},
    lbl/.style={font=\footnotesize, above, inner sep=2pt, align=center},
    ck/.style={text=azureblue},
    step/.style={font=\footnotesize\bfseries, text=azureblue, anchor=east},
    sep/.style={draw=lightgray, dashed},
    note/.style={font=\footnotesize, text=darkgray, align=left, anchor=west},
  ]
  \node[actor] (c) at (0,0) {クライアント\\\footnotesize\textcolor{darkgray}{ブラウザが Cookie を保存}};
  \node[actor] (s) at (7,0) {Web サーバー\\\footnotesize\textcolor{darkgray}{アプリケーション}};
  \node[actor] (d) at (11.8,0) {セッションストア\\\footnotesize\textcolor{darkgray}{サーバー側の記録}};
  \foreach \x in {0,7,11.8} { \draw[life] (\x,-0.55) -- (\x,-9.3); }

  % ① 初回
  \node[step] at (-0.3,-1.5) {①};
  \draw[msg] (0,-1.5) -- node[lbl] {商品ページを開く\\\texttt{GET /items}} (7,-1.5);
  \draw[msg] (7,-2.9) -- node[lbl] {\texttt{200 OK}\\\textcolor{azureblue}{\texttt{Set-Cookie: sid=abc123}}} (0,-2.9);
  \draw[msg] (7,-2.1) -- node[lbl] {ID を発行} (11.8,-2.1);
  \draw[sep] (-1.6,-3.3) -- (13.4,-3.3);

  % ② カートに入れる
  \node[step] at (-0.3,-4.6) {②};
  \draw[msg] (0,-4.6) -- node[lbl] {鉛筆とケシゴムを選ぶ\\\texttt{POST /cart}\\\textcolor{azureblue}{\texttt{Cookie: sid=abc123}}} (7,-4.6);
  \draw[msg] (7,-5.15) -- node[lbl] {abc123 のカートに\\鉛筆・ケシゴムを保存} (11.8,-5.15);
  \draw[msg] (7,-5.7) -- node[lbl] {\texttt{200 OK}} (0,-5.7);
  \draw[sep] (-1.6,-6.1) -- (13.4,-6.1);

  % ③ 購入手続き
  \node[step] at (-0.3,-7.4) {③};
  \draw[msg] (0,-7.4) -- node[lbl] {購入手続きへ\\\texttt{GET /checkout}\\\textcolor{azureblue}{\texttt{Cookie: sid=abc123}}} (7,-7.4);
  \draw[msg] (11.8,-7.95) -- node[lbl] {abc123 のカート：\\鉛筆 50 円・ケシゴム 100 円} (7,-7.95);
  \draw[msg] (7,-9.0) -- node[lbl] {\texttt{200 OK}\\「合計 150 円です」} (0,-9.0);
\end{tikzpicture}
