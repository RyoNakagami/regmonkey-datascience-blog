#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    actor/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=center,
                  minimum width=2.4cm, minimum height=0.9cm},
    life/.style={draw=lightgray, line width=1pt},
    msg/.style={->, draw=navy},
    both/.style={<->, draw=darkgray, dashed},
    lbl/.style={font=\footnotesize, above, inner sep=2pt, align=center},
    title/.style={font=\bfseries, text=navy},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt},
  ]
  \foreach \ox/\t/\f/\n in {0/① HTML ファイルのダウンロード/index.html/HTML,
                            10.4/② 画像ファイルのダウンロード/logo.png/画像} {
    \begin{scope}[shift={(\ox,0)}]
      \draw[zone] (-1.5,1.75) rectangle (7.0,-5.6);
      \node[title] at (2.75,1.3) {\t};
      \node[actor] at (0,0.2) {クライアント};
      \node[actor] at (5.5,0.2) {サーバー};
      \draw[life] (0,-0.25) -- (0,-5.3);
      \draw[life] (5.5,-0.25) -- (5.5,-5.3);
      \draw[both] (0,-1.2) -- node[lbl, text=darkgray] {(1) 通信の確立} (5.5,-1.2);
      \draw[msg]  (0,-2.4) -- node[lbl] {(2) 要求\\\texttt{GET /\f}} (5.5,-2.4);
      \draw[msg]  (5.5,-3.6) -- node[lbl] {(3) 応答\\\texttt{200 OK}（\n）} (0,-3.6);
      \draw[both] (0,-4.8) -- node[lbl, text=darkgray] {(4) 通信の切断} (5.5,-4.8);
    \end{scope}
  }
  \node[note] at (8.2,-1.9) {それぞれ\\独立};
  \node[note] at (8.2,-3.4) {関連付け\\られない};
  \node[note, anchor=north] at (8.2,-5.75) {サーバーは，①と②が同じクライアントからの要求だとは分からない};
\end{tikzpicture}
