#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=2.8cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    step/.style={font=\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center, anchor=north},
    wire/.style={->, draw=navy},
    bar/.style={draw=navy, rounded corners=3pt, minimum height=0.75cm, align=center, inner sep=0pt},
  ]
  % 時系列の主経路（決める時点は accent）
  \node[accent] (b1) at (0,0)    {契約\\（SOW締結）};
  \node[accent] (b2) at (3.6,0)  {キックオフ};
  \node[block]  (b3) at (7.2,0)  {探索フェーズ\\{\footnotesize EDA・データ理解}};
  \node[accent] (b4) at (10.8,0) {分析計画書\\の承認};
  \node[block]  (b5) at (14.4,0) {本分析\\フェーズ};
  \node[block]  (b6) at (18.0,0) {報告・検収};
  \foreach \a/\b in {b1/b2,b2/b3,b3/b4,b4/b5,b5/b6} { \draw[wire] (\a) -- (\b); }

  % 段階ラベル
  \node[step, anchor=south] at ([yshift=4pt]b1.north) {段階0};
  \node[step, anchor=south] at ([yshift=4pt]b2.north) {段階1};
  \node[step, anchor=south] at ([yshift=4pt]b4.north) {段階2};

  % 各段階で決めること
  \node[note] at ([yshift=-6pt]b1.south) {ビジネス上の問い\\成果物の種類・検収手続き\\責任境界・変更管理\\フェーズ構成};
  \node[note] at ([yshift=-6pt]b2.south) {ロールの決定権\\暫定RACI};
  \node[note] at ([yshift=-6pt]b4.south) {分析上の問い・仮説\\内容的な検収基準\\本RACI};

  % RACI の適用期間
  \draw[lightgray] (-1.6,-3.15) -- (19.6,-3.15);
  \node[bar, draw=navy, dashed, fill=white, minimum width=7.2cm, anchor=west] (r1) at (3.6,-3.85) {暫定RACI};
  \node[bar, fill=aliceblue, minimum width=8.6cm, anchor=west] (r2) at (10.8,-3.85) {本RACI};
  \node[note] at ([yshift=-4pt]r1.south) {管理系タスク＋「分析計画書の承認」のA};
  \node[note] at ([yshift=-4pt]r2.south) {成果物ごとの作業と意思決定};
  \node[font=\footnotesize, text=darkgray, anchor=east] at (3.3,-3.85) {RACIの適用期間};
\end{tikzpicture}
