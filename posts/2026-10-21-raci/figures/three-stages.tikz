#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    head/.style={draw=navy, fill=paleskyblue, rounded corners=3pt,
                 align=center, minimum height=0.9cm, minimum width=5.6cm, inner sep=5pt},
    card/.style={draw=navy, fill=white, rounded corners=3pt, align=center,
                 minimum width=5.6cm, minimum height=3.3cm, inner sep=6pt, anchor=north},
    step/.style={font=\bfseries, text=azureblue, anchor=south},
    wire/.style={->, draw=navy},
    sub/.style={font=\footnotesize, text=darkgray, anchor=north},
    body/.style={align=center, anchor=north},
  ]
  % 段階の見出し（時系列）
  \node[head] (h0) at (0,0)    {\textbf{契約時}};
  \node[head] (h1) at (7.0,0)  {\textbf{キックオフ時}};
  \node[head] (h2) at (14.0,0) {\textbf{分析計画書の承認時}};
  \draw[wire] (h0) -- (h1);
  \draw[wire] (h1) -- (h2);
  \node[step] at ([yshift=4pt]h0.north) {段階0};
  \node[step] at ([yshift=4pt]h1.north) {段階1};
  \node[step] at ([yshift=4pt]h2.north) {段階2};

  % 各段階で決めること（カード枠＋上揃えの本文）
  \foreach \h in {h0,h1,h2} {
    \draw[navy, rounded corners=3pt] ([xshift=-2.8cm, yshift=-0.35cm]\h.south) rectangle ([xshift=2.8cm, yshift=-3.1cm]\h.south);
  }
  \node[sub] at ([yshift=-0.6cm]h0.south) {データを見なくても決められる枠組み};
  \node[body] at ([yshift=-1.2cm]h0.south) {ビジネス上の問い・成果物の種類\\責任境界・変更管理\\フェーズ構成};
  \node[sub] at ([yshift=-0.6cm]h1.south) {受託側の体制};
  \node[body] at ([yshift=-1.2cm]h1.south) {ロールの決定権\\{\color{azureblue}\textbf{暫定RACI}}\\{\color{darkgray}\footnotesize 探索フェーズ用}};
  \node[sub] at ([yshift=-0.6cm]h2.south) {探索を経て決まる中身};
  \node[body] at ([yshift=-1.2cm]h2.south) {分析上の問い\\内容的な検収基準\\{\color{azureblue}\textbf{本RACI}}\\{\color{darkgray}\footnotesize 本分析フェーズ用}};
\end{tikzpicture}
