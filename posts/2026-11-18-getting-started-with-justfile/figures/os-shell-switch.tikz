#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\newcommand{\tf}[1]{{\footnotesize\texttt{#1}}}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.25cm, minimum width=5.2cm, inner sep=4pt},
    accent/.style={block, fill=paleskyblue},
    rlabel/.style={align=center, text=navy, font=\small\bfseries, minimum width=2.6cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]
  \def\xa{0} \def\xb{4.6} \def\xc{10.8} \def\xd{17.0}

  % ===== Linux / macOS =====
  \node[rlabel] (l0) at (\xa,0)    {\texttt{just shell}\\{\footnotesize 通常レシピ}};
  \node[block]  (l1) at (\xb,0)    {\texttt{[unix]} の \texttt{set shell}\\\tf{pwsh -c}};
  \node[block]  (l2) at (\xc,0)    {1行ずつ取り出す\\\tf{Write-Host "Hello, world!"}};
  \node[accent] (l3) at (\xd,0)    {\tf{pwsh -c 'Write-Host ...'}};

  \node[rlabel] (m0) at (\xa,-1.9) {\texttt{just shebang}\\{\footnotesize shebang レシピ}};
  \node[block]  (m1) at (\xb,-1.9) {変数 \texttt{shebang} の値\\\tf{/usr/bin/env pwsh}};
  \node[block]  (m2) at (\xc,-1.9) {本文を一時ファイルへ\\\tf{\#!/usr/bin/env pwsh}};
  \node[accent] (m3) at (\xd,-1.9) {OS が \texttt{\#!} 行を読んで起動\\\tf{/usr/bin/env pwsh /tmp/...}};

  % ===== Windows =====
  \node[rlabel] (w0) at (\xa,-4.9) {\texttt{just shell}\\{\footnotesize 通常レシピ}};
  \node[block]  (w1) at (\xb,-4.9) {\texttt{[windows]} の \texttt{set shell}\\\tf{powershell.exe -NoLogo -Command}};
  \node[block]  (w2) at (\xc,-4.9) {1行ずつ取り出す\\\tf{Write-Host "Hello, world!"}};
  \node[accent] (w3) at (\xd,-4.9) {\tf{powershell.exe -NoLogo}\\\tf{-Command 'Write-Host ...'}};

  \node[rlabel] (v0) at (\xa,-6.8) {\texttt{just shebang}\\{\footnotesize shebang レシピ}};
  \node[block]  (v1) at (\xb,-6.8) {変数 \texttt{shebang} の値\\\tf{powershell.exe}};
  \node[block]  (v2) at (\xc,-6.8) {本文を一時ファイルへ\\\tf{\#!powershell.exe}};
  \node[accent] (v3) at (\xd,-6.8) {just が \texttt{\#!} 行を分割して起動\\\tf{powershell.exe C:\textbackslash Temp\textbackslash ...}};

  \foreach \r in {l, m, w, v} {
    \draw[wire] (\r1) -- (\r2);
    \draw[wire] (\r2) -- (\r3);
  }

  % ===== 列見出し =====
  \node[step] at (\xb,1.85) {① OS で選ばれる定義};
  \node[step] at (\xc,1.85) {② just が組み立てる};
  \node[step] at (\xd,1.85) {③ 実際に起動されるコマンド};

  % ===== ゾーン =====
  \begin{scope}[on background layer]
    \node[zone, fit=(l0)(l3)(m0)(m3)] (zu) {};
    \node[zone, fit=(w0)(w3)(v0)(v3)] (zw) {};
  \end{scope}
  \node[zlabel, anchor=south west] at ($(zu.north west)+(0.2,0)$) {Linux / macOS：\texttt{[unix]} が有効，\texttt{os()} = \texttt{"linux"} / \texttt{"macos"}};
  \node[zlabel, anchor=south west] at ($(zw.north west)+(0.2,0)$) {Windows：\texttt{[windows]} が有効，\texttt{os()} = \texttt{"windows"}};
\end{tikzpicture}
