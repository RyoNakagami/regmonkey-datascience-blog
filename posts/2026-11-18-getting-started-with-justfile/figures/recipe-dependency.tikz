#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.2cm, minimum width=4.0cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    ext/.style={draw=darkgray, dashed, fill=white, rounded corners=3pt,
                align=center, inner sep=5pt, minimum height=1.2cm, minimum width=3.4cm},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    wire/.style={->, draw=navy},
  ]
  % ===== just test-all =====
  \node[ext]    (c1) at (0,0)   {\texttt{\$ just test-all}};
  \node[block]  (d1) at (5.2,0) {\textbf{build}\\{\footnotesize\texttt{cc *.c -o main}}};
  \node[accent] (r1) at (10.4,0) {\textbf{test-all}\\{\footnotesize\texttt{./test --all}}};
  \draw[wire] (c1) -- (d1);
  \draw[wire] (d1) -- (r1);

  % ===== just test foo =====
  \node[ext]    (c2) at (0,-2.6)   {\texttt{\$ just test foo}};
  \node[block]  (d2) at (5.2,-2.6) {\textbf{build}\\{\footnotesize\texttt{cc *.c -o main}}};
  \node[accent] (r2) at (10.4,-2.6) {\textbf{test}\\{\footnotesize\texttt{./test --test foo}}};
  \draw[wire] (c2) -- (d2);
  \draw[wire] (d2) -- (r2);
  \node[note, below=2mm of r2] {\texttt{TEST = foo} を補間};

  % ===== 列見出し =====
  \node[step, above=2mm of d1] {① 依存レシピを先に実行};
  \node[step, above=2mm of r1] {② 呼んだレシピを実行};
\end{tikzpicture}
