#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.3cm, minimum width=3.5cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    q/.style={draw=navy, fill=white, diamond, align=center, inner sep=0pt,
              minimum width=4.8cm, minimum height=2.9cm, font=\footnotesize},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    sig/.style={font=\footnotesize\bfseries, text=navy, inner sep=2pt},
    wire/.style={->, draw=navy},
  ]
  \node[block, fill=white, minimum width=2.8cm] (start) at (0,0) {新規 / 移行する\\Python プロジェクト};

  \node[q] (q1) at (5.0,0) {C / C++ / Cython / Rust\\の拡張モジュールがある?};
  \node[q] (q2) at (10.5,0) {ビルド時に任意コード実行\\or git tag から version?};
  \node[q] (q3) at (16.0,0) {setup.py・MANIFEST.in・\\CI 前提の資産が重い?};
  \node[q] (q4) at (21.5,0) {モジュール構成が\\\texttt{module-name} 等で\\表現できる?};

  \node[step] at (5.0,2.85) {Q1 コード種別};
  \node[step] at (10.5,2.85) {Q2 ビルドの動的さ};
  \node[step] at (16.0,2.85) {Q3 移行コスト};
  \node[step] at (21.5,2.85) {Q4 レイアウト};

  \node[block] (r1) at (5.0,-3.6) {setuptools\\{\footnotesize （scikit-build-core / maturin も）}};
  \node[block] (r2) at (10.5,-3.6) {setuptools ＋ setuptools-scm\\{\footnotesize または hatchling ＋ hatch-vcs}};
  \node[block] (r3) at (16.0,-3.6) {当面 setuptools 維持\\{\footnotesize 新規パッケージから uv\_build}};
  \node[block] (r5) at (21.5,-3.6) {hatchling\\{\footnotesize 柔軟なレイアウト・build hook}};
  \node[accent, minimum width=3.0cm] (r4) at (26.4,0) {\texttt{uv\_build}\\{\footnotesize 上限付きで pin}};

  \node[note, below=3pt of r1] {wheel はプラットフォーム別\\cibuildwheel 等で配布};
  \node[note, below=3pt of r2] {version を CI で自動採番\\したいケース};
  \node[note, below=3pt of r3] {動くビルドを急いで\\置き換えない};
  \node[note, below=3pt of r5] {複数トップモジュール等\\uv\_build の想定外};
  \node[note, below=3pt of r4] {\texttt{uv init -{}-package / -{}-lib}\\の既定，設定ほぼゼロ};

  \draw[wire] (start) -- (q1);
  \draw[wire] (q1) -- node[midway, above, sig] {No} (q2);
  \draw[wire] (q2) -- node[midway, above, sig] {No} (q3);
  \draw[wire] (q3) -- node[midway, above, sig] {No} (q4);
  \draw[wire] (q4) -- node[midway, above, sig] {Yes} (r4);

  \draw[wire] (q1) -- node[midway, right, sig] {Yes} (r1);
  \draw[wire] (q2) -- node[midway, right, sig] {Yes} (r2);
  \draw[wire] (q3) -- node[midway, right, sig] {Yes} (r3);
  \draw[wire] (q4) -- node[midway, right, sig] {No} (r5);
\end{tikzpicture}
