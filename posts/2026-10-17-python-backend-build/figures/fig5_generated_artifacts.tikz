  \node[hd, minimum width=3.4cm, text width=3.0cm, minimum height=0.9cm, align=center] at (0.00,0.00) {生成物};
  \node[hd, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=0.9cm, align=center] at (5.50,0.00) {setuptools 84.0.0};
  \node[hd, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=0.9cm, align=center] at (13.10,0.00) {uv\_build（0.13.4）};
  \node[key, minimum width=3.4cm, text width=3.0cm, minimum height=2.5cm, align=center] at (0.00,-1.70) {ソースツリー\\（ビルド後に増える）};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.5cm, align=left] at (5.50,-1.70) {\texttt{dist/demo\_pkg-0.1.0.tar.gz}\\\texttt{dist/demo\_pkg-0.1.0-py3-none-any.whl}\\\textcolor{azureblue}{\texttt{src/demo\_pkg.egg-info/}（5 ファイル）}\\\textcolor{azureblue}{\texttt{build/lib/}，\texttt{build/bdist.*/}}\\\textcolor{darkgray}{　↑ ツリーから直接 wheel を作ったとき}};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.5cm, align=left] at (13.10,-1.70) {\texttt{dist/demo\_pkg-0.1.0.tar.gz}\\\texttt{dist/demo\_pkg-0.1.0-py3-none-any.whl}\\\textcolor{azureblue}{それ以外は何も残らない}\\\phantom{x}\\\textcolor{darkgray}{※ \texttt{uv build} 経由なら両方とも \texttt{dist/.gitignore} も}};
  \node[key, minimum width=3.4cm, text width=3.0cm, minimum height=2.93cm, align=center] at (0.00,-4.42) {sdist\\（\texttt{.tar.gz}）};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.93cm, align=left] at (5.50,-4.42) {\texttt{PKG-INFO}，\texttt{pyproject.toml}，\texttt{README.md}，\texttt{LICENSE}\\\texttt{src/demo\_pkg/\_\_init\_\_.py}\\\textcolor{azureblue}{\texttt{setup.cfg}（\texttt{[egg\_info]} タグ）}\\\textcolor{azureblue}{\texttt{src/demo\_pkg.egg-info/*}}\\\textcolor{azureblue}{\texttt{tests/test\_x.py}（自動で同梱）}\\\textcolor{crimsonred}{× \texttt{src/demo\_pkg/data/sample.csv} が落ちる}};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.93cm, align=left] at (13.10,-4.42) {\texttt{PKG-INFO}，\texttt{pyproject.toml}，\texttt{README.md}，\texttt{LICENSE}\\\texttt{src/demo\_pkg/\_\_init\_\_.py}\\\textcolor{azureblue}{\texttt{src/demo\_pkg/data/sample.csv}}\\\textcolor{darkgray}{\texttt{pyproject.toml} は TOML 1.0 で再出力}\\\textcolor{darkgray}{原本は \texttt{pyproject.toml.orig} として同梱}\\\textcolor{darkgray}{tests/・notebooks/・data/・\_\_pycache\_\_ は入らない}};
  \node[key, minimum width=3.4cm, text width=3.0cm, minimum height=2.93cm, align=center] at (0.00,-7.35) {wheel\\（\texttt{.whl}）};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.93cm, align=left] at (5.50,-7.35) {\texttt{demo\_pkg/\_\_init\_\_.py}\\\texttt{*.dist-info/} METADATA，WHEEL，RECORD，\\　\texttt{entry\_points.txt}，\texttt{licenses/LICENSE}\\\textcolor{azureblue}{\texttt{*.dist-info/top\_level.txt}}\\\textcolor{azureblue}{WHEEL: \texttt{Generator: setuptools (84.0.0)}}\\\textcolor{crimsonred}{× \texttt{demo\_pkg/data/sample.csv} なし}};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=2.93cm, align=left] at (13.10,-7.35) {\texttt{demo\_pkg/\_\_init\_\_.py}\\\texttt{*.dist-info/} METADATA，WHEEL，RECORD，\\　\texttt{entry\_points.txt}，\texttt{licenses/LICENSE}\\\textcolor{azureblue}{\texttt{demo\_pkg/data/sample.csv}}\\\textcolor{azureblue}{WHEEL: \texttt{Generator: uv 0.13.4}}\\\textcolor{darkgray}{top\_level.txt は作らない}};
  \node[key, minimum width=3.4cm, text width=3.0cm, minimum height=1.6400000000000001cm, align=center] at (0.00,-9.63) {editable install\\（site-packages）};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=1.6400000000000001cm, align=left] at (5.50,-9.63) {\textcolor{azureblue}{\texttt{\_\_editable\_\_.demo\_pkg-0.1.0.pth}}\\\texttt{demo\_pkg-0.1.0.dist-info/}\\\textcolor{darkgray}{（ツリーに egg-info は残らない）}};
  \node[body, minimum width=7.6cm, text width=7.199999999999999cm, minimum height=1.6400000000000001cm, align=left] at (13.10,-9.63) {\textcolor{azureblue}{\texttt{demo\_pkg.pth}（\texttt{src/} を指す）}\\\texttt{demo\_pkg-0.1.0.dist-info/}\\\phantom{x}};
  \node[font=\scriptsize, text=darkgray, anchor=north west, align=left] at (-1.70,-10.60) {同一の demo-pkg（src layout，\texttt{src/demo\_pkg/data/sample.csv}，tests/，notebooks/，data/ 付き）を両 backend でビルドした実測．\\\textcolor{azureblue}{青} = 片方にだけあるもの，\textcolor{crimsonred}{赤} = 入らないもの（MANIFEST.in も setuptools-scm も無い場合）};
