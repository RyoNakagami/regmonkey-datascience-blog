#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    dg/.style={font=\large, text=navy, inner sep=1pt},
    q/.style={dg, font=\large\bfseries, text=azureblue},
    new/.style={dg, text=azureblue},
    rem/.style={dg, font=\large\bfseries},
    step/.style={font=\scriptsize\bfseries, text=azureblue},
    lab/.style={font=\footnotesize, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, anchor=west},
    op/.style={font=\large, text=navy},
    down/.style={->, draw=lightgray, densely dashed, line width=0.6pt, >={Latex[length=1.4mm]}},
  ]
  \def\cw{0.5}
  % #1 = y, #2 = 先頭の列番号, #3 = 数字列, #4 = スタイル
  \newcommand{\digits}[4]{%
    \foreach \v [count=\j from 0] in {#3} {
      \node[#4] at ({(#2 + \j)*\cw},#1) {\v};
    }
  }
  % 商（各桁の上に手順番号）
  \foreach \c/\v/\s in {3/1/①, 4/0/②, 5/0/③, 6/1/④} {
    \node[q] at (\c*\cw,0.8) {\v};
    \node[step] at (\c*\cw,1.25) {\s};
  }
  % 割り算の記号
  \draw[navy] (-0.5,0.45) -- (3.3,0.45);
  \draw[navy] (-0.5,0.45) .. controls (-0.3,0.2) and (-0.3,-0.15) .. (-0.52,-0.38);
  \digits{0}{-4.6}{1,0,0,0}{dg}
  \digits{0}{0}{1,0,0,1,0,1,0}{dg}

  % ① 1001 - 1000
  \digits{-0.62}{0}{1,0,0,0}{dg}
  \node[op] at (-0.35,-0.62) {$-$};
  \draw[navy] (-0.5,-0.95) -- (1.75,-0.95);
  % ② 10（4列目の 0 を下ろす）
  \digits{-1.3}{3}{1}{dg}
  \node[new] at (4*\cw,-1.3) {0};
  % ③ 101（5列目の 1 を下ろす）
  \digits{-1.92}{3}{1,0}{dg}
  \node[new] at (5*\cw,-1.92) {1};
  % ④ 1010（6列目の 0 を下ろす）- 1000
  \digits{-2.54}{3}{1,0,1}{dg}
  \node[new] at (6*\cw,-2.54) {0};
  \digits{-3.16}{3}{1,0,0,0}{dg}
  \node[op] at (1.15,-3.16) {$-$};
  \draw[navy] (1.0,-3.49) -- (3.25,-3.49);
  % 剰余
  \digits{-3.84}{5}{1,0}{rem}

  % 下ろす矢印
  \draw[down] (4*\cw,-0.22) -- (4*\cw,-1.08);
  \draw[down] (5*\cw,-0.22) -- (5*\cw,-1.7);
  \draw[down] (6*\cw,-0.22) -- (6*\cw,-2.32);

  % ラベル
  \node[lab, anchor=north] at (-1.55,-0.3) {除数（$8$）};
  \node[lab] at (3.8,0.8) {商（$9$）};
  \node[lab] at (3.8,0) {被除数（$74$）};
  \node[note] at (3.8,-0.62) {{\color{azureblue}①} $1001 \geq 1000$ なので商に 1 を立てて引く};
  \node[note] at (3.8,-1.3) {{\color{azureblue}②} 0 を下ろす．$10 < 1000$ なので商に 0};
  \node[note] at (3.8,-1.92) {{\color{azureblue}③} 1 を下ろす．$101 < 1000$ なので商に 0};
  \node[note] at (3.8,-2.54) {{\color{azureblue}④} 0 を下ろす．$1010 \geq 1000$ なので};
  \node[note] at (3.8,-3.16) {\phantom{④} 商に 1 を立てて引く};
  \node[lab] at (3.8,-3.84) {剰余（$2$）};
\end{tikzpicture}
