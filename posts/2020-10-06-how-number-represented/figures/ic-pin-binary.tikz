#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    pin/.style={draw=navy, fill=lightgray, minimum width=0.38cm, minimum height=0.45cm, inner sep=0pt},
    bit/.style={draw=navy, rounded corners=2pt, minimum size=0.75cm, inner sep=0pt,
                font=\large\bfseries},
    one/.style={bit, fill=paleskyblue},
    zero/.style={bit, fill=white},
    volt/.style={font=\footnotesize, text=darkgray, inner sep=1pt},
    rowlabel/.style={font=\footnotesize\bfseries, text=navy, anchor=east},
    card/.style={draw=navy, fill=aliceblue, rounded corners=3pt, align=left,
                 text width=5.3cm, inner sep=8pt},
    wire/.style={->, draw=navy},
  ]
  % IC 本体（DIP パッケージ）
  \fill[navy, rounded corners=3pt] (0,0) rectangle (8.3,2.2);
  \fill[white] (0,0.8) arc[start angle=-90, end angle=90, radius=0.3];
  \node[text=white, font=\bfseries\large] at (4.15,1.1) {IC（集積回路）};

  % ピン・電圧・2進数の桁
  \foreach \v [count=\i from 0] in {1,0,1,1,0,0,1,0} {
    \pgfmathsetmacro{\x}{0.8 + \i*0.96}
    \node[pin, anchor=south] (p\i) at (\x,2.2) {};
    \node[pin, anchor=north] at (\x,0) {};
    \ifnum\v=1
      \node[volt] (v\i) at (\x,3.05) {+5V};
      \node[one] (b\i) at (\x,4.55) {1};
    \else
      \node[volt] (v\i) at (\x,3.05) {0V};
      \node[zero] (b\i) at (\x,4.55) {0};
    \fi
    \draw[wire] (v\i.north) -- (b\i.south);
  }

  % 行ラベル
  \node[rowlabel] at (-0.35,4.55) {2進数の桁};
  \node[rowlabel] at (-0.35,3.05) {ピンの電圧};
  \node[rowlabel] at (-0.35,2.42) {ピン};

  % 8本のピン ＝ 8ビット
  \draw[draw=navy, decorate, decoration={brace, amplitude=6pt}]
    ([yshift=2mm]b0.north west) -- ([yshift=2mm]b7.north east)
    node[midway, above=8pt, font=\small, text=navy]
      {ピン8本 → 2進数8桁（8ビット）＝ 10110010$_{(2)}$};

  % ICの特性
  \node[card, anchor=west] (feat) at (8.9,2.6)
    {{\bfseries\color{navy} ICの特性}\\[4pt]
     ピンの電圧は 0V か +5V の\\
     どちらか一方の状態しかとらない\\[6pt]
     {\bfseries\color{navy} 2つの状態を数字に対応づける}\\[4pt]
     +5V → 1，0V → 0\\[6pt]
     {\color{azureblue}\bfseries ピン1本で2進数1桁を表せる}};
  \node[font=\footnotesize, text=darkgray, anchor=north west, align=left]
    at (feat.south west) {※ 電源電圧はICの種類によって異なる\\（例：+5V，+3.3V）};
\end{tikzpicture}
