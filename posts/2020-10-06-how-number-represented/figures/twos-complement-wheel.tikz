#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    pos/.style={draw=navy, fill=aliceblue, rounded corners=2pt,
                minimum width=1.05cm, minimum height=0.55cm, inner sep=1pt,
                font=\small\ttfamily},
    neg/.style={pos, fill=paleskyblue},
    sval/.style={font=\normalsize\bfseries, text=navy},
    uval/.style={font=\footnotesize, text=darkgray},
    note/.style={font=\footnotesize, text=darkgray, align=left, anchor=west},
    head/.style={font=\small\bfseries, text=navy, anchor=west},
  ]
  % 外周の円
  \draw[lightgray, line width=0.6pt] (0,0) circle (3.6);

  % 16 個のビットパターン（0000 を真上に置き，時計回りに 1 ずつ増える）
  \foreach \b/\u/\s [count=\k from 0] in
      {0000/0/0, 0001/1/1, 0010/2/2, 0011/3/3, 0100/4/4, 0101/5/5,
       0110/6/6, 0111/7/7, 1000/8/{-8}, 1001/9/{-7}, 1010/10/{-6},
       1011/11/{-5}, 1100/12/{-4}, 1101/13/{-3}, 1110/14/{-2}, 1111/15/{-1}} {
    \pgfmathsetmacro{\ang}{90 - 22.5*\k}
    \ifnum\k<8
      \node[pos] at (\ang:3.6) {\b};
    \else
      \node[neg] at (\ang:3.6) {\b};
    \fi
    \node[sval] at (\ang:4.55) {$\s$};
    \node[uval] at (\ang:2.75) {\u};
  }

  % 符号付きのオーバーフロー境界（0111 と 1000 の間）
  \draw[crimsonred, line width=1.2pt] (-78.75:2.3) -- (-78.75:5.0);
  \node[font=\footnotesize, text=crimsonred, anchor=north] at (-78.75:5.05)
    {$7 \to -8$：符号付きのオーバーフロー};
  % 符号なしの桁あふれ境界（1111 と 0000 の間）
  \draw[darkgray, densely dashed, line width=1.0pt] (101.25:2.3) -- (101.25:5.0);
  \node[font=\footnotesize, text=darkgray, anchor=south] at (101.25:5.05)
    {$15 \to 0$：符号なしの桁あふれ};

  % +1 の向き
  \draw[->, azureblue, line width=1.0pt] (60:1.6) arc[start angle=60, end angle=-20, radius=1.6];
  \node[font=\footnotesize\bfseries, text=azureblue] at (20:1.05) {$+1$};

  % 凡例
  \node[head] at (6.0,2.6) {4ビットの読み方};
  \node[pos] (l1) at (6.55,1.75) {0110};
  \node[note] at (7.25,1.75) {最上位ビットが 0：0 以上の数};
  \node[neg] (l2) at (6.55,1.0) {1110};
  \node[note] at (7.25,1.0) {最上位ビットが 1：負の数};
  \node[sval, anchor=west] at (6.05,0.05) {$-2$};
  \node[note] at (7.25,0.05) {外側：2の補数で読んだ値};
  \node[uval, anchor=west] at (6.1,-0.7) {14};
  \node[note] at (7.25,-0.7) {内側：符号なしで読んだ値};
  \node[note] at (6.0,-1.75)
    {同じビットパターンでも，\\
     どちらで読むかで値が変わる．\\
     $+1$ は時計回りに1つ進むこと．};
\end{tikzpicture}
