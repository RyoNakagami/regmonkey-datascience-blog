#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    bit/.style={draw=navy, fill=aliceblue, minimum size=0.5cm, inner sep=0pt, font=\small},
    res/.style={bit, fill=paleskyblue},
    carry/.style={font=\scriptsize, text=azureblue},
    val/.style={font=\normalsize, anchor=west},
    op/.style={font=\normalsize, text=navy},
  ]
  % #1 = y, #2 = ビット列（左が最上位）, #3 = スタイル
  \newcommand{\row}[3]{%
    \foreach \v [count=\j from 0] in {#2} {
      \pgfmathsetmacro{\x}{\j*0.5 + (\j>3 ? 0.15 : 0)}
      \node[#3] at (\x,#1) {\v};
    }
  }
  % 繰り上がり（第2・第3ビットへ）
  \foreach \j in {4,5} {
    \pgfmathsetmacro{\x}{\j*0.5 + 0.15}
    \node[carry] at (\x,0.55) {1};
  }
  \node[carry, anchor=east] at (-0.45,0.55) {繰り上がり};
  \row{0}{0,0,0,0,0,1,1,1}{bit}
  \row{-0.65}{0,0,0,0,0,1,1,0}{bit}
  \node[op] at (-0.65,-0.65) {$+$};
  \draw[navy] (-0.85,-1.05) -- (3.95,-1.05);
  \row{-1.45}{0,0,0,0,1,1,0,1}{res}
  \node[val] at (4.1,0) {$7$};
  \node[val] at (4.1,-0.65) {$6$};
  \node[val] at (4.1,-1.45) {$13$};
\end{tikzpicture}
