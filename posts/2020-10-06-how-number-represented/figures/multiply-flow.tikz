#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.4mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, minimum width=3.4cm, inner sep=5pt},
    term/.style={draw=navy, fill=white, rounded corners=0.3cm,
                 align=center, minimum height=0.8cm, minimum width=1.5cm, inner sep=4pt},
    cond/.style={draw=navy, fill=paleskyblue, diamond, align=center, inner sep=0pt, font=\footnotesize},
    wire/.style={->, draw=navy},
    sig/.style={font=\footnotesize, text=darkgray, inner sep=2pt},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=center},
    dot/.style={circle, fill=navy, inner sep=1.4pt},
  ]
  % 上段：手順1（判定と加算）
  \node[term] (start) at (0,0) {開始};
  \node[cond] (d1) at (3.4,0) {乗数の最下位\\ビット $=1$？};
  \node[block] (add) at (8.0,0) {被乗数を積レジスタに加え，\\結果を積レジスタに収める};
  \node[dot] (merge) at (13.0,0) {};

  % 下段：手順2・3と繰り返し判定（右から左へ戻る）
  \node[block] (s1) at (10.8,-3.6) {被乗数レジスタを\\左に1ビットシフト};
  \node[block] (s2) at (6.6,-3.6) {乗数レジスタを\\右に1ビットシフト};
  \node[cond] (d2) at (3.4,-3.6) {$n$ 回\\繰り返した？};
  \node[term] (end) at (0,-3.6) {終了};

  % 手順ラベルと補足
  \node[step, above=2mm of add] {手順1};
  \node[step, below=2mm of s1] (st2) {手順2};
  \node[step, below=2mm of s2] (st3) {手順3};
  \node[note, below=0.5mm of st2] {筆算で次の段を\\1桁左へずらす};
  \node[note, below=0.5mm of st3] {次の桁が\\最下位ビットに来る};

  % 配線
  \draw[wire] (start) -- (d1);
  \draw[wire] (d1) -- node[sig, above, pos=0.35] {1} (add);
  \draw[draw=navy] (add) -- (merge);
  \draw[wire, rounded corners=4pt] (d1.north) -- ++(0,0.75) -| node[sig, above, pos=0.25] {0（何もしない）} (merge);
  \draw[wire, rounded corners=4pt] (merge) |- (s1.east);
  \draw[wire] (s1) -- (s2);
  \draw[wire] (s2) -- (d2);
  \draw[wire] (d2) -- node[sig, right] {いいえ} (d1);
  \draw[wire] (d2) -- node[sig, above] {はい} (end);
\end{tikzpicture}
