#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    dg/.style={font=\large, text=navy, inner sep=1pt},
    one/.style={dg, text=azureblue, font=\large\bfseries},
    zero/.style={dg, text=darkgray},
    prod/.style={dg, font=\large\bfseries},
    lab/.style={font=\footnotesize, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, anchor=west},
    op/.style={font=\large, text=navy},
  ]
  % 第 k ビットの列の x 座標（左が上位）
  \def\cw{0.5}
  % #1 = y, #2 = 最下位の桁のビット番号, #3 = 数字列（左が上位）, #4 = スタイル
  \newcommand{\digits}[4]{%
    \foreach \v [count=\j from 0] in {#3} {
      \node[#4] at ({(6 - #2 - 3 + \j)*\cw},#1) {\v};
    }
  }
  \digits{0}{0}{1,0,0,0}{dg}
  % 乗数：1 のビットを強調
  \node[one] at (3*\cw,-0.6) {1};
  \node[dg]  at (4*\cw,-0.6) {0};
  \node[dg]  at (5*\cw,-0.6) {0};
  \node[one] at (6*\cw,-0.6) {1};
  \node[op] at (0,-0.6) {$\times$};
  \draw[navy] (-0.3,-0.95) -- (3.35,-0.95);

  % 部分積
  \digits{-1.35}{0}{1,0,0,0}{dg}
  \digits{-1.95}{1}{0,0,0,0}{zero}
  \digits{-2.55}{2}{0,0,0,0}{zero}
  \digits{-3.15}{3}{1,0,0,0}{dg}
  \draw[navy] (-0.3,-3.5) -- (3.35,-3.5);
  \foreach \v [count=\j from 0] in {1,0,0,1,0,0,0} {
    \node[prod] at (\j*\cw,-3.9) {\v};
  }

  % ラベル
  \node[lab] at (3.8,0) {被乗数（$8$）};
  \node[lab] at (3.8,-0.6) {乗数（$9$）};
  \node[note] at (3.8,-1.35) {乗数の第0ビットが {\color{azureblue}1} → 被乗数をそのまま};
  \node[note] at (3.8,-1.95) {乗数の第1ビットが 0 → 0};
  \node[note] at (3.8,-2.55) {乗数の第2ビットが 0 → 0};
  \node[note] at (3.8,-3.15) {乗数の第3ビットが {\color{azureblue}1} → 被乗数を3桁左へずらす};
  \node[lab] at (3.8,-3.9) {積（$72$）};
  \node[font=\footnotesize\bfseries, text=navy, anchor=west] at (-0.3,-0.95-0.0) {};
\end{tikzpicture}
