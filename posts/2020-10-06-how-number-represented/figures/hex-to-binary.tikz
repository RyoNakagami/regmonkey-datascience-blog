#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=2.2mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    hex/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                minimum size=1.1cm, inner sep=0pt, font=\Large\bfseries},
    bit/.style={draw=navy, rounded corners=2pt, minimum size=0.7cm, inner sep=0pt,
                font=\large\bfseries},
    one/.style={bit, fill=paleskyblue},
    zero/.style={bit, fill=white},
    group/.style={draw=paleskyblue, fill=none, rounded corners=6pt, inner sep=5pt},
    weight/.style={font=\footnotesize, text=darkgray},
    note/.style={font=\footnotesize, text=darkgray},
    rowlabel/.style={font=\footnotesize\bfseries, text=navy, anchor=east},
    wire/.style={->, draw=navy},
  ]
  % 16進数の各桁と，対応する4ビット
  \foreach \h/\d/\bits/\e [count=\k from 0] in
      {5/5/{0,1,0,1}/3, E/14/{1,1,1,0}/2, D/13/{1,1,0,1}/1, 4/4/{0,1,0,0}/0} {
    \pgfmathsetmacro{\gx}{\k*3.9}
    \pgfmathsetmacro{\cx}{\gx + 1.2}
    \pgfmathtruncatemacro{\be}{4*\e}
    % 16進数の桁
    \node[hex] (h\k) at (\cx,3.2) {\h};
    \node[weight, above=1mm of h\k] {$\times\, 16^{\e}$};
    \node[note, right=1mm of h\k, anchor=west] {（$=\d$）};
    % 4ビット
    \foreach \v [count=\j from 0] in \bits {
      \pgfmathsetmacro{\bx}{\gx + \j*0.8}
      \ifnum\v=1
        \node[one] (b\k-\j) at (\bx,1.0) {1};
      \else
        \node[zero] (b\k-\j) at (\bx,1.0) {0};
      \fi
    }
    \node[group, fit=(b\k-0)(b\k-3)] (g\k) {};
    \node[weight, below=1mm of g\k] {$\times\, 2^{\be}$};
    \draw[wire] (h\k.south) -- (g\k.north);
  }

  % 行ラベル
  \node[rowlabel] at (-0.75,3.2) {16進数};
  \node[rowlabel] at (-0.75,1.0) {２進数};

  % 結果
  \node[font=\small, text=navy, anchor=north] at (6.99,-0.45)
    {$5\mathrm{ED}4_{(16)} = 0101\ 1110\ 1101\ 0100_{(2)}$
     \quad {\color{darkgray}\footnotesize 16進数の1桁 ＝ 4ビット（$16^{k} = 2^{4k}$）}};
\end{tikzpicture}
