#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    >={Latex[length=1.8mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    bit/.style={draw=navy, fill=aliceblue, minimum size=0.62cm, inner sep=0pt,
                font=\normalsize},
    drop/.style={draw=lightgray, fill=white, minimum size=0.62cm, inner sep=0pt,
                 font=\normalsize, text=darkgray, dashed},
    fillin/.style={bit, fill=paleskyblue},
    mv/.style={->, draw=darkgray, line width=0.5pt},
    title/.style={font=\small\bfseries, text=navy, anchor=west},
    val/.style={font=\small, anchor=west},
    note/.style={font=\footnotesize, text=darkgray, anchor=west},
    rlabel/.style={font=\footnotesize, text=darkgray, anchor=east},
  ]
  \def\w{0.62}

  % (a) 論理左シフト：00011001 (25) → 01100100 (100)
  \node[title] at (-0.4,0.9) {(a) 論理左シフト（2ビット）};
  \foreach \v [count=\j from 0] in {0,0,0,1,1,0,0,1} {
    \ifnum\j<2
      \node[drop] (a\j) at (\j*\w,0) {\v};
    \else
      \node[bit] (a\j) at (\j*\w,0) {\v};
    \fi
  }
  \foreach \v [count=\j from 0] in {0,1,1,0,0,1,0,0} {
    \ifnum\j>5
      \node[fillin] (A\j) at (\j*\w,-1.2) {\v};
    \else
      \node[bit] (A\j) at (\j*\w,-1.2) {\v};
    \fi
  }
  \foreach \j in {2,...,7} {
    \pgfmathtruncatemacro{\t}{\j-2}
    \draw[mv] (a\j.south) -- (A\t.north);
  }
  \node[rlabel] at (-0.5,0) {前};
  \node[rlabel] at (-0.5,-1.2) {後};
  \node[val] at (5.3,0) {25};
  \node[val] at (5.3,-1.2) {$100 = 25 \times 2^2$};
  \node[note] at (5.3,-0.6) {右端に 0 を入れる};

  % (b) 論理右シフト：11101100 (236) → 00111011 (59)
  \begin{scope}[yshift=-3.2cm]
  \node[title] at (-0.4,0.9) {(b) 論理右シフト（2ビット）};
  \foreach \v [count=\j from 0] in {1,1,1,0,1,1,0,0} {
    \ifnum\j>5
      \node[drop] (b\j) at (\j*\w,0) {\v};
    \else
      \node[bit] (b\j) at (\j*\w,0) {\v};
    \fi
  }
  \foreach \v [count=\j from 0] in {0,0,1,1,1,0,1,1} {
    \ifnum\j<2
      \node[fillin] (B\j) at (\j*\w,-1.2) {\v};
    \else
      \node[bit] (B\j) at (\j*\w,-1.2) {\v};
    \fi
  }
  \foreach \j in {0,...,5} {
    \pgfmathtruncatemacro{\t}{\j+2}
    \draw[mv] (b\j.south) -- (B\t.north);
  }
  \node[rlabel] at (-0.5,0) {前};
  \node[rlabel] at (-0.5,-1.2) {後};
  \node[val] at (5.3,0) {236（符号なし）};
  \node[val] at (5.3,-1.2) {$59 = \lfloor 236 / 2^2 \rfloor$};
  \node[note] at (5.3,-0.6) {左端に 0 を入れる};
  \end{scope}

  % (c) 算術右シフト：11101100 (-20) → 11111011 (-5)
  \begin{scope}[yshift=-6.4cm]
  \node[title] at (-0.4,0.9) {(c) 算術右シフト（2ビット）};
  \foreach \v [count=\j from 0] in {1,1,1,0,1,1,0,0} {
    \ifnum\j>5
      \node[drop] (c\j) at (\j*\w,0) {\v};
    \else
      \node[bit] (c\j) at (\j*\w,0) {\v};
    \fi
  }
  \foreach \v [count=\j from 0] in {1,1,1,1,1,0,1,1} {
    \ifnum\j<2
      \node[fillin] (C\j) at (\j*\w,-1.2) {\v};
    \else
      \node[bit] (C\j) at (\j*\w,-1.2) {\v};
    \fi
  }
  \foreach \j in {0,...,5} {
    \pgfmathtruncatemacro{\t}{\j+2}
    \draw[mv] (c\j.south) -- (C\t.north);
  }
  \node[rlabel] at (-0.5,0) {前};
  \node[rlabel] at (-0.5,-1.2) {後};
  \node[val] at (5.3,0) {$-20$（2の補数）};
  \node[val] at (5.3,-1.2) {$-5 = -20 / 2^2$};
  \node[note] at (5.3,-0.6) {左端に符号ビット（1）を複製する};
  \end{scope}

  % 凡例
  \node[drop, minimum size=0.45cm] (lg1) at (0.2,-8.7) {};
  \node[note] at (0.5,-8.7) {あふれて捨てられるビット};
  \node[fillin, minimum size=0.45cm] (lg2) at (4.6,-8.7) {};
  \node[note] at (4.9,-8.7) {新しく入るビット};
\end{tikzpicture}
