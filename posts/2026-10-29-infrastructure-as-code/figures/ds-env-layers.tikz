#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    layer/.style={block, minimum width=5.6cm},
    accent/.style={layer, fill=paleskyblue},
    head/.style={font=\footnotesize\bfseries, text=azureblue, anchor=west},
    cell/.style={anchor=west, align=left},
    sep/.style={draw=lightgray, line width=0.5pt},
  ]
  \def\xa{3.4}  % 宣言ファイル列
  \def\xb{9.6}  % 適用列

  \node[head, anchor=center] at (0,0.9) {環境のレイヤー};
  \node[head] at (\xa,0.9) {宣言ファイル（ソース）};
  \node[head] at (\xb,0.9) {適用・固定};

  \node[layer]  (l1) at (0,0)    {分析コード・パラメータ};
  \node[accent] (l2) at (0,-1.4) {\textbf{Python 環境}\\{\footnotesize インタプリタ・パッケージ}};
  \node[layer]  (l3) at (0,-2.8) {OS・システムライブラリ\\{\footnotesize CUDA・GDAL・フォントなど}};
  \node[layer]  (l4) at (0,-4.2) {クラウド資源\\{\footnotesize VM・GPU・ストレージ・DWH}};

  \node[cell] at (\xa,0)    {\texttt{src/}・\texttt{configs/*.yaml}・\texttt{Makefile}};
  \node[cell] at (\xa,-1.4) {\texttt{pyproject.toml}・\texttt{.python-version}};
  \node[cell] at (\xa,-2.8) {\texttt{Dockerfile}・\texttt{devcontainer.json}};
  \node[cell] at (\xa,-4.2) {\texttt{*.tf}（Terraform）・\texttt{*.bicep}};

  \node[cell] at (\xb,0)    {Git の commit};
  \node[cell] at (\xb,-1.4) {\texttt{uv sync} ／ \texttt{uv.lock}};
  \node[cell] at (\xb,-2.8) {\texttt{docker build} ／ イメージ digest};
  \node[cell] at (\xb,-4.2) {\texttt{terraform apply} ／ state};

  \foreach \y in {-0.7,-2.1,-3.5} { \draw[sep] (3.2,\y) -- (15.4,\y); }
\end{tikzpicture}
