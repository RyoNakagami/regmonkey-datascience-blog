#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    accent/.style={block, fill=paleskyblue},
    start/.style={block, fill=white, minimum width=4.2cm},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    step/.style={font=\footnotesize\bfseries, text=azureblue},
    note/.style={font=\footnotesize, text=darkgray, align=left},
    wire/.style={->, draw=navy},
  ]
  % 開始状態
  \node[start] (s1) at (0,1.6)  {まっさらな環境};
  \node[start] (s2) at (0,0)    {古い設定が残った環境};
  \node[start] (s3) at (0,-1.6) {すでに定義どおりの環境};

  % 同じ操作
  \node[accent, minimum width=4.4cm, minimum height=1.6cm] (op) at (6.2,0)
    {\textbf{同じ操作を実行}\\[2pt]{\footnotesize 例：\texttt{terraform apply}}\\{\footnotesize \texttt{uv sync}}};

  % 目標状態
  \node[block, minimum width=3.6cm, minimum height=1.6cm] (goal) at (13.2,0)
    {\textbf{目標状態}\\（定義ファイルどおり）};

  \foreach \s in {s1,s2,s3} { \draw[wire] (\s.east) -- (op.west); }
  \draw[wire] (op) -- node[above, font=\footnotesize, text=darkgray] {何度実行しても} node[below, font=\footnotesize, text=darkgray] {同じ結果} (goal);

  % 実現方法
  \node[step, anchor=north west] (m1) at ($(op.south west)+(-0.6,-0.5)$) {方法① 収束};
  \node[note, anchor=north west] at ($(m1.south west)+(0,-0.05)$) {既存環境と定義の差分だけを直す\\（足りないものを足し，余分を消す）};
  \node[step, anchor=north west] (m2) at ($(goal.south west)+(-0.2,-0.5)$) {方法② 再作成};
  \node[note, anchor=north west] (m2n) at ($(m2.south west)+(0,-0.05)$) {既存環境を破棄して\\まっさらから作り直す};

  \begin{scope}[on background layer]
    \node[zone, fit=(s1)(s3)] (zs) {};
  \end{scope}
  \node[zlabel] at (zs.north) {開始状態はばらばら};
\end{tikzpicture}
