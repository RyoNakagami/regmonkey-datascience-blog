#| mainfont: Noto Sans CJK JP
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
    auto, >={Latex[length=2.6mm]}, font=\small, line width=0.7pt,
    every node/.style={text=fontblack},
    block/.style={draw=navy, fill=aliceblue, rounded corners=3pt,
                  align=center, minimum height=1.1cm, inner sep=5pt},
    zone/.style={draw=paleskyblue, fill=none, rounded corners=8pt, inner sep=10pt},
    zlabel/.style={anchor=south, font=\bfseries, text=navy},
    sig/.style={font=\small, text=fontblack, inner sep=3pt},
    fd/.style={font=\small\bfseries, text=azureblue},
    wire/.style={->, draw=navy},
  ]
  % 端末側
  \node[block, minimum width=2.8cm] (kbd) at (7.0, 1.3) {Keyboard};
  \node[block, minimum width=2.8cm, minimum height=1.9cm] (disp) at (7.0,-1.3) {Display};

  % プロセス（3本の線を水平に受けられる高さにする）
  \node[block, minimum width=2.4cm, minimum height=4.5cm] (proc) at (0,0) {Process};

  % stdin: Keyboard → Process
  \draw[wire] (kbd.west) -- (kbd.west -| proc.east)
    node[midway, above, sig] {\textcolor{azureblue}{\textbf{\#0}}\ stdin};
  % stdout / stderr: Process → Display
  \draw[wire] ([yshift=4mm]disp.west -| proc.east) -- ([yshift=4mm]disp.west)
    node[midway, above, sig] {\textcolor{azureblue}{\textbf{\#1}}\ stdout};
  \draw[wire] ([yshift=-4mm]disp.west -| proc.east) -- ([yshift=-4mm]disp.west)
    node[midway, above, sig] {\textcolor{azureblue}{\textbf{\#2}}\ stderr};

  \begin{scope}[on background layer]
    \node[zone, fit=(kbd)(disp)] (term) {};
  \end{scope}
  \node[zlabel] at (term.north) {Text terminal};
\end{tikzpicture}
